#!/usr/bin/env bash
# auto-github-push — triggered by PostToolUse hook after Write/Edit
# Detects new Python scripts, skill files, or notable files and pushes to GitHub via API
# Zero git commands — uses GitHub Contents API (avoids symlink/merge issues)

set -euo pipefail

OWNER="hmzainjamil"
GH="/opt/homebrew/bin/gh"
TOKEN="${GITHUB_TOKEN:-GITHUB_PAT_REDACTED}"
LOG="$HOME/.claude/logs/auto-github-push.log"

mkdir -p "$(dirname "$LOG")"

# Read the file path from PostToolUse tool_input (passed via stdin as JSON)
INPUT=$(cat /dev/stdin 2>/dev/null || echo "{}")
TOOL_NAME=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_name',''))" 2>/dev/null || echo "")
FILE_PATH=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); ti=d.get('tool_input',{}); print(ti.get('file_path', ti.get('path','')))" 2>/dev/null || echo "")

[ -z "$FILE_PATH" ] && exit 0
[ ! -f "$FILE_PATH" ] && exit 0

# Only handle files in key locations
should_push() {
    local f="$1"
    [[ "$f" == "$HOME/.claude/bin/"* ]] && return 0
    [[ "$f" == "$HOME/.claude/skills/"* ]] && return 0
    [[ "$f" == "$HOME/.claude/skills-archive/"* ]] && return 0
    [[ "$f" == "$HOME/.claude/agents/"* ]] && return 0
    [[ "$f" == "$HOME/Library/LaunchAgents/ai.hmz."* ]] && return 0
    return 1
}

should_push "$FILE_PATH" || exit 0

log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }
log "Detected: $FILE_PATH"

# Determine target repo + path
determine_target() {
    local f="$1"

    if [[ "$f" == "$HOME/.claude/bin/"* ]]; then
        REPO="claude-ai-system"
        REL="automations/bin/$(basename "$f")"
    elif [[ "$f" == "$HOME/.claude/skills/"*"/SKILL.md" ]]; then
        REPO="claude-ai-skills"
        SKILL_NAME=$(echo "$f" | sed "s|$HOME/.claude/skills/||" | cut -d'/' -f1)
        REL="skills-active/$SKILL_NAME/SKILL.md"
    elif [[ "$f" == "$HOME/.claude/skills-archive/"*"/SKILL.md" ]]; then
        REPO="hmz-skills-archive"
        SKILL_NAME=$(echo "$f" | sed "s|$HOME/.claude/skills-archive/||" | cut -d'/' -f1)
        # Deduplicate: strip hash suffix
        BASE=$(echo "$SKILL_NAME" | sed 's/-[A-F0-9]\{8\}$//')
        REL="skills/$BASE/SKILL.md"
    elif [[ "$f" == "$HOME/.claude/agents/"* ]]; then
        REPO="claude-ai-agents"
        REL="agents/$(echo "$f" | sed "s|$HOME/.claude/agents/||")"
    elif [[ "$f" == "$HOME/Library/LaunchAgents/ai.hmz."* ]]; then
        REPO="claude-ai-automations"
        REL="launchagents/$(basename "$f")"
    else
        log "No target for: $f"
        exit 0
    fi
}

determine_target "$FILE_PATH"

# Read file content
CONTENT=$(cat "$FILE_PATH" 2>/dev/null)
[ -z "$CONTENT" ] && exit 0

# Scrub secrets before pushing
CONTENT=$(echo "$CONTENT" | sed \
    -e 's/ghp_[A-Za-z0-9]\{10,\}/[REDACTED]/g' \
    -e 's/sk-[A-Za-z0-9]\{20,\}/[REDACTED]/g' \
    -e 's/AIRTABLE_API_KEY=[A-Za-z0-9._]*/AIRTABLE_API_KEY=[REDACTED]/g' \
)

# Get current SHA (if file exists on GitHub)
SHA=$("$GH" api "repos/$OWNER/$REPO/contents/$REL" --jq '.sha' 2>/dev/null || echo "")

# Build payload
ENCODED=$(echo "$CONTENT" | base64)
PAYLOAD="{\"message\":\"auto: sync $(basename "$FILE_PATH") from local\",\"content\":\"$ENCODED\",\"committer\":{\"name\":\"HMZ\",\"email\":\"hmzainjamil@gmail.com\"}}"
if [ -n "$SHA" ]; then
    PAYLOAD="{\"message\":\"auto: update $(basename "$FILE_PATH")\",\"content\":\"$ENCODED\",\"sha\":\"$SHA\",\"committer\":{\"name\":\"HMZ\",\"email\":\"hmzainjamil@gmail.com\"}}"
fi

# Push to GitHub
RESULT=$("$GH" api "repos/$OWNER/$REPO/contents/$REL" -X PUT --input - <<< "$PAYLOAD" 2>&1)
if echo "$RESULT" | grep -q '"sha"'; then
    log "✓ Pushed: $REPO/$REL"
else
    log "✗ Failed: $REPO/$REL — ${RESULT:0:100}"
fi
