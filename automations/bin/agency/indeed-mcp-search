def pk_compatibility_check(title: str, description: str, location: str = "", country: str = "US") -> dict:
    """
    Returns:
      status: "YES" / "NO" / "MAYBE"
      reason: why
      safe_to_apply: bool
    """
    text = (title + " " + description + " " + location).lower()

    # Check hard blockers first
    for phrase in PK_REJECT_PHRASES:
        if phrase in text:
            return {
                "status": "NO",
                "reason": f'Requires local work auth: "{phrase}"',
                "safe_to_apply": False,
            }

    # Check green signals
    for phrase in PK_PASS_PHRASES:
        if phrase in text:
            return {
                "status": "YES",
                "reason": f'PK-friendly signal: "{phrase}"',
                "safe_to_apply": True,
            }

    # Pakistan Indeed listings = always compatible
    if country == "PK":
        return {"status": "YES", "reason": "Pakistan Indeed listing", "safe_to_apply": True}

    # Contract/freelance with no blocker = usually safe
    if any(w in text for w in ["contract", "freelance", "per project", "hourly"]):
        return {"status": "MAYBE", "reason": "Contract role — likely open to international contractors", "safe_to_apply": True}

    # Default for remote roles with no explicit restriction — assume safe (contractor context)
    if "remote" in text:
        return {"status": "YES", "reason": "Remote role — no auth restriction found", "safe_to_apply": True}

    # Non-remote US/UK full-time = likely requires local auth
    if country in ("US", "GB", "CA", "AU") and "remote" not in text:
        return {"status": "NO", "reason": f"On-site {country} role — local auth likely required", "safe_to_apply": False}

    return {"status": "YES", "reason": "No blocking signals found", "safe_to_apply": True}

def run_mcp_search(search: str, country_code: str, job_type: str = None) -> list:
    """
    Calls `claude --print` with a structured prompt to use the Indeed MCP.
    Returns parsed job list.
    """
    jt_part = f', job_type="{job_type}"' if job_type else ""
    prompt = f"""Use the Indeed MCP search_jobs tool with these exact parameters:
search="{search}"
location="remote"
country_code="{country_code}"{jt_part}

Return ONLY a JSON array of jobs found. Each job object must have:
- title, company, location, salary, job_type, posted_date, apply_url, job_id
- remote: true
- country: "{country_code}"

If no jobs found, return empty array [].
Return ONLY the JSON array, no other text."""

    try:
        result = subprocess.run(
            ["claude", "--print", "--no-color", prompt],
            capture_output=True, text=True, timeout=60,
            env={**os.environ, "HOME": str(HOME)}
        )
        output = result.stdout.strip()
        if not output:
            log(f"  ⚠️  Empty output from claude --print ({country_code}) — MCP likely unavailable headlessly")
            return []
        m = re.search(r'\[.*\]', output, re.DOTALL)
        if m:
            return json.loads(m.group())
        log(f"  ⚠️  No JSON array in output: {output[:120]}")
    except subprocess.TimeoutExpired:
        log(f"  Timeout: {country_code} '{search[:40]}'")
    except json.JSONDecodeError as e:
        log(f"  JSON parse error: {e}")
    except Exception as e:
        log(f"  Error: {e}")
    return []

def normalize_job(j: dict, country: str) -> dict:
    """Normalize MCP job dict to BDM standard format + PK compatibility check."""
    title    = j.get("title","") or j.get("job_title","")
    desc     = j.get("description","") or ""
    location = j.get("location","Remote")
    salary   = j.get("salary","") or j.get("compensation","")

    pk = pk_compatibility_check(title, desc, location, country)

    return {
        "platform":      "indeed_mcp",
        "title":         title,
        "description":   desc[:800],
        "url":           j.get("apply_url","") or j.get("url",""),
        "budget":        salary,
        "client_info": {
            "company":  j.get("company",""),
            "location": location,
            "posted":   j.get("posted_date","") or j.get("date",""),
            "country":  country,
        },
        "posted_at":     j.get("posted_date","") or j.get("date",""),
        "remote":        True,
        "source":        "indeed_mcp_live",
        "pk_compatible": pk["status"],       # YES / NO / MAYBE
        "pk_reason":     pk["reason"],       # why flagged
        "safe_to_apply": pk["safe_to_apply"],
    }

def main():
    log("=== Indeed MCP Bridge — BDM job discovery ===")

    # Check cache — reuse today's results if fresh (save API calls)
    if OUTPUT.exists():
        cached = json.loads(OUTPUT.read_text())
        if cached.get("date") == TODAY and len(cached.get("jobs",[])) > 0:
            # Re-score in case benchmarks changed
            rescored = [hmz_score(j) for j in cached["jobs"]]
            rescored.sort(key=lambda x: -x.get("hmz_score",0))
            cached["jobs"] = rescored
            OUTPUT.write_text(json.dumps(cached, indent=2))
            log(f"Cache hit: {len(rescored)} jobs from today (rescored) — skipping re-fetch")
            print(json.dumps(rescored))
            return

    all_jobs = []
    seen_urls = set()

    for search, country, job_type in SEARCHES:
        log(f"  Searching {country}: {search[:50]}...")
        raw = run_mcp_search(search, country, job_type)
        rejected_pk = 0
        for j in raw:
            url = j.get("apply_url","") or j.get("url","")
            title = j.get("title","")
            if not url or url in seen_urls: continue
            if not is_skill_match(title): continue
            seen_urls.add(url)

            normalized = normalize_job(j, country)

            # Hard block: PK incompatible — skip entirely
            if normalized["pk_compatible"] == "NO":
                rejected_pk += 1
                log(f"    ❌ PK-BLOCKED: {title[:50]} — {normalized['pk_reason']}")
                continue

            normalized = hmz_score(normalized)
            all_jobs.append(normalized)
        log(f"    → {len(raw)} found | PK-blocked: {rejected_pk} | accepted: {len(all_jobs)} total")

    pk_yes   = len([j for j in all_jobs if j["pk_compatible"] == "YES"])
    pk_maybe = len([j for j in all_jobs if j["pk_compatible"] == "MAYBE"])
    log(f"\nTotal: {len(all_jobs)} PK-compatible jobs ({pk_yes} confirmed ✅ | {pk_maybe} unverified ⚠️)")

    # Save cache — ONLY if we got results (never clobber good cache with 0)
    if all_jobs:
        OUTPUT.write_text(json.dumps({
            "date":  TODAY,
            "count": len(all_jobs),
            "jobs":  all_jobs
        }, indent=2))
        log(f"Saved → {OUTPUT}")
    else:
        log("⚠️  0 jobs from claude --print (MCP not available headlessly). Cache preserved.")
        log("FIX: Run sweep interactively in Claude Code session to populate cache.")

    # Output for BDM pipeline to consume
    print(json.dumps(all_jobs))

if __name__ == "__main__":
    main()
