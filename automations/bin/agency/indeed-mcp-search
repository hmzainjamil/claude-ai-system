# ── HMZ Scoring Engine ────────────────────────────────────────────
_SCOPE_YES = ["google ads","ppc","paid search","paid media","meta ads","facebook ads",
              "media buyer","performance marketing","paid advertising","sem","roas","paid social"]
_RATE_FLOOR_SAL = 55000
_RATE_FLOOR_HR  = 30

def hmz_score(j: dict) -> dict:
    title   = j.get("title","").lower()
    budget  = j.get("budget","").lower()
    remote  = j.get("remote", False)
    pk      = j.get("pk_compatible","MAYBE")
    posted  = j.get("client_info",{}).get("posted","") if isinstance(j.get("client_info"),dict) else ""
    s = 0; flags = []

    # Scope (40pts)
    hits = [kw for kw in _SCOPE_YES if kw in title]
    if hits: s += 40
    else: s += 15; flags.append("scope weak")

    # Remote (20pts)
    if remote: s += 20
    else: flags.append("NOT remote")

    # Pay (20pts)
    pay_ok = False
    for part in budget.replace("–","-").replace("$","").replace(",","").split("-"):
        for tok in part.strip().split():
            try:
                v = float(tok.replace("/yr","").replace("/hr",""))
                if v >= _RATE_FLOOR_SAL or (_RATE_FLOOR_HR <= v < 1000): pay_ok = True
            except: pass
    if pay_ok: s += 20
    elif "n/a" in budget: s += 8; flags.append("no pay listed")
    else: s += 5; flags.append("pay unclear")

    # PK (10pts)
    if pk == "YES": s += 10
    elif pk == "MAYBE": s += 8
    else: s -= 20; flags.append("PK BLOCKED")

    # Freshness (10pts)
    import datetime as _dt
    today_str = _dt.date.today().strftime("%Y-%m-%d")
    week_ago  = (_dt.date.today() - _dt.timedelta(days=7)).strftime("%Y-%m-%d")
    if posted >= today_str[:8].rstrip("-")+"1": s += 10  # this month
    elif posted >= week_ago: s += 7
    else: s += 3; flags.append(f"stale:{posted}")

    rec = "APPLY" if s >= 80 else ("VERIFY" if s >= 60 else "SKIP")
    j["hmz_score"] = s
    j["hmz_rec"]   = rec
    j["hmz_flags"] = flags
    return j

HOME       = Path.home()
