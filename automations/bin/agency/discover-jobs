    line = f"[{ts}] {msg}"
    print(line)
    with open(LOG_FILE, "a") as f:
        f.write(line + "\n")

def call_llm(prompt, max_tokens=200, temperature=0.1):
    # Plan A: G0DM0D3 Ultraplinian (55 models race — best Tier 0 quality)
    if G0DM0D3_KEY:
        try:
            r = requests.post(f"{G0DM0D3_BASE}/v1/ultraplinian/completions",
                json={"messages":[{"role":"user","content":prompt}],"max_tokens":max_tokens},
                headers={"Authorization":f"Bearer {G0DM0D3_KEY}"},
                timeout=35, stream=True)
            buffer = ""
            for line in r.iter_lines():
                if not line: continue
                line = line.decode() if isinstance(line, bytes) else line
                if line.startswith("data: "):
                    try:
                        chunk = json.loads(line[6:])
                        # Ultraplinian final result
                        ans = chunk.get("best_answer","")
                        if not ans:
                            choices = chunk.get("choices",[])
                            if choices:
                                delta = choices[0].get("delta",{})
                                ans = delta.get("content","")
                        if ans:
                            buffer += ans
                    except Exception: pass
            if buffer and len(buffer) > 20:
                return buffer.strip()
        except Exception as e:
            pass

    if OPENROUTER_KEY:
        try:
            r = requests.post(OR_URL,
                json={"model": OR_MODEL, "messages": [{"role":"user","content":prompt}],
                      "max_tokens": max_tokens, "temperature": temperature},
                headers={"Authorization": f"Bearer {OPENROUTER_KEY}",
                         "HTTP-Referer": "https://digiminds.org", "X-Title": "DigiMinds"},
                timeout=30)
            if r.status_code == 200:
                return r.json()["choices"][0]["message"]["content"].strip()
        except Exception as e:
            log(f"OpenRouter error: {e}")
    if GROQ_KEY:
        try:
            r = requests.post(GROQ_URL,
                json={"model": GROQ_MODEL, "messages": [{"role":"user","content":prompt}],
                      "max_tokens": max_tokens, "temperature": temperature},
                headers={"Authorization": f"Bearer {GROQ_KEY}"},
                timeout=20)
            if r.status_code == 200:
                return r.json()["choices"][0]["message"]["content"].strip()
        except Exception: pass
    if G0DM0D3_KEY:
        try:
            r = requests.post(f"{G0DM0D3_BASE}/v1/chat/completions",
                json={"model":"llama3:latest","messages":[{"role":"user","content":prompt}],
                      "max_tokens":max_tokens,"temperature":temperature},
                headers={"Authorization": f"Bearer {G0DM0D3_KEY}"},
                timeout=25)
            if r.status_code == 200:
                return r.json()["choices"][0]["message"]["content"].strip()
        except Exception: pass
    return ""

def rag_search(query, max_results=5):
    if not APIFY_TOKEN:
        return []
    import urllib.parse
    url = f"{RAG_BASE}?token={APIFY_TOKEN}&query={urllib.parse.quote(query)}&maxResults={max_results}&scrapingTool=raw-http"
    try:
        r = requests.get(url, timeout=45)
        if r.status_code == 200:
            items = r.json() if isinstance(r.json(), list) else []
            out = []
            for item in items:
                sr = item.get("searchResult", {})
                out.append({
                    "title": sr.get("title", ""),
                    "description": sr.get("description", ""),
                    "url": sr.get("url", ""),
                    "markdown": (item.get("markdown","") or item.get("text",""))[:1200]
                })
            return out
    except Exception as e:
        log(f"RAG error [{query[:40]}]: {e}")
    return []

def extract_budget(text):
    m = re.search(r'\$[\d,]+(?:[–\-]\$?[\d,]+)?(?:/hr|/hour|/month|k)?', text, re.IGNORECASE)
    return m.group(0) if m else ""

SEEN = set()
def dedup(url):
    if not url or url in SEEN: return False
    SEEN.add(url); return True

PK_REJECT_PHRASES = [
    "must be authorized to work in the us","must be authorized to work in the united states",
    "must be authorized to work in the uk","must be authorized to work in the united kingdom",
    "must be authorized to work in canada","must be authorized to work in australia",
    "authorized to work in us","us work authorization required","uk work authorization required",
    "must reside in the us","must reside in the united states","must reside in the uk",
    "must reside in canada","must reside in australia","must live in the us",
    "must be based in the us","must be based in the uk","must be based in canada",
    "must be based in australia","us citizens only","us citizen only","citizens only",
    "w-2 employee","w2 employee","security clearance required","secret clearance",
    "top secret clearance","local candidates only","must be physically located",
    "no international applicants","currently located in the us","currently located in the uk",
    "only applicants in the us","only applicants in the uk","must have a valid us",
]

def pk_compatible(job: dict) -> tuple:
    """
    Returns (is_compatible: bool, reason: str)
    Checks ALL job fields for Pakistani candidate compatibility.
    """
    # Already flagged by indeed-mcp-search
    if job.get("pk_compatible") == "NO":
        return False, job.get("pk_reason","requires local work auth")
    if job.get("pk_compatible") == "YES":
        return True, "verified PK-compatible"

    text = (
        job.get("title","") + " " +
        job.get("description","") + " " +
        job.get("markdown","") + " " +
        str(job.get("client_info",""))
    ).lower()

    for phrase in PK_REJECT_PHRASES:
        if phrase in text:
            return False, f'requires local work auth: "{phrase}"'
    return True, "no explicit work auth requirement"

def score_job(job):
    # PK compatibility gate — hard block before scoring
    pk_ok, pk_reason = pk_compatible(job)
    if not pk_ok:
        log(f"  ❌ PK-BLOCKED (skip): {job.get('title','')[:50]} — {pk_reason}")
        return 0, f"PK-incompatible: {pk_reason}", [], False

    title = job.get("title","")
    desc  = (job.get("description","") + " " + job.get("markdown",""))[:600]
    budget = job.get("budget","")
    prompt = f"""Score this job 0-100 for Hafiz, Pakistani Meta Ads + Google Ads expert (remote only).
Return ONLY JSON: {{"score": N, "reason": "1 sentence", "pain_points": ["p1","p2"], "is_high_ticket": true/false}}

High ticket = budget >$500 or agency/enterprise client.
Score 80+ if: Meta Ads, Facebook Ads, Google Ads, performance marketing, ROAS, PPC, paid ads.
Score 50-79 if: digital marketing with paid ads component.
Score <50 if: unrelated to paid advertising.
Score 0 if: requires local residency or work authorization (not compatible with remote Pakistan-based).

Title: {title}
Desc: {desc[:400]}
Budget: {budget}"""
    try:
        text = call_llm(prompt, 150)
        m = re.search(r'\{.*\}', text, re.DOTALL)
        if m:
            result = json.loads(m.group())
            return (int(result.get("score",50)), result.get("reason",""),
                    result.get("pain_points",[]), result.get("is_high_ticket",False))
    except Exception: pass
    # Keyword fallback
    tl = (title+" "+desc).lower()
    s = 30
    for kw in ["meta ads","facebook ads","google ads","ppc","paid ads","roas","performance marketing","media buyer"]:
        if kw in tl: s += 10
    s = min(s, 90)
    return s, "keyword", [kw for kw in ["meta ads","google ads","facebook ads"] if kw in tl][:2], s>=70

def make_jobs(items, platform, url_filter=None):
    out = []
    for item in items:
        url = item.get("url","")
        if not url or not dedup(url): continue
        if url_filter and url_filter not in url: continue
        desc = item.get("description","") + " " + item.get("markdown","")
        out.append({"platform":platform,"title":item["title"],"description":desc[:800],
                    "url":url,"budget":extract_budget(desc),"client_info":{},"posted_at":"",
                    "markdown":item.get("markdown","")})
    return out

