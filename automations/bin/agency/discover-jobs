def scrape_all():
    # PLATFORMS: LinkedIn + Indeed ONLY — Upwork, Freelancer, PeoplePerHour removed permanently
    scrapers = [scrape_linkedin, scrape_indeed, scrape_arc, scrape_reddit, scrape_twitter]
    all_jobs = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=5) as ex:
        futures = {ex.submit(fn): fn.__name__ for fn in scrapers}
        for fut in concurrent.futures.as_completed(futures):
            try:
                jobs = fut.result()
                all_jobs.extend(jobs)
                log(f"{futures[fut]}: done ({len(jobs)} found)")
            except Exception as e:
                log(f"Scraper error {futures[fut]}: {e}")
    return all_jobs

def score_all(jobs):
    log(f"Scoring {len(jobs)} jobs via OpenRouter DeepSeek + fallbacks...")
    scored = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as ex:
        futures = {ex.submit(score_job, job): job for job in jobs}
        for fut in concurrent.futures.as_completed(futures):
            job = futures[fut]
            try:
                score, reason, pain, ht = fut.result()
                job.update({"relevance_score":score,"score_reason":reason,
                            "pain_points":pain,"is_high_ticket":ht})
            except Exception:
                job.update({"relevance_score":40,"score_reason":"error",
                            "pain_points":[],"is_high_ticket":False})
            # remove heavy markdown from output
            job.pop("markdown", None)
            scored.append(job)
    scored.sort(key=lambda x: (x.get("is_high_ticket",False), x.get("relevance_score",0)), reverse=True)
    return [j for j in scored if j.get("relevance_score",0) >= 40]

def main():
    log("=== DISCOVERY v2.0 — 10 PLATFORMS ===")
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    all_jobs = scrape_all()
    log(f"Total raw: {len(all_jobs)}")
    qualified = score_all(all_jobs)
    breakdown = {}
    for p in ["linkedin","indeed","arc","reddit","twitter"]:
        n = len([j for j in qualified if j.get("platform") == p])
        if n: breakdown[p] = n
    output = {"date": TODAY, "total_discovered": len(all_jobs), "total_qualified": len(qualified),
              "high_ticket_count": len([j for j in qualified if j.get("is_high_ticket")]),
              "platform_breakdown": breakdown, "jobs": qualified}
    with open(OUTPUT, "w") as f:
        json.dump(output, f, indent=2, default=str)
    log(f"Saved {len(qualified)} qualified ({output['high_ticket_count']} high-ticket) → {OUTPUT}")
    return str(OUTPUT)

if __name__ == "__main__":
    print(main())
