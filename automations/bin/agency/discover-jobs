def scrape_indeed():
    """
    Indeed.com — PRIMARY: Claude Code Indeed MCP connector (real-time API).
    FALLBACK 1: Apify bebity~indeed-scraper actor.
    FALLBACK 2: RAG Google search.

    MCP connector hits Indeed's live API — freshest data available.
    Targets: remote Google Ads / Meta Ads / PPC roles globally.
    Countries: US, CA, GB, AU, AE, PK (HMZ geo-whitelist).
    """
    log("Indeed (MCP connector — live API)...")

    # ── PRIMARY: Indeed MCP bridge ─────────────────────────────────
    try:
        bridge = Path.home() / ".claude/bin/agency/indeed-mcp-search"
        if bridge.exists():
            result = subprocess.run(
                ["python3", str(bridge)],
                capture_output=True, text=True, timeout=120,
                env={**os.environ}
            )
            if result.returncode == 0 and result.stdout.strip():
                import re as _re
                m = _re.search(r'\[.*\]', result.stdout, _re.DOTALL)
                if m:
                    mcp_jobs = json.loads(m.group())
                    if mcp_jobs:
                        log(f"Indeed MCP: {len(mcp_jobs)} real-time jobs")
                        return mcp_jobs
    except Exception as e:
        log(f"Indeed MCP bridge error: {e} — trying Apify fallback")

    log("Indeed (Apify fallback)...")

    # ── HMZ SKILL FILTER — only jobs matching core skills ────────────
    INDEED_KEYWORDS = [
        "Google Ads specialist",
        "Meta Ads manager",
        "Facebook Ads specialist",
        "PPC specialist remote",
        "paid media manager remote",
        "performance marketing specialist",
        "Google Ads manager remote",
        "digital advertising specialist remote",
    ]

    # ── Attempt 1: Apify bebity~indeed-scraper (real-time Indeed data) ──
    if APIFY_TOKEN:
        try:
            # Check if Apify is available first
            status_r = requests.get(
                "https://api.apify.com/v2/users/me",
                headers={"Authorization": f"Bearer {APIFY_TOKEN}"},
                timeout=8
            )
            feat = status_r.json().get("data",{}).get("effectivePlatformFeatures",{}).get("ACTORS",{})
            apify_disabled = feat.get("isDisabled") or feat.get("disabledReason")

            if not apify_disabled:
                log("Indeed: using Apify actor (live data)...")
                actor_url = f"https://api.apify.com/v2/acts/bebity~indeed-scraper/runs?token={APIFY_TOKEN}&timeout=120"
                payload = {
                    "keyword": "Google Ads OR Meta Ads OR PPC OR Facebook Ads OR paid media manager",
                    "location": "Remote",
                    "country": "US",       # primary — also catches many global remote roles
                    "maxItems": 60,
                    "datePosted": "1",     # last 24 hours only — daily fresh
                    "jobType": "fulltime,parttime,contract",
                    "remoteOnly": True,
                }
                run_r = requests.post(actor_url, json=payload, timeout=30)
                if run_r.status_code in (200, 201):
                    run_data = run_r.json().get("data", {})
                    run_id   = run_data.get("id","")
                    ds_id    = run_data.get("defaultDatasetId","")
                    # Poll until done (max 90s)
                    for _ in range(18):
                        time.sleep(5)
                        s = requests.get(f"https://api.apify.com/v2/actor-runs/{run_id}?token={APIFY_TOKEN}", timeout=10).json()
                        status = s.get("data",{}).get("status","")
                        if status in ("SUCCEEDED","FAILED","ABORTED","TIMED-OUT"):
                            break
                    # Fetch results
                    res_r = requests.get(f"https://api.apify.com/v2/datasets/{ds_id}/items?token={APIFY_TOKEN}&format=json&limit=100", timeout=20)
                    raw_jobs = res_r.json() if isinstance(res_r.json(), list) else []
                    log(f"Indeed (Apify): {len(raw_jobs)} raw jobs fetched")

                    # Normalize → standard job dict
                    jobs = []
                    for j in raw_jobs:
                        title = j.get("title","") or j.get("jobTitle","")
                        url   = j.get("url","") or j.get("jobUrl","") or j.get("applyLink","")
                        company = j.get("company","") or j.get("companyName","")
                        location = j.get("location","") or j.get("jobLocation","")
                        salary = j.get("salary","") or j.get("salaryRange","") or extract_budget(j.get("description",""))
                        desc  = j.get("description","") or j.get("jobDescription","")
                        posted = j.get("datePosted","") or j.get("postedAt","") or j.get("date","")

                        if not title or not url or not dedup(url): continue

                        # HMZ skill filter — skip irrelevant roles immediately
                        combined = (title + " " + desc).lower()
                        SKILL_MUST = ["google ads","meta ads","facebook ads","ppc","paid media",
                                      "paid ads","performance marketing","media buyer","gads","fb ads"]
                        if not any(kw in combined for kw in SKILL_MUST):
                            continue

                        jobs.append({
                            "platform":    "indeed",
                            "title":       title,
                            "description": desc[:800],
                            "url":         url,
                            "budget":      salary,
                            "client_info": {"company": company, "location": location, "posted": posted},
                            "posted_at":   posted,
                            "markdown":    "",
                            "remote":      True,
                        })
                    log(f"Indeed (Apify): {len(jobs)} skill-matched jobs after filter")
                    if jobs:
                        return jobs
            else:
                reason = feat.get("disabledReason","CU limit")
                log(f"Indeed: Apify disabled ({reason}) — using RAG fallback")
        except Exception as e:
            log(f"Indeed Apify error: {e} — using RAG fallback")

    # ── Fallback: RAG Google search (when Apify CU exhausted) ────────
    log("Indeed: RAG fallback (site:indeed.com search)...")
    items = []
    for q in [
        'site:indeed.com "google ads" OR "meta ads" specialist remote 2026',
        'site:indeed.com "facebook ads" manager remote PPC contract',
        'site:indeed.com "paid media" specialist manager remote apply now',
        'indeed.com/jobs "google ads" OR "meta ads" remote freelance contract',
    ]:
        items += rag_search(q, 5)
    return make_jobs(items, "indeed", "indeed.com")

