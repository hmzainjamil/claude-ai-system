#!/usr/bin/env python3
"""
UPWORK AGENT RESUME — Auto-restart + recovery system.
Runs upwork-agent in a loop. If it fails (network, crash, kicked),
waits and restarts from checkpoint. Like a human who pauses and tries again.

Usage:
  upwork-resume              # Run with auto-recovery loop
  upwork-resume --once       # Run once, no retry
  upwork-resume --daemon     # Background loop, daily schedule
"""
import os, sys, time, subprocess, datetime, json, socket
from pathlib import Path

HOME   = Path.home()
AGENT  = HOME / ".claude/bin/agency/upwork-agent"
STATE  = HOME / ".claude/agency/data/upwork_agent_state.json"
LOG    = HOME / ".claude/agency/logs/upwork-resume.log"
LOG.parent.mkdir(parents=True, exist_ok=True)

MAX_RETRIES = 5
RETRY_DELAYS = [30, 60, 120, 300, 600]  # seconds between retries

def log(msg):
    ts = datetime.datetime.now().strftime("%H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    with open(LOG, "a") as f:
        f.write(f"[{datetime.datetime.now().isoformat()}] {msg}\n")

def check_network():
    try:
        socket.create_connection(("8.8.8.8", 53), timeout=5)
        return True
    except Exception:
        return False

def wait_for_network():
    for attempt in range(60):  # max 10 minutes
        if check_network():
            if attempt > 0:
                log(f"  Network restored after {attempt*10}s")
            return True
        log(f"  No network — retry {attempt+1}/60...")
        time.sleep(10)
    return False

def kill_stale_browsers():
    """Kill any lingering Chrome processes that would block new instance."""
    os.system("pkill -f 'Google Chrome for Testing' 2>/dev/null")
    import glob, os as _os
    for lock in glob.glob(str(HOME / ".claude/agency/browser-profile/Singleton*Lock")):
        try:
            _os.remove(lock)
        except Exception:
            pass
    time.sleep(2)

def run_agent(args=""):
    """Run the agent script and return exit code."""
    cmd = [sys.executable, str(AGENT)] + (args.split() if args else [])
    result = subprocess.run(cmd, timeout=600)
    return result.returncode

def main():
    args = sys.argv[1:]

    if "--once" in args:
        kill_stale_browsers()
        exit_code = run_agent()
        sys.exit(exit_code)

    log("UPWORK RESUME — Auto-recovery loop starting")

    for attempt in range(MAX_RETRIES):
        log(f"Attempt {attempt+1}/{MAX_RETRIES}...")

        # Ensure network
        if not check_network():
            log("Network down — waiting...")
            if not wait_for_network():
                log("Network never came back — aborting")
                sys.exit(1)

        # Kill stale browsers
        kill_stale_browsers()

        try:
            exit_code = run_agent()
            if exit_code == 0:
                log(f"Agent completed successfully on attempt {attempt+1}")
                sys.exit(0)
            else:
                log(f"Agent exited with code {exit_code}")
        except subprocess.TimeoutExpired:
            log("Agent timed out (10min) — restarting...")
        except KeyboardInterrupt:
            log("Interrupted by user")
            sys.exit(0)
        except Exception as e:
            log(f"Error running agent: {e}")

        if attempt < MAX_RETRIES - 1:
            delay = RETRY_DELAYS[attempt]
            log(f"Waiting {delay}s before retry {attempt+2}...")
            time.sleep(delay)

    log("All retries exhausted — giving up")
    sys.exit(1)

if __name__ == "__main__":
    main()
