#!/usr/bin/env python3
"""
Indeed Jobs HTML Report Generator
Reads today's Indeed MCP job data → generates professional HTML dashboard
Saves to ~/Downloads/Indeed-Jobs-Report-YYYYMMDD-HHMM.html
Auto-opens in browser after generation.
"""

import json, datetime, os, subprocess
from pathlib import Path

HOME       = Path.home()
DATA_DIR   = HOME / ".claude/agency/data"
REPORT_DIR = HOME / "Downloads/job-dashboards"
REPORT_DIR.mkdir(parents=True, exist_ok=True)
TODAY      = datetime.date.today().strftime("%Y%m%d")
NOW        = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
NOW_FILE   = datetime.datetime.now().strftime("%Y%m%d-%H%M")
SWEEP      = "🌅 Morning" if datetime.datetime.now().hour < 14 else "🌙 Evening"

# ── Load jobs ─────────────────────────────────────────────────────
def load_jobs():
    # Try indeed_mcp cache first
    mcp_file = DATA_DIR / f"indeed_mcp_{TODAY}.json"
    if mcp_file.exists():
        data = json.loads(mcp_file.read_text())
        jobs = data.get("jobs", data) if isinstance(data, dict) else data
        if jobs:
            return jobs, "Indeed MCP (Live API)"

    # Fallback: BDM jobs file
    jobs_file = DATA_DIR / f"jobs_{TODAY}.json"
    if jobs_file.exists():
        data = json.loads(jobs_file.read_text())
        jobs = data.get("jobs", []) if isinstance(data, dict) else data
        indeed_jobs = [j for j in jobs if "indeed" in j.get("platform","").lower()]
        if indeed_jobs:
            return indeed_jobs, "BDM Pipeline (cached)"
        return jobs, "BDM Pipeline (all platforms)"

    return [], "No data found"

def pk_badge(status):
    if status == "YES":
        return '<span class="badge pk-yes">✅ PK SAFE</span>'
    if status == "NO":
        return '<span class="badge pk-no">❌ BLOCKED</span>'
    return '<span class="badge pk-maybe">⚠️ VERIFY</span>'

def salary_display(budget):
    if not budget: return '<span class="no-data">—</span>'
    return f'<span class="salary">{budget}</span>'

def generate_html(jobs, source):
    pk_yes   = [j for j in jobs if j.get("pk_compatible") == "YES"]
    pk_maybe = [j for j in jobs if j.get("pk_compatible") == "MAYBE"]
    pk_no    = [j for j in jobs if j.get("pk_compatible") == "NO"]
    contracts= [j for j in jobs if "contract" in (j.get("job_type","") + j.get("description","") + str(j.get("client_info",""))).lower()]

    # Sort by HMZ score (highest first)
    sorted_jobs = sorted(jobs, key=lambda x: -x.get("hmz_score", 0))

    apply_count  = len([j for j in jobs if j.get("hmz_rec") == "APPLY"])
    verify_count = len([j for j in jobs if j.get("hmz_rec") == "VERIFY"])
    skip_count   = len([j for j in jobs if j.get("hmz_rec") == "SKIP"])

    job_rows = ""
    for i, j in enumerate(sorted_jobs, 1):
        title    = j.get("title","") or j.get("name","")
        company  = j.get("client_info",{}).get("company","") if isinstance(j.get("client_info"),dict) else ""
        location = j.get("client_info",{}).get("location","Remote") if isinstance(j.get("client_info"),dict) else "Remote"
        posted   = j.get("client_info",{}).get("posted","") if isinstance(j.get("client_info"),dict) else j.get("posted_at","")
        url      = j.get("url","") or j.get("apply_url","")
        budget   = j.get("budget","")
        pk_status= j.get("pk_compatible","MAYBE")
        pk_rsn   = j.get("pk_reason","") or ""
        country  = j.get("client_info",{}).get("country","") if isinstance(j.get("client_info"),dict) else ""
        hmz_sc   = j.get("hmz_score", 0)
        hmz_rec  = j.get("hmz_rec", "VERIFY")
        hmz_flags= j.get("hmz_flags", [])

        rec_color = {"APPLY":"#2ea043","VERIFY":"#d29922","SKIP":"#da3633"}.get(hmz_rec,"#8b949e")
        rec_bg    = {"APPLY":"#0d2d1a","VERIFY":"#2d1f00","SKIP":"#2d0c0c"}.get(hmz_rec,"#161b22")
        row_class = {"APPLY":"row-yes","VERIFY":"row-maybe","SKIP":"row-no"}.get(hmz_rec,"row-maybe")

        score_bar_w = max(4, hmz_sc)
        score_color = "#3fb950" if hmz_sc>=80 else ("#e3b341" if hmz_sc>=60 else "#f85149")

        apply_btn = f'<a href="{url}" target="_blank" class="apply-btn rec-{hmz_rec.lower()}">{hmz_rec} →</a>' if url else f'<span class="no-url">{hmz_rec}</span>'

        flags_html = ""
        if hmz_flags:
            flags_html = "<br>" + " ".join(f'<span class="flag-tag">{f}</span>' for f in hmz_flags)

        job_rows += f"""
        <tr class="{row_class}">
            <td class="rank">#{i}</td>
            <td class="score-cell">
                <div class="score-num" style="color:{score_color}">{hmz_sc}</div>
                <div class="score-bar-bg"><div class="score-bar-fill" style="width:{score_bar_w}%;background:{score_color}"></div></div>
            </td>
            <td class="title-cell">
                <div class="job-title">{title}</div>
                <div class="company">{company}</div>
                {flags_html}
            </td>
            <td>{location}<br><small>{country}</small></td>
            <td>{salary_display(budget)}</td>
            <td>{posted or "—"}</td>
            <td>{pk_badge(pk_status)}</td>
            <td>{apply_btn}</td>
        </tr>"""

    html = f"""<!DOCTYPE html>
