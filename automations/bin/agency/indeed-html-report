  .stat-card.amber {{ border-color: var(--amber); background: var(--amber-bg); }}
  .stat-card.red   {{ border-color: var(--red);   background: var(--red-bg); }}
  .stat-num {{ font-size: 36px; font-weight: 700; line-height:1; }}
  .stat-card.green .stat-num {{ color: #3fb950; }}
  .stat-card.amber .stat-num {{ color: #e3b341; }}
  .stat-card.red   .stat-num {{ color: #f85149; }}
  .stat-label {{ color: var(--muted); font-size: 12px; margin-top: 6px; text-transform: uppercase; letter-spacing: .5px; }}

  .filter-bar {{ padding: 0 40px 16px; display:flex; gap:10px; flex-wrap:wrap; }}
  .filter-btn {{ background: var(--surface); border: 1px solid var(--border); color: var(--text);
    padding: 6px 16px; border-radius: 20px; cursor:pointer; font-size: 13px; transition:.2s; }}
