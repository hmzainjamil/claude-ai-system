    return html

def main():
    jobs, source = load_jobs()
    print(f"[indeed-html-report] {len(jobs)} jobs loaded from: {source}")

    if not jobs:
        # Create empty report with message
        jobs = []

    html = generate_html(jobs, source)

    # Save to Downloads with timestamp
    out_path = REPORT_DIR / f"Indeed-Jobs-{NOW_FILE}.html"
    out_path.write_text(html, encoding="utf-8")
    print(f"[indeed-html-report] ✅ Saved → {out_path}")

    # Also save as "latest" for easy access
    latest = REPORT_DIR / "Indeed-Jobs-LATEST.html"
    latest.write_text(html, encoding="utf-8")

    # Auto-open in browser
    subprocess.run(["open", str(out_path)], check=False)
    print(f"[indeed-html-report] Opened in browser")
    return str(out_path)

if __name__ == "__main__":
    main()
