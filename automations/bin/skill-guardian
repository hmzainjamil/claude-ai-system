#!/usr/bin/env bash
# skill-guardian — Hourly security daemon wrapper
# Runs skill-scanner silently, alerts only on threats
# Called by LaunchAgent every hour — zero token consumption

set -e
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.claude/bin:$PATH"
source ~/.claude/tier0.env 2>/dev/null || true

LOG="$HOME/.claude/security/logs/guardian.log"
ALERT_FILE="$HOME/.claude/security/logs/last-alert.txt"
SCANNER="$HOME/.claude/bin/skill-scanner"
PYTHON="/usr/bin/python3"

mkdir -p "$(dirname "$LOG")"

ts() { date '+%Y-%m-%d %H:%M:%S'; }

echo "[$(ts)] Guardian scan starting..." >> "$LOG"

# Run scanner (fast pattern mode, no deep LLM unless threats found)
OUTPUT=$("$PYTHON" "$SCANNER" 2>&1) || THREATS_FOUND=1

echo "$OUTPUT" >> "$LOG"

if [ "${THREATS_FOUND:-0}" -eq 1 ]; then
    # Extract threat count from output
    THREAT_COUNT=$(echo "$OUTPUT" | grep "Threats found:" | awk '{print $NF}')
    QUARANTINED=$(echo "$OUTPUT" | grep "Quarantined:" | awk '{print $NF}')

    MSG="[SECURITY ALERT] $(ts)
Threats detected: ${THREAT_COUNT:-unknown}
Quarantined: ${QUARANTINED:-0}
Full log: $HOME/.claude/security/logs/scan.log
Reports: $HOME/.claude/security/reports/"

    echo "$MSG" > "$ALERT_FILE"
    echo "$MSG" >> "$LOG"

    # macOS notification
    osascript -e "display notification \"$THREAT_COUNT threat(s) quarantined automatically\" with title \"Claude Security Guardian\" sound name \"Sosumi\"" 2>/dev/null || true

    # Also log to tier0-context for Claude awareness
    echo "[SECURITY] Threats found at $(ts): $MSG" >> "$HOME/.claude/tier0-context.txt" 2>/dev/null || true
else
    echo "[$(ts)] Scan clean — no threats" >> "$LOG"
fi

# Rotate log if >10MB
LOG_SIZE=$(stat -f%z "$LOG" 2>/dev/null || echo 0)
if [ "$LOG_SIZE" -gt 10485760 ]; then
    mv "$LOG" "$LOG.$(date +%Y%m%d).bak"
    echo "[$(ts)] Log rotated" > "$LOG"
fi

echo "[$(ts)] Guardian scan complete" >> "$LOG"
