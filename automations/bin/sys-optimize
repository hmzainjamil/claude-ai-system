#!/usr/bin/env python3
"""
sys-optimize — Auto cache cleaner + system optimizer
Safe, non-destructive, RAM-aware. Never touches user files or active models.

Usage:
  sys-optimize           — dry run (show what will be cleaned)
  sys-optimize --run     — execute cleanup
  sys-optimize --deep    — deep clean (includes Playwright, electron, node-gyp)
  sys-optimize --status  — disk/RAM snapshot only
"""

import os, sys, subprocess, shutil, argparse
from pathlib import Path
from datetime import datetime, timedelta

DRY = True  # default: safe preview mode

B = "\033[34m"; G = "\033[32m"; Y = "\033[33m"; R = "\033[31m"; C = "\033[36m"; W = "\033[37m"; BOLD = "\033[1m"; RST = "\033[0m"
def p(text, c=""): print(f"{c}{text}{RST}", flush=True)

HOME = Path.home()

# ─── SAFE TARGETS — always clean ─────────────────────────────────────────────
SAFE_TARGETS = [
    # npm / node
    (HOME / ".npm/_cacache",              "npm cache",           True),
    (HOME / ".npm/tmp",                   "npm tmp",             True),
    (HOME / "Library/Caches/node-gyp",    "node-gyp cache",      True),

    # Python / pip
    (HOME / "Library/Caches/pip",         "pip cache",           True),
    (HOME / "Library/Caches/com.apple.python", "Apple Python cache", True),

    # Homebrew
    (HOME / "Library/Caches/Homebrew",    "Homebrew cache",      True),

    # Claude CLI
    (HOME / "Library/Caches/claude-cli-nodejs", "Claude CLI cache", True),

    # Browser caches (safe — rebuilds automatically)
    (HOME / "Library/Caches/com.brave.Browser", "Brave HTTP cache", True),
    (HOME / "Library/Caches/Google",       "Google cache",        True),

    # Logs
    (HOME / "Library/Logs",               "User logs",           True),
    (Path("/private/var/log"),             "System logs",         False),  # need perms

    # Apple system caches (rebuilt automatically)
    (HOME / "Library/Caches/com.apple.helpd",              "Help cache",      True),
    (HOME / "Library/Caches/com.apple.icloudmailagent",    "iCloud mail cache", True),
    (HOME / "Library/Caches/com.apple.AppleMediaServices", "Apple Media cache", True),
    (HOME / "Library/Caches/CloudKit",                     "CloudKit cache",  True),

    # TCC done tasks older than 7 days
    (HOME / ".claude/tasks",              "TCC old tasks",       True),  # handled specially
    (HOME / ".claude/tcc-logs",           "TCC logs >30d",       True),  # handled specially

    # Tmp
    (Path("/private/tmp"),                "System tmp",          False),
]

# ─── DEEP TARGETS — only with --deep ─────────────────────────────────────────
DEEP_TARGETS = [
    (HOME / "Library/Caches/ms-playwright",  "Playwright browsers", True),   # 520MB — re-downloads
    (HOME / "Library/Caches/electron",       "Electron cache",      True),   # 111MB
    (HOME / "Library/Caches/Comet",          "Comet cache",         True),   # 188MB
    (HOME / "Library/Caches/node-gyp",       "node-gyp builds",     True),
    (HOME / ".cache/node",                   "Node cache",          True),
    (HOME / ".cache/uv",                     "uv package cache",    True),
]

# ─── NEVER TOUCH — protected list ────────────────────────────────────────────
PROTECTED = [
    HOME / ".cache/gpt4all",          # GPT4All models — active, 2.8GB
    HOME / "Library/Caches/BraveSoftware",  # Brave app data (not just cache)
    HOME / "Downloads",               # User files
    HOME / "Documents",
    HOME / "Desktop",
    HOME / ".claude",                 # Claude config (handled carefully above)
    HOME / "installed-repos",         # 149 repos
    HOME / ".ollama",                 # Ollama models
]

def get_size(path: Path) -> int:
    """Get size in bytes. Returns 0 if not accessible."""
    try:
        result = subprocess.run(
            ["du", "-sk", str(path)],
            capture_output=True, text=True, timeout=10
        )
        kb = int(result.stdout.split()[0]) if result.stdout.strip() else 0
        return kb * 1024
    except Exception:
        return 0

def fmt_size(b: int) -> str:
    if b >= 1e9: return f"{b/1e9:.1f}GB"
    if b >= 1e6: return f"{b/1e6:.0f}MB"
    if b >= 1e3: return f"{b/1e3:.0f}KB"
    return f"{b}B"

def get_ram_gb() -> float:
    try:
        import re
        out = subprocess.check_output(["vm_stat"], timeout=3).decode()
        free  = int(re.search(r"Pages free:\s+(\d+)", out).group(1))
        inact = int(re.search(r"Pages inactive:\s+(\d+)", out).group(1))
        return round((free + inact) * 4096 / 1024**3, 1)
    except Exception:
        return 0.0

def get_disk_free_gb() -> float:
    try:
        s = shutil.disk_usage("/")
        return round(s.free / 1e9, 1)
    except Exception:
        return 0.0

def clean_tcc_tasks(dry: bool) -> int:
    """Remove TCC tasks older than 7 days with status done/failed/cancelled."""
    import json
    tasks_dir = HOME / ".claude/tasks"
    if not tasks_dir.exists():
        return 0
    cutoff = datetime.now() - timedelta(days=7)
    removed = 0
    freed = 0
    for f in tasks_dir.glob("*.json"):
        try:
            t = json.loads(f.read_text())
            status = t.get("status", "")
            created_str = t.get("created", "")
            if status in ("done", "failed", "cancelled") and created_str:
                created = datetime.fromisoformat(created_str[:19])
                if created < cutoff:
                    freed += f.stat().st_size
                    if not dry:
                        f.unlink()
                    removed += 1
        except Exception:
            pass
    return freed

def clean_tcc_logs(dry: bool) -> int:
    """Remove MAE log files older than 30 days."""
    logs_dir = HOME / ".claude/tcc-logs"
    if not logs_dir.exists():
        return 0
    cutoff = datetime.now() - timedelta(days=30)
    freed = 0
    for f in logs_dir.glob("mae-*.md"):
        try:
            if datetime.fromtimestamp(f.stat().st_mtime) < cutoff:
                freed += f.stat().st_size
                if not dry:
                    f.unlink()
        except Exception:
            pass
    return freed

def clean_path(path: Path, dry: bool) -> int:
    """Remove path contents. Returns bytes freed."""
    if not path.exists():
        return 0
    # Safety: never clean protected paths
    for protected in PROTECTED:
        try:
            path.relative_to(protected)
            p(f"    ⚠ PROTECTED — skipping {path}", Y)
            return 0
        except ValueError:
            pass

    size = get_size(path)

    if dry:
        return size

    try:
        if path.is_dir():
            shutil.rmtree(str(path), ignore_errors=True)
            path.mkdir(parents=True, exist_ok=True)  # recreate empty dir
        else:
            path.unlink(missing_ok=True)
        return size
    except Exception as e:
        p(f"    ✗ Could not clean {path}: {e}", R)
        return 0

def purge_dns_cache(dry: bool):
    if dry:
        return
    try:
        subprocess.run(["sudo", "-n", "dscacheutil", "-flushcache"], timeout=5, capture_output=True)
        subprocess.run(["sudo", "-n", "killall", "-HUP", "mDNSResponder"], timeout=5, capture_output=True)
    except Exception:
        pass

def cmd_status():
    disk_free = get_disk_free_gb()
    ram_free  = get_ram_gb()
    p(f"\n{BOLD}{B}╔══════════════════════════════════════════════════╗{RST}")
    p(f"{BOLD}{B}║  SYSTEM STATUS                                   ║{RST}")
    p(f"{BOLD}{B}╚══════════════════════════════════════════════════╝{RST}")
    p(f"  Disk free:  {disk_free}GB", G if disk_free > 50 else Y if disk_free > 20 else R)
    p(f"  RAM free:   {ram_free}GB",  G if ram_free > 3 else Y if ram_free > 1.5 else R)
    p("")
    p("  Top cache consumers:", C)
    result = subprocess.run(
        ["du", "-sh",
         str(HOME / "Library/Caches"),
         str(HOME / ".cache"),
         str(HOME / ".npm"),
         str(HOME / "Library/Logs")],
        capture_output=True, text=True, timeout=15
    )
    for line in result.stdout.splitlines():
        size, path = line.split("\t", 1)
        p(f"    {size:8}  {path}", W)

def run_optimization(deep: bool, dry: bool):
    mode_label = "DRY RUN — nothing deleted" if dry else "LIVE CLEANUP — deleting now"
    deep_label = " + DEEP" if deep else ""

    p(f"\n{BOLD}{G}╔══════════════════════════════════════════════════╗{RST}")
    p(f"{BOLD}{G}║  SYS-OPTIMIZE{deep_label}  [{mode_label}]{' ':>5}║{RST}")
    p(f"{BOLD}{G}╚══════════════════════════════════════════════════╝{RST}")
    p(f"  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")

    before_disk = get_disk_free_gb()
    before_ram  = get_ram_gb()
    total_freed = 0
    targets = list(SAFE_TARGETS) + (DEEP_TARGETS if deep else [])

    p("  ── Cleaning caches ──────────────────────────────", C)
    for path, label, user_owned in targets:
        if path == HOME / ".claude/tasks":
            freed = clean_tcc_tasks(dry)
            total_freed += freed
            if freed:
                sym = "~" if dry else "✓"
                p(f"  {sym} {label:<30} {fmt_size(freed):>8}", Y if dry else G)
            continue
        if path == HOME / ".claude/tcc-logs":
            freed = clean_tcc_logs(dry)
            total_freed += freed
            if freed:
                sym = "~" if dry else "✓"
                p(f"  {sym} {label:<30} {fmt_size(freed):>8}", Y if dry else G)
            continue
        if not path.exists():
            continue
        size = get_size(path)
        if size < 1024 * 100:  # skip < 100KB
            continue
        freed = clean_path(path, dry)
        total_freed += freed
        sym = "~" if dry else "✓"
        color = Y if dry else G
        p(f"  {sym} {label:<30} {fmt_size(freed):>8}", color)

    # DNS cache flush
    p(f"\n  {'~' if dry else '✓'} DNS cache flush", Y if dry else G)
    purge_dns_cache(dry)

    # npm cache clean (uses npm's own command for safety)
    npm_out = ""
    if not dry:
        try:
            r = subprocess.run(["npm", "cache", "clean", "--force"],
                               capture_output=True, text=True, timeout=30)
            npm_out = " (npm clean: OK)" if r.returncode == 0 else ""
        except Exception:
            pass
    p(f"  {'~' if dry else '✓'} npm cache clean{npm_out}", Y if dry else G)

    # Homebrew cleanup
    if not dry:
        try:
            subprocess.run(["brew", "cleanup", "--prune=7"],
                           capture_output=True, timeout=60)
            p("  ✓ Homebrew cleanup (--prune=7)", G)
        except Exception:
            p("  ~ Homebrew not found", Y)

    # pip cache purge
    if not dry:
        try:
            subprocess.run(["pip3", "cache", "purge"],
                           capture_output=True, timeout=30)
            p("  ✓ pip cache purge", G)
        except Exception:
            pass

    after_disk = get_disk_free_gb()
    after_ram  = get_ram_gb()
    disk_gained = round(after_disk - before_disk, 1)
    ram_gained  = round(after_ram  - before_ram,  1)

    p(f"\n{BOLD}{G}  ── Results {'(estimated)' if dry else ''} ─────────────────────────────{RST}")
    p(f"  Disk freed:   ~{fmt_size(total_freed)} {'(projected)' if dry else ''}", G)
    if not dry:
        p(f"  Disk free:   {before_disk}GB → {after_disk}GB (+{disk_gained}GB)", G)
        p(f"  RAM free:    {before_ram}GB → {after_ram}GB", G)

    if dry:
        p(f"\n  Run with --run to execute cleanup", Y)
        p(f"  Run with --deep --run for +deep clean (Playwright, Electron, etc.)", Y)

    # Save log
    log = HOME / ".claude/tcc-logs/sys-optimize.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    entry = f"{datetime.now().isoformat()[:19]} | freed:{fmt_size(total_freed)} | disk:{before_disk}→{after_disk}GB | mode:{'dry' if dry else 'live'}\n"
    existing = log.read_text() if log.exists() else ""
    log.write_text(entry + existing[:10000])

def main():
    parser = argparse.ArgumentParser(prog="sys-optimize", description="Mac system cache cleaner + optimizer")
    parser.add_argument("--run",    action="store_true", help="Execute cleanup (default: dry run)")
    parser.add_argument("--deep",   action="store_true", help="Deep clean (Playwright, Electron, uv cache)")
    parser.add_argument("--status", action="store_true", help="Disk/RAM snapshot only")
    args = parser.parse_args()

    if args.status:
        cmd_status()
        return

    dry = not args.run
    run_optimization(deep=args.deep, dry=dry)

if __name__ == "__main__":
    main()
