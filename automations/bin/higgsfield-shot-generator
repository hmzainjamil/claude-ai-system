STYLE_SHOT_MAP = {
    "commercial": ["dolly-in", "orbit-180", "jib-up", "zoom-in", "leading-shot", "cinematic-arc"],
    "viral":      ["crash-zoom", "fpv-drone", "fast-dolly", "pov-walk", "side-tracking"],
    "cinematic":  ["dolly-in", "orbit-180", "rack-focus", "aerial-pullback", "crane-overhead", "cinematic-arc"],
    "product":    ["zoom-in", "zoom-out", "rack-focus", "extreme-macro", "orbit-180", "dolly-in"],
    "narrative":  ["tilt-up", "over-shoulder", "following-shot", "leading-shot", "through-shot", "aerial-pullback"],
    "action":     ["fast-dolly", "fpv-drone", "crash-zoom", "side-tracking", "aerial-pullback", "full-360"],
    "reels":      ["crash-zoom", "fpv-drone", "pov-walk", "fast-dolly", "through-shot"],
}

def llm_burst(prompt, models="groq,gemini"):
    env = {**os.environ, "PATH": f"{Path.home()}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"}
    try:
        r = subprocess.run([str(BURST_BIN), "--models", models, prompt[:500]],
            capture_output=True, text=True, timeout=60, env=env)
        return r.stdout.strip() or prompt
    except:
        return prompt

def adapt_prompt(base_prompt, subject):
    """Replace generic subject references with actual subject."""
    return (base_prompt
        .replace("the man", subject)
        .replace("the character", subject)
        .replace("a man", subject)
        .replace("him", subject.split()[0] if subject else "the subject")
    )

def generate_shots(subject, shot_keys, use_llm=False):
    results = []
    for key in shot_keys:
        if key not in SHOTS:
            continue
        shot = SHOTS[key]
        prompt = adapt_prompt(shot["prompt"], subject)
        if use_llm:
            enhanced = llm_burst(f"Adapt this Higgsfield Cinema Studio camera prompt for subject '{subject}'. Keep camera movement exact, only change scene details. Original: {prompt}")
            prompt = enhanced if enhanced else prompt
        results.append({
            "shot": shot["name"],
            "key": key,
            "type": shot["type"],
            "duration": shot["duration"],
            "category": shot["category"],
            "effect": shot["effect"],
            "prompt": prompt,
        })
    return results

def generate_storyboard(subject, beats, style="cinematic"):
    print(f"{C}→ Generating {beats}-beat storyboard for: {subject}{RST}")
    storyboard_prompt = f"""Create a {beats}-scene cinematic storyboard for: {subject}
Each scene needs: shot type, emotion goal, camera movement, action.
Available movements: dolly-in, dolly-out, orbit-180, crane-up, zoom-in, fpv-drone, leading-shot, through-shot
Format: SCENE N | SHOT TYPE | EMOTION | CAMERA | ACTION"""
    outline = llm_burst(storyboard_prompt)
    return outline

def list_shots():
    print(f"\n{B}{C}Higgsfield Cinema Studio — 29 Shot Library{RST}\n")
    categories = {}
    for key, shot in SHOTS.items():
        cat = shot["category"]
        if cat not in categories:
            categories[cat] = []
        categories[cat].append((key, shot))

    for cat, shots in categories.items():
        print(f"{Y}── {cat.upper()} MOVES ──{RST}")
        for key, shot in shots:
            print(f"  {G}{key:<20}{RST} {shot['name']:<25} [{shot['type']}] {shot['duration']}")
            print(f"  {'':20} {C}{shot['effect']}{RST}")
        print()

def save_output(subject, shots, style):
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    slug = subject.lower().replace(" ", "-")[:30]
    out_file = OUTPUT_DIR / f"shots-{slug}-{ts}.md"

    lines = [f"# Higgsfield Shot Prompts: {subject}\n",
             f"Generated: {datetime.now().isoformat()} | Style: {style}\n\n"]

    for s in shots:
        lines.append(f"## {s['shot']} [{s['type']}] — {s['duration']}\n")
        lines.append(f"**Effect:** {s['effect']}\n\n")
        lines.append(f"```\n{s['prompt']}\n```\n\n")

    out_file.write_text("".join(lines))
    print(f"\n{G}✓ Saved: {out_file}{RST}")
    return out_file

# ── Main ───────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    args = sys.argv[1:]

    if not args or "--help" in args or "-h" in args:
        print(__doc__)
        sys.exit(0)

    if "--list-shots" in args:
        list_shots()
        sys.exit(0)

    # Parse --shot "name" "subject"
    if "--shot" in args:
        idx = args.index("--shot")
        shot_name = args[idx+1].lower().replace(" ", "-") if idx+1 < len(args) else ""
        subject = args[idx+2] if idx+2 < len(args) else "character"
        shots = generate_shots(subject, [shot_name])
        for s in shots:
            print(f"\n{B}{s['shot']}{RST} [{s['type']}] — {s['duration']}")
            print(f"{C}{s['effect']}{RST}\n")
            print(s["prompt"])
        sys.exit(0)

    # First positional = subject
    subject = args[0] if args[0] and not args[0].startswith("--") else "character"

    style = "cinematic"
    n_shots = 6
    all_shots = False
    storyboard = False
    beats = 6
    platform = "general"

    for i, arg in enumerate(args):
        if arg == "--style" and i+1 < len(args):
            style = args[i+1]
        elif arg == "--shots" and i+1 < len(args):
            n_shots = int(args[i+1])
        elif arg == "--all-shots":
            all_shots = True
        elif arg == "--storyboard":
            storyboard = True
        elif arg == "--beats" and i+1 < len(args):
            beats = int(args[i+1])
        elif arg == "--platform" and i+1 < len(args):
            platform = args[i+1]

    if platform == "reels":
        style = "reels"

    print(f"\n{B}{C}Higgsfield Shot Generator{RST}")
    print(f"Subject: {subject} | Style: {style} | Platform: {platform}\n")

    if storyboard:
        outline = generate_storyboard(subject, beats, style)
        print(outline)
        ts = datetime.now().strftime("%Y%m%d-%H%M%S")
        out = OUTPUT_DIR / f"storyboard-{ts}.md"
        out.write_text(f"# Storyboard: {subject}\n\n{outline}")
        print(f"\n{G}✓ Saved: {out}{RST}")
    elif all_shots:
        shot_keys = list(SHOTS.keys())
        shots = generate_shots(subject, shot_keys)
        print(f"{G}Generated all {len(shots)} shots{RST}")
        out = save_output(subject, shots, "all")
        # Print condensed
        for s in shots:
            print(f"  {G}✓{RST} {s['shot']}")
    else:
        shot_pool = STYLE_SHOT_MAP.get(style, list(SHOTS.keys()))[:n_shots]
        shots = generate_shots(subject, shot_pool)
        save_output(subject, shots, style)
        print(f"\n{B}Shot Prompts:{RST}\n")
        for s in shots:
            print(f"{Y}── {s['shot']} [{s['type']}]{RST}")
            print(f"{s['prompt']}\n")

    print(f"\n{G}✓ Output saved to: {OUTPUT_DIR}{RST}")
