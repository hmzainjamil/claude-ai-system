#!/usr/bin/env python3
"""
higgsfield-shot-generator — AI cinematic shot prompt generator
Generates Higgsfield Cinema Studio prompts using multi-LLM burst.

Usage:
  higgsfield-shot-generator "subject" --shots 10 --style commercial
  higgsfield-shot-generator "subject" --all-shots
  higgsfield-shot-generator "subject" --storyboard --beats 6
  higgsfield-shot-generator --list-shots
  higgsfield-shot-generator --shot "dolly in" "your subject"
"""

import os, sys, json, subprocess
from pathlib import Path
from datetime import datetime

# ── Config ─────────────────────────────────────────────────────────────────
env_file = Path.home() / ".claude/tier0.env"
if env_file.exists():
    for line in env_file.read_text().splitlines():
        if line.startswith("export "): line = line[7:]
        if "=" in line and not line.startswith("#"):
            k, _, v = line.partition("=")
            k=k.strip(); v=v.strip().strip('"').strip("'")
            if k and v and k not in os.environ: os.environ[k] = v

BURST_BIN  = Path.home() / ".claude/bin/llm-burst"
LOGS_DIR   = Path.home() / ".claude/tcc-logs"
OUTPUT_DIR = Path.home() / "Downloads/higgsfield-output"
LOGS_DIR.mkdir(exist_ok=True)
OUTPUT_DIR.mkdir(exist_ok=True)

G="\033[32m"; Y="\033[33m"; C="\033[36m"; B="\033[1m"; RST="\033[0m"

