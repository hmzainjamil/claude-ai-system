<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.hmz.mae-paperclip-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mc/.claude/bin/mae-paperclip-bridge</string>
        <string>run</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mc/.claude/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/mc</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/mc/.claude/tcc-logs/paperclip-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mc/.claude/tcc-logs/paperclip-bridge.err</string>
    <key>WorkingDirectory</key>
    <string>/Users/mc</string>
</dict>
</plist>
