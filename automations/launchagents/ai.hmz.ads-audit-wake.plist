<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.hmz.ads-audit-wake</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mc/.claude/bin/ads-audit-wake-check.sh</string>
    </array>

    <!-- Check every 15 minutes — catches wakes after missed 5 PM -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>WINDSOR_API_KEY</key>
        <string>YOUR_WINDSOR_API_KEY_HERE</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/mc</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/mc/.claude/logs/ads-audit-wake.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mc/.claude/logs/ads-audit-wake.error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
