<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hmz.paperclip</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>source /Users/mc/.nvm/nvm.sh && export PATH="/Users/mc/.nvm/versions/node/v24.14.1/bin:$PATH" && pnpm dev</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/mc/.paperclip/instances/default/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mc/.paperclip/instances/default/logs/server-error.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/mc</string>
    <key>PATH</key>
    <string>/Users/mc/.nvm/versions/node/v24.14.1/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/mc/installed-repos/paperclip</string>
</dict>
</plist>
