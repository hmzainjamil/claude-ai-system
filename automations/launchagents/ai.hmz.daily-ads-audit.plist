<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.hmz.daily-ads-audit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>/Users/mc/.claude/bin/daily-ads-audit.py</string>
    </array>

    <!-- Daily at 17:00 (5 PM) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>17</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Also run when laptop wakes (catches missed 5 PM if lid was closed) -->
    <key>StartOnMount</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>WINDSOR_API_KEY</key>
        <string>YOUR_WINDSOR_API_KEY_HERE</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/mc</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/mc/.claude/logs/daily-ads-audit.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mc/.claude/logs/daily-ads-audit.error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
