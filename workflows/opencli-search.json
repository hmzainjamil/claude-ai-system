{
  "name": "opencli-search",
  "description": "Auto-trigger OpenCLI site searches from MAE goals — zero LLM tokens per web op",
  "version": "1.0",
  "trigger": {
    "keywords": ["search", "find", "look up", "research", "scrape", "extract from", "get data from"],
    "auto": true
  },
  "steps": [
    {
      "id": "detect-intent",
      "agent": "researcher",
      "model": "groq-llama3-8b",
      "action": "classify the search intent and identify best OpenCLI adapter",
      "adapters": {
        "amazon": "product/price research",
        "arxiv": "academic/paper research",
        "linkedin": "people/company B2B research",
        "github": "code/repo research",
        "hackernews": "tech news/startup news",
        "reddit": "community sentiment",
        "crunchbase": "funding/investor research",
        "producthunt": "new product launches",
        "twitter": "social/trending topics",
        "google": "general search fallback"
      }
    },
    {
      "id": "execute-search",
      "command": "~/.claude/bin/opencli-adapter mae",
      "input": "{{goal}}",
      "timeout": 30,
      "save_output": "~/.claude/tcc-logs/opencli-{{timestamp}}.txt"
    },
    {
      "id": "synthesize",
      "agent": "analyst",
      "model": "groq-70b",
      "action": "synthesize OpenCLI search results into actionable insights",
      "input": "{{execute-search.output}}"
    },
    {
      "id": "sync-paperclip",
      "command": "python3 ~/.claude/bin/mae-paperclip-bridge sync",
      "background": true
    }
  ],
  "output": "{{synthesize.output}}",
  "cost": "zero LLM tokens for web extraction (OpenCLI handles it)",
  "installed_adapters": 144
}
