PLATFORM_HANDLERS = {
    "upwork":        submit_upwork,
    "linkedin":      submit_linkedin,
    "freelancer":    submit_freelancer,
    "guru":          submit_guru,
    "peopleperhour": submit_peopleperhour,
    "pph":           submit_peopleperhour,
    "reddit":        submit_reddit,
}

PLATFORM_NAMES = {
    "upwork": "Upwork",
    "linkedin": "LinkedIn",
    "freelancer": "Freelancer",
    "guru": "Guru",
    "peopleperhour": "PeoplePerHour",
    "reddit": "Reddit",
    "bark": "Bark",
    "twitter": "Twitter",
    "naukri": "Naukri",
}


def cmd_run(filter_platform=None, dry_run=False):
    """Submit all today's unsent proposals on their platforms."""
    proposals = load_proposals()
    subs = load_submissions()

    if not proposals:
        log("No proposals found for today.")
        return 1

    # Filter to unsent only
    to_submit = [
        p for p in proposals
        if p.get("status") not in ("submitted", "sent", "expired", "skipped", "failed")
        and p.get("job_id", "") not in subs
        and (not filter_platform or p.get("platform","").lower() == filter_platform.lower())
    ]

    # Group by platform
    by_platform = {}
    for p in to_submit:
        plat = p.get("platform","unknown").lower()
        by_platform.setdefault(plat, []).append(p)

    log(f"Today's proposals: {len(proposals)} total, {len(to_submit)} to submit")
    for plat, jobs in by_platform.items():
        log(f"  {PLATFORM_NAMES.get(plat, plat)}: {len(jobs)}")

    if dry_run:
        log("DRY RUN — no actual submissions made")
        return 0

    if not to_submit:
        log("Nothing to submit today (all already submitted or no proposals)")
        return 0

    # Open browser
    p_browser, ctx = get_browser()
    page = ctx.new_page()

    submitted = 0
    failed = 0
    skipped = 0

    for job in to_submit:
        plat = job.get("platform","").lower()
        handler = PLATFORM_HANDLERS.get(plat)

        if not handler:
            log(f"  ⚠ No handler for platform '{plat}' — skipping: {job.get('job_title','')[:50]}")
            skipped += 1
            continue

        try:
            ok = handler(page, job)
            if ok:
                submitted += 1
                proposals, subs = mark_submitted(proposals, job.get("job_id",""), subs)
                save_proposals(proposals)
                save_submissions(subs)
                log(f"  ✓ [{submitted} submitted] {PLATFORM_NAMES.get(plat, plat)}: {job.get('job_title','')[:50]}")
            else:
                failed += 1
            # Brief delay between submissions
            time.sleep(8)

        except Exception as e:
            log(f"  ✗ Error submitting {job.get('job_title','')[:40]}: {e}")
            failed += 1

    ctx.close()
    p_browser.stop()

    log(f"\n{'='*50}")
    log(f"SUBMISSION COMPLETE")
    log(f"  Submitted: {submitted}")
    log(f"  Failed:    {failed}")
    log(f"  Skipped:   {skipped} (no handler/already done)")
    log(f"  Log: {LOG_FILE}")
    log(f"{'='*50}")
    return 0 if submitted > 0 else 1


def cmd_status():
    proposals = load_proposals()
    subs = load_submissions()
    by_status = {}
    for p in proposals:
        s = p.get("status", "draft")
        by_status.setdefault(s, []).append(p.get("platform","?"))

    print(f"\nToday's proposals ({TODAY}):")
    for status, platforms in by_status.items():
        from collections import Counter
        c = Counter(platforms)
        print(f"  {status}: {len(platforms)} — {dict(c)}")
    print(f"\nPlatform submissions on record: {len(subs)}")
    print(f"Log: {LOG_FILE}\n")


def main():
    args = sys.argv[1:]

    if not args or "--help" in args:
        print(__doc__)
        return 0

    dry_run = "--dry-run" in args

    if "--status" in args:
        cmd_status()
        return 0

    filter_platform = None
    if "--platform" in args:
        idx = args.index("--platform")
        filter_platform = args[idx+1] if idx+1 < len(args) else None

    if "--run" in args or filter_platform:
        return cmd_run(filter_platform=filter_platform, dry_run=dry_run)

    if "--dry-run" in args:
        return cmd_run(dry_run=True)

    print("Use --run, --platform NAME, --status, or --dry-run")
    return 1


if __name__ == "__main__":
    sys.exit(main())
