def submit_linkedin(page, job):
    """Click Easy Apply on LinkedIn job and submit."""
    url   = job.get("job_url", job.get("url", ""))
    title = job.get("job_title", "")[:60]
    text  = job.get("proposal_text", "")

    if not url or "linkedin.com" not in url:
        log(f"  ✗ LinkedIn: invalid URL for '{title}'")
        return False

    log(f"  → LinkedIn: {title}")
    try:
        page.goto(url, timeout=30000, wait_until="domcontentloaded")
        time.sleep(3)

        cur = page.url
        if "/login" in cur or "authwall" in cur:
            log("  ✗ LinkedIn: not logged in. Need hmzainjamil@gmail.com")
            return False

        # Find Easy Apply button
        easy_apply = None
        for sel in [
            'button:has-text("Easy Apply")',
            '.jobs-apply-button:has-text("Easy Apply")',
            'button[aria-label*="Easy Apply"]',
        ]:
            try:
                btn = page.locator(sel).first
                if btn.is_visible(timeout=5000):
                    easy_apply = btn
                    break
            except Exception:
                pass

        if not easy_apply:
            # Not Easy Apply — external link
            log(f"  ⚠ LinkedIn: No Easy Apply button (external application). Skipping.")
            return False

        easy_apply.click()
        time.sleep(3)

        # Try to fill cover letter if present
        for sel in [
            'textarea[id*="cover-letter"]',
            'textarea[placeholder*="cover letter" i]',
            'textarea[aria-label*="cover letter" i]',
        ]:
            try:
                box = page.locator(sel).first
                if box.is_visible(timeout=3000):
                    box.fill(text[:2000])
                    log("  ✓ LinkedIn: cover letter filled")
                    break
            except Exception:
                pass

        # Click through Next → Review → Submit
        max_steps = 8
        for step in range(max_steps):
            time.sleep(2)
            submitted = False
            for sel in [
                'button:has-text("Submit application")',
                'button[aria-label*="Submit application"]',
            ]:
                try:
                    btn = page.locator(sel).first
                    if btn.is_visible(timeout=2000):
                        btn.click()
                        submitted = True
                        time.sleep(3)
                        log(f"  ✓ LinkedIn: SUBMITTED — {title}")
                        return True
                except Exception:
                    pass

            # Click Next
            next_clicked = False
            for sel in [
                'button:has-text("Next")',
                'button:has-text("Continue")',
                'button:has-text("Review")',
            ]:
                try:
                    btn = page.locator(sel).first
                    if btn.is_visible(timeout=2000):
                        btn.click()
                        next_clicked = True
                        break
                except Exception:
                    pass

            if not next_clicked and not submitted:
                log(f"  ⚠ LinkedIn: stuck at step {step+1} — manual review needed")
                break

        log(f"  ✗ LinkedIn: did not reach Submit button")
        return False

    except Exception as e:
        log(f"  ✗ LinkedIn error: {e}")
        return False


