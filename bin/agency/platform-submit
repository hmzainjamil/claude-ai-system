        try:
            result = page.evaluate("""() => {
                const btns = [...document.querySelectorAll('button[type="submit"], input[type="submit"]')];
                for (const b of btns) {
                    if (!b.disabled) { b.click(); return true; }
                }
                return false;
            }""")
            if result:
                time.sleep(4)
                log(f"  ✓ Reddit: COMMENT POSTED (JS) — {title}")
                return True
        except Exception:
            pass

        log(f"  ⚠ Reddit: filled but submit not found — check browser")
        return False

    except Exception as e:
        log(f"  ✗ Reddit error: {e}")
        return False


