#!/usr/bin/env python3
"""
PLATFORM SUBMIT ENGINE — Real proposal submission on job platforms
Submits proposals DIRECTLY on Upwork, LinkedIn, Freelancer, Guru, PPH, Reddit.
NOT to the user's own email — to ACTUAL CLIENTS on each platform.

Usage:
  platform-submit --run                # Submit all today's unsent proposals
  platform-submit --platform upwork    # Submit only Upwork proposals
  platform-submit --platform linkedin  # Submit only LinkedIn proposals
  platform-submit --platform freelancer
  platform-submit --platform reddit
  platform-submit --dry-run            # Show what would be submitted, no action
  platform-submit --status             # Show today's submission status
"""
import os, sys, json, time, datetime, traceback
from pathlib import Path

HOME       = Path.home()
AGENCY     = HOME / ".claude/agency"
BIN        = HOME / ".claude/bin/agency"
PROFILE    = HOME / ".claude/agency/browser-profile"
LOG_FILE   = AGENCY / "logs/platform-submit.log"
TODAY      = datetime.date.today().strftime("%Y%m%d")
PROP_FILE  = AGENCY / f"proposals/proposals_{TODAY}.json"
SUB_FILE   = AGENCY / "data/platform_submissions.json"

PROFILE.mkdir(parents=True, exist_ok=True)
LOG_FILE.parent.mkdir(parents=True, exist_ok=True)

def log(msg):
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    with open(LOG_FILE, "a") as f:
        f.write(line + "\n")

def get_browser():
    from playwright.sync_api import sync_playwright
    p = sync_playwright().start()
    ctx = p.chromium.launch_persistent_context(
        user_data_dir=str(PROFILE),
        headless=False,
        viewport={"width": 1366, "height": 768},
        args=[
            "--disable-blink-features=AutomationControlled",
            "--profile-directory=Profile 1",
            "--disable-infobars",
            "--no-sandbox",
        ],
        ignore_default_args=["--enable-automation"],
    )
    # Apply playwright-stealth to bypass Cloudflare bot detection
    try:
        from playwright_stealth import stealth_sync
        for page in ctx.pages:
            stealth_sync(page)
        # Hook new pages
        ctx.on("page", lambda p: stealth_sync(p))
    except ImportError:
        # Fallback: manual stealth patches
        ctx.add_init_script("""
            Object.defineProperty(navigator, 'webdriver', {get: () => undefined});
            Object.defineProperty(navigator, 'plugins', {get: () => [1, 2, 3, 4, 5]});
            Object.defineProperty(navigator, 'languages', {get: () => ['en-US', 'en']});
            window.chrome = { runtime: {} };
        """)
    return p, ctx

def load_proposals():
    if not PROP_FILE.exists():
        log(f"✗ No proposals file: {PROP_FILE}")
        return []
    data = json.loads(PROP_FILE.read_text())
    return data.get("proposals", [])

def save_proposals(proposals):
    data = json.loads(PROP_FILE.read_text())
    data["proposals"] = proposals
    PROP_FILE.write_text(json.dumps(data, indent=2))

def load_submissions():
    if SUB_FILE.exists():
        try:
            return json.loads(SUB_FILE.read_text())
        except Exception:
            pass
    return {}

def save_submissions(subs):
    SUB_FILE.write_text(json.dumps(subs, indent=2))

def mark_submitted(proposals, job_id, subs):
    subs[job_id] = {
        "submitted_at": datetime.datetime.now().isoformat(),
        "date": TODAY
    }
    for p in proposals:
        if p.get("job_id") == job_id:
            p["status"] = "submitted"
            p["submitted_at"] = datetime.datetime.now().isoformat()
    return proposals, subs


# ─── UPWORK ─────────────────────────────────────────────────────────────────

def submit_upwork(page, job):
    """Navigate to Upwork job URL and submit proposal."""
    url  = job.get("job_url", job.get("url", ""))
    text = job.get("proposal_text", "")
    title = job.get("job_title", "")[:60]

    if not url or "upwork.com" not in url:
        log(f"  ✗ Upwork: invalid URL for '{title}'")
        return False

    log(f"  → Upwork: {title}")
    try:
        # Warm up Upwork session — navigate home first to pass Cloudflare
        page.goto("https://www.upwork.com/", timeout=30000, wait_until="domcontentloaded")
        time.sleep(3)
        # Resolve CF challenge on home if needed
        for _ in range(4):
            title_check = page.evaluate("() => document.title") if page.url == "https://www.upwork.com/" else ""
            if "just a moment" in title_check.lower():
                time.sleep(5)
            else:
                break

        page.goto(url, timeout=30000, wait_until="domcontentloaded")
        time.sleep(3)

        cur = page.url
        if "login" in cur or "account-security" in cur:
            log("  ✗ Upwork: not logged in. Need to login with hmzainjamilpaypal@gmail.com")
            return False

        # Check for Cloudflare challenge
        try:
            cf_check = page.evaluate("() => document.title + '|' + document.body.innerText.substring(0, 80)")
            log(f"  Page: {cf_check[:70]}")
            if "just a moment" in cf_check.lower() or "cloudflare" in cf_check.lower():
                log(f"  CF challenge — waiting 20s for auto-resolve...")
                time.sleep(20)
                page.wait_for_selector('h1', timeout=20000)
        except Exception:
            pass

        # Wait for React hydration — Upwork is a SPA
        for sel in ['h1', '[data-test="job-title"]', 'main', '[class*="job"]']:
            try:
                page.wait_for_selector(sel, timeout=8000)
                break
            except Exception:
                pass
        time.sleep(2)

        # Find Apply button — extended selectors for 2025/2026 Upwork UI
        applied = False
        apply_selectors = [
            'button:has-text("Apply Now")',
            'a:has-text("Apply Now")',
            'button:has-text("Submit a Proposal")',
            'button:has-text("Submit Proposal")',
            'button:has-text("Apply")',
            '[data-test="apply-button"]',
            '[data-test="apply-now-button"]',
            'button[aria-label*="Apply"]',
            '[class*="apply-btn"]',
            '[class*="ApplyButton"]',
            'a[href*="/proposal"]',
        ]
        for sel in apply_selectors:
            try:
                btn = page.locator(sel).first
                if btn.is_visible(timeout=2000):
                    btn.scroll_into_view_if_needed()
                    btn.click()
                    applied = True
                    time.sleep(3)
                    log(f"  ✓ Upwork: Apply button clicked via '{sel}'")
                    break
            except Exception:
                pass

        if not applied:
            # JS fallback: find any Apply-like button on the page
            try:
                result = page.evaluate("""() => {
                    const buttons = [...document.querySelectorAll('button, a[href]')];
                    for (const b of buttons) {
                        const txt = (b.textContent || b.innerText || '').trim().toLowerCase();
                        const href = (b.getAttribute('href') || '').toLowerCase();
                        if (txt.includes('apply') || txt.includes('submit proposal') || href.includes('proposal')) {
                            b.click();
                            return txt.substring(0, 30);
                        }
                    }
                    // Debug: return page buttons
                    return 'btns:' + buttons.slice(0,8).map(b=>(b.textContent||'').trim().substring(0,20)).join('|');
                }""")
                if result and not result.startswith('btns:'):
                    applied = True
                    time.sleep(3)
                    log(f"  ✓ Upwork: Apply via JS click ('{result}')")
                else:
                    log(f"  ✗ Upwork: no Apply button — page buttons: {result}")
            except Exception as e:
                log(f"  ✗ Upwork: JS fallback error: {e}")

        if not applied:
            log(f"  ✗ Upwork: no Apply button found at {url[:60]}")
            return False

        # Fill cover letter
        cl_selectors = [
            'textarea[data-test="cover-letter-text"]',
            'textarea[placeholder*="cover letter" i]',
            'textarea[placeholder*="proposal" i]',
            'div[data-test="cover-letter"] textarea',
            'textarea[name*="cover"]',
            'textarea',
        ]
        filled = False
        for sel in cl_selectors:
            try:
                box = page.locator(sel).first
                if box.is_visible(timeout=3000):
                    box.click()
                    box.fill(text[:4000])
                    filled = True
                    log(f"  ✓ Upwork: cover letter filled ({len(text)} chars)")
                    break
            except Exception:
                pass

        if not filled:
            log("  ✗ Upwork: cover letter textarea not found")
            return False

        time.sleep(1)

        # Fill bid amount if present
        bid = job.get("bid_amount", "")
        if bid:
            bid_num = bid.replace("$", "").replace("/hr", "").replace(",", "").strip()
            for sel in [
                'input[data-test="rate-input"]',
                'input[placeholder*="bid" i]',
                'input[name*="bid" i]',
                'input[name*="rate" i]',
                'input[type="number"]',
            ]:
                try:
                    inp = page.locator(sel).first
                    if inp.is_visible(timeout=2000):
                        inp.triple_click()
                        inp.fill(bid_num)
                        log(f"  ✓ Upwork: bid amount set to {bid}")
                        break
                except Exception:
                    pass

        # Scroll and submit
        page.evaluate("window.scrollTo(0, document.body.scrollHeight)")
        time.sleep(1)

        # Click Submit / Continue
        for sel in [
            'button:has-text("Submit Proposal")',
            'button:has-text("Submit")',
            'button[data-test="submit-proposal"]',
            'button[data-test="submit-btn"]',
            'button[type="submit"]',
        ]:
            try:
                btn = page.locator(sel).first
                if btn.is_visible(timeout=3000):
                    btn.scroll_into_view_if_needed()
                    btn.click()
                    time.sleep(4)
                    log(f"  ✓ Upwork: SUBMITTED — {title}")
                    return True
            except Exception:
                pass

        # JS click fallback
        try:
            result = page.evaluate("""() => {
                const btns = [...document.querySelectorAll('button')];
                for (const b of btns) {
                    const txt = (b.textContent || '').toLowerCase().trim();
                    if (!b.disabled && (txt.includes('submit') || txt.includes('continue') || txt.includes('next'))) {
                        b.click(); return txt.substring(0,30);
                    }
                }
                return null;
            }""")
            if result:
                time.sleep(4)
                log(f"  ✓ Upwork: SUBMITTED (JS '{result}') — {title}")
                return True
        except Exception:
            pass

        log(f"  ⚠ Upwork: filled but submit button not found — check browser")
        return False

    except Exception as e:
        log(f"  ✗ Upwork error: {e}")
        return False


