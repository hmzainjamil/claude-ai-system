"""
Indeed MCP Bridge — BDM Integration
Uses Claude Code's connected Indeed MCP connector (real-time API).
Called by discover-jobs as primary Indeed source.

HMZ profile: Meta Ads + Google Ads specialist, Lahore, Pakistan
Target: remote-only, English-speaking countries + PK
"""

import os, sys, json, subprocess, datetime, re
from pathlib import Path

HOME       = Path.home()
DATA_DIR   = HOME / ".claude/agency/data"
TODAY      = datetime.date.today().strftime("%Y%m%d")
