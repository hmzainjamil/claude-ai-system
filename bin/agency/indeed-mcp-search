BLACKLIST_COUNTRIES = {"IN", "BD", "PH", "IL"}  # geo blacklist from memory

def is_skill_match(title: str, description: str = "") -> bool:
    text = (title + " " + description).lower()
    return any(kw in text for kw in SKILL_KEYWORDS)

