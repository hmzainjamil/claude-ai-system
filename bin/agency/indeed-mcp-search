    # (search_query, country_code, job_type)
    ("Google Ads Meta Ads PPC specialist remote",               "US", "contract"),
    ("paid media performance marketing Google Ads remote",      "US", None),
    ("Meta Ads Facebook Ads media buyer remote",                "US", None),
    ("Google Ads manager remote digital marketing",             "US", "fulltime"),
    ("PPC specialist paid advertising remote",                  "CA", None),
    ("Meta Ads Google Ads specialist remote",                   "CA", None),
    ("paid media manager performance marketing remote",         "GB", None),
    ("Google Ads PPC specialist remote freelance",              "AU", None),
    ("digital marketing manager Google Ads remote",             "AE", None),
    ("Google Ads Meta Ads specialist remote Pakistan",          "PK", None),
    ("performance marketing media buyer remote worldwide",      "US", None),
    ("Facebook Ads Google Ads consultant remote contract",      "US", "contract"),
]

SKILL_KEYWORDS = [
    "google ads", "meta ads", "facebook ads", "ppc", "paid media",
