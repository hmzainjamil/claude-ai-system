    },
}

def validate_json(path):
    """Return parsed JSON or None if corrupt."""
    try:
        return json.loads(path.read_text())
    except Exception:
        return None

def check_state_files():
    log("=== 3. JSON STATE FILES ===", "HEAD")
    for path, default in STATE_SCHEMAS.items():
        if not path.exists():
            if not CHECK_ONLY:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(json.dumps(default, indent=2))
                fixed(f"Created missing state file: {path.name}")
            else:
                warn(f"Missing state file: {path.name}")
            continue

        data = validate_json(path)
        if data is None:
            if not CHECK_ONLY:
                # Backup corrupt file
                backup = path.with_suffix(f".corrupt_{TODAY}.json")
                shutil.copy(path, backup)
                path.write_text(json.dumps(default, indent=2))
                fixed(f"Reset corrupt JSON: {path.name} (backed up to {backup.name})")
            else:
                issue(f"Corrupt JSON: {path.name}")
        else:
            log(f"OK: {path.name}")

    # Check pipeline lock — if stuck (pid dead), release it
    lock_path = AGENCY / "data/pipeline_lock.json"
    if lock_path.exists():
        lock = validate_json(lock_path)
        if lock and lock.get("locked"):
            pid = lock.get("pid", 0)
            try:
                os.kill(pid, 0)  # check if PID alive
                warn(f"Pipeline locked by PID {pid} (still running)")
            except (ProcessLookupError, PermissionError):
                if not CHECK_ONLY:
                    lock_path.write_text(json.dumps(
                        {"locked": False, "locked_at": "", "phase": "released_by_self_heal",
                         "pid": 0, "released_at": NOW_ISO}, indent=2))
                    fixed(f"Released stale pipeline lock (PID {pid} is dead)")
                else:
                    issue(f"Stale pipeline lock (PID {pid} dead)")


# ── 4. EMAIL QUEUES ───────────────────────────────────────────────────────────
QUEUE_FILES = [
    AGENCY / "data/email_queue.jsonl",
    AGENCY / "data/email_pipeline_pending.jsonl",
]
MAX_QUEUE_AGE_DAYS = 7

def check_queues():
    log("=== 4. EMAIL QUEUES ===", "HEAD")
    cutoff = datetime.datetime.now() - datetime.timedelta(days=MAX_QUEUE_AGE_DAYS)

    for qf in QUEUE_FILES:
        if not qf.exists():
            log(f"OK (empty): {qf.name}")
            continue

        lines = [l for l in qf.read_text().strip().split("\n") if l.strip()]
        if not lines:
            log(f"OK (empty): {qf.name}")
            continue

        valid, purged, malformed = [], 0, 0
        for line in lines:
            try:
                entry = json.loads(line)
                # Purge stale entries
                queued_at = entry.get("queued_at") or entry.get("created_at") or ""
                if queued_at:
                    try:
                        qt = datetime.datetime.fromisoformat(queued_at.replace("Z", ""))
                        if qt < cutoff:
                            purged += 1
                            continue
                    except Exception:
                        pass
                valid.append(line)
            except json.JSONDecodeError:
                malformed += 1

        if (purged or malformed) and not CHECK_ONLY:
            qf.write_text("\n".join(valid) + ("\n" if valid else ""))
            fixed(f"Queue {qf.name}: purged {purged} stale + {malformed} malformed entries; {len(valid)} remain")
        elif purged or malformed:
            warn(f"Queue {qf.name}: {purged} stale + {malformed} malformed entries need purge")
        else:
            log(f"OK ({len(valid)} entries): {qf.name}")


# ── 5. DEDUP DATABASE INTEGRITY ───────────────────────────────────────────────
def check_dedup():
    log("=== 5. DEDUP DATABASE ===", "HEAD")

    for fname in ["submitted_jobs.json", "email_sequences.json"]:
        fpath = AGENCY / f"data/{fname}"
        if not fpath.exists():
            log(f"Dedup DB not found (will be created on first run): {fname}")
            continue

        data = validate_json(fpath)
        if data is None:
            if not CHECK_ONLY:
                backup = fpath.with_suffix(f".corrupt_{TODAY}.json")
                shutil.copy(fpath, backup)
                reset = {"version": 1, "jobs": {}, "total": 0,
                         "last_updated": NOW_ISO} if "jobs" in fname else \
                        {"version": 1, "sequences": {}, "total": 0, "last_updated": NOW_ISO}
                fpath.write_text(json.dumps(reset, indent=2))
                fixed(f"Rebuilt corrupt dedup DB: {fname}")
            else:
                issue(f"Corrupt dedup DB: {fname}")
            continue

        # Validate structure integrity
        if fname == "submitted_jobs.json":
            jobs = data.get("jobs", {})
            corrupt_keys = []
            for url_hash, entry in jobs.items():
                if not isinstance(entry, dict) or "url" not in entry:
                    corrupt_keys.append(url_hash)
            if corrupt_keys and not CHECK_ONLY:
                for k in corrupt_keys:
                    del jobs[k]
                data["jobs"] = jobs
                data["total"] = len(jobs)
                fpath.write_text(json.dumps(data, indent=2))
                fixed(f"Removed {len(corrupt_keys)} corrupt dedup entries from {fname}")
            elif corrupt_keys:
                warn(f"{len(corrupt_keys)} corrupt entries in {fname}")
            else:
                log(f"OK ({len(jobs)} dedup records): {fname}")

        elif fname == "email_sequences.json":
            seqs = data.get("sequences", {})
            log(f"OK ({len(seqs)} email sequences tracked): {fname}")


# ── 6. LOG FILE ROTATION ──────────────────────────────────────────────────────
MAX_LOG_SIZE_MB = 10

def check_logs():
    log("=== 6. LOG FILE ROTATION ===", "HEAD")
    log_dir = AGENCY / "logs"
    if not log_dir.exists():
        return

    for lf in log_dir.glob("*.log"):
        size_mb = lf.stat().st_size / (1024*1024)
        if size_mb > MAX_LOG_SIZE_MB:
            if not CHECK_ONLY:
                # Keep last 1000 lines
                lines = lf.read_text().split("\n")
                archived = lf.with_suffix(f".{TODAY}.log.bak")
                shutil.copy(lf, archived)
                lf.write_text("\n".join(lines[-1000:]))
                fixed(f"Rotated {lf.name} ({size_mb:.1f}MB → kept 1000 lines, archived to {archived.name})")
            else:
                warn(f"Log {lf.name} is {size_mb:.1f}MB (needs rotation)")
        else:
            log(f"OK ({size_mb:.2f}MB): {lf.name}")


