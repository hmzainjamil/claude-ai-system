#!/usr/bin/env python3
"""
SELF-HEAL ENGINE v1.0 — BDM + Email Marketing Architecture
Auto-detects and fixes every known failure mode without user involvement.

WHAT IT FIXES AUTOMATICALLY:
  ✓ Missing directories (creates them)
  ✓ Corrupted JSON state files (resets to valid empty structure)
  ✓ Stale/malformed email queues (purges entries older than 7 days)
  ✓ Broken dedup database (rebuilds from submissions history)
  ✓ Script syntax errors (reports and patches shebangs/permissions)
  ✓ Missing tier0.env keys (documents exactly what's broken)
  ✓ Stuck/partial pipeline runs (resets pipeline lock)
  ✓ Oversized log files (rotates logs > 10MB)
  ✓ Old filtered jobs files (auto-archives > 3 days)
  ✓ Orphaned email_queue entries without matching leads (purges)
  ✓ Gmail SMTP capability check (honest status — no false "sent" claims)
  ✓ LLM endpoint validation (Groq → GLM → Ollama fallback chain)
  ✓ OpenClaw gateway health (LaunchAgent running check)
  ✓ Agent37 session config validity

WHAT IT REPORTS (cannot auto-fix — needs user action):
  ✗ Missing GMAIL_APP_PASSWORD → emails cannot send
  ✗ Missing APIFY_API_TOKEN → job discovery disabled
  ✗ Missing GROQ_API_KEY + no Ollama → proposal generation disabled
  ✗ Agent37 gateway URL not configured → auto-submit disabled
  ✗ Reddit credentials missing → social engagement disabled

Usage:
  self-heal              # Full audit + fix, print report
  self-heal --json       # Output structured JSON (for health-check)
  self-heal --check-only # Audit only, no fixes
  self-heal --scripts    # Syntax-check all scripts only
  self-heal --queues     # Fix queues only
  self-heal --state      # Fix state files only
"""

import os, sys, json, datetime, subprocess, ast, stat, smtplib, re, shutil
import hashlib, traceback
from pathlib import Path

HOME       = Path.home()
AGENCY     = HOME / ".claude/agency"
BIN        = HOME / ".claude/bin/agency"
ENV_FILE   = HOME / ".claude/tier0.env"
TODAY      = datetime.date.today().strftime("%Y%m%d")
NOW_ISO    = datetime.datetime.now().isoformat()
CHECK_ONLY = "--check-only" in sys.argv
JSON_MODE  = "--json" in sys.argv

# ── HEAL LOG ─────────────────────────────────────────────────────────────────
HEAL_LOG = []
FIXES_APPLIED = []
ISSUES_UNFIXABLE = []
WARNINGS = []

def log(msg, level="INFO"):
    ts = datetime.datetime.now().strftime("%H:%M:%S")
    line = f"[{ts}][{level}] {msg}"
    HEAL_LOG.append(line)
    if not JSON_MODE:
        prefix = {"INFO": "  ", "FIX": "  ✓ FIX: ", "WARN": "  ⚠ ", "ERROR": "  ✗ ", "HEAD": ""}
        print(prefix.get(level, "  ") + msg)

def fixed(desc):
    FIXES_APPLIED.append(desc)
    log(desc, "FIX")

def issue(desc):
    ISSUES_UNFIXABLE.append(desc)
    log(desc, "ERROR")

def warn(desc):
    WARNINGS.append(desc)
    log(desc, "WARN")


