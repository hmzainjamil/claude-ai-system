REQUIRED_KEYS = {
    "GROQ_API_KEY":       "LLM proposal generation (Plan A)",
    "GLM_API_KEY":        "LLM proposal generation (Plan B)",
    "APIFY_API_TOKEN":    "Job discovery scraping",
    "GMAIL_APP_PASSWORD": "EMAIL DELIVERY — without this, ZERO emails send",
    "OPENROUTER_API_KEY": "OpenRouter LLM fallback",
}

OPTIONAL_KEYS = {
    "REDDIT_CLIENT_ID":     "Reddit social engagement",
    "REDDIT_CLIENT_SECRET": "Reddit social engagement",
    "REDDIT_USERNAME":      "Reddit social engagement",
    "REDDIT_PASSWORD":      "Reddit social engagement",
    "G0DM0D3_KEY":          "G0DM0D3 local LLM (port 7860)",
}

def load_env():
    """Load tier0.env into dict — handles 'export KEY=val' prefix."""
    env = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().split("\n"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                # Strip 'export ' prefix if present
                if line.startswith("export "):
                    line = line[7:]
                k, _, v = line.partition("=")
                env[k.strip()] = v.strip().strip('"').strip("'")
    return env

def check_api_keys():
    log("=== 7. API KEYS & GMAIL SMTP ===", "HEAD")
    env = load_env()
    # Merge with os.environ
    merged = {**env, **os.environ}

    critical_missing = []
    for key, purpose in REQUIRED_KEYS.items():
        val = merged.get(key, "")
        if not val:
            issue(f"MISSING: {key} → {purpose}")
            critical_missing.append(key)
        else:
            masked = val[:4] + "***" + val[-3:] if len(val) > 8 else "***"
            log(f"OK: {key} = {masked}")

    for key, purpose in OPTIONAL_KEYS.items():
        val = merged.get(key, "")
        if not val:
            warn(f"Optional missing: {key} → {purpose}")
        else:
            masked = val[:4] + "***" if len(val) > 8 else "***"
            log(f"OK (optional): {key} = {masked}")

    # GMAIL SMTP truth check
    log("--- Gmail SMTP Capability ---", "HEAD")
    gmail_pwd = merged.get("GMAIL_APP_PASSWORD", "")
    gmail_user = merged.get("GMAIL_USER", "zulqarnain@digiminds.org")

    if not gmail_pwd:
        issue("GMAIL_APP_PASSWORD not set → emails CANNOT send via SMTP")
        issue("FIX: myaccount.google.com/apppasswords → create 'Agency SMTP'")
        issue("     Then add to ~/.claude/tier0.env: GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx")
        issue("     Gmail must have 2FA enabled for app passwords to work")
    else:
        # Try actual SMTP connection
        try:
            with smtplib.SMTP_SSL("smtp.gmail.com", 465) as smtp:
                smtp.login(gmail_user, gmail_pwd)
            log("GMAIL SMTP: CONNECTED — emails will actually send")
        except smtplib.SMTPAuthenticationError:
            issue(f"GMAIL SMTP: AUTH FAILED for {gmail_user} — app password rejected")
            issue("  Check: 2FA enabled? App password correct? Account not locked?")
        except Exception as e:
            warn(f"GMAIL SMTP: Connection test failed — {e}")

    return "GMAIL_APP_PASSWORD" not in critical_missing


# ── 8. LLM ENDPOINT VALIDATION ───────────────────────────────────────────────
def check_llms():
    log("=== 8. LLM ENDPOINTS ===", "HEAD")
    import urllib.request, urllib.error

    llm_status = {}
    env = {**load_env(), **os.environ}

    # Groq
    groq_key = env.get("GROQ_API_KEY", "")
    if groq_key:
        try:
            req = urllib.request.Request(
                "https://api.groq.com/openai/v1/models",
                headers={"Authorization": f"Bearer {groq_key}"}
            )
            urllib.request.urlopen(req, timeout=8)
            log("OK: Groq API reachable")
            llm_status["groq"] = True
        except Exception as e:
            warn(f"Groq API error: {e}")
            llm_status["groq"] = False
    else:
        llm_status["groq"] = False
        log("SKIP: Groq (no key)")

    # Ollama
    try:
        req = urllib.request.Request("http://localhost:11434/api/tags")
        urllib.request.urlopen(req, timeout=5)
        log("OK: Ollama running (local)")
        llm_status["ollama"] = True
    except Exception as e:
        warn(f"Ollama not running: {e}")
        llm_status["ollama"] = False

    # G0DM0D3
    try:
        req = urllib.request.Request("http://localhost:7860/v1/models")
        urllib.request.urlopen(req, timeout=5)
        log("OK: G0DM0D3 running (port 7860)")
        llm_status["g0dm0d3"] = True
    except Exception:
        log("G0DM0D3 not running on :7860 (not critical)")
        llm_status["g0dm0d3"] = False

    # GLM
    glm_key = env.get("GLM_API_KEY", "")
    if glm_key:
        try:
            req = urllib.request.Request(
                "https://open.bigmodel.cn/api/paas/v4/models",
                headers={"Authorization": f"Bearer {glm_key}"}
            )
            urllib.request.urlopen(req, timeout=8)
            log("OK: GLM API reachable")
            llm_status["glm"] = True
        except Exception as e:
            warn(f"GLM API error: {e}")
            llm_status["glm"] = False
    else:
        llm_status["glm"] = False

    # At least one LLM must work
    if not any(llm_status.values()):
        issue("CRITICAL: All LLMs offline — no proposals can be generated")
        issue("  Start Ollama: ollama serve")
        issue("  Or add GROQ_API_KEY to ~/.claude/tier0.env")
    elif not llm_status.get("groq") and not llm_status.get("glm"):
        warn("Only Ollama available — proposals will use local model (slower)")

    return llm_status


# ── 9. OPENCLAW GATEWAY ───────────────────────────────────────────────────────
def check_browser_bot():
    """Check if Playwright + browser-profile is set up."""
    log("=== 8.5. BROWSER-BOT (Playwright) ===", "HEAD")
    profile = AGENCY / "browser-profile"
    bot = BIN / "browser-bot"

    if not bot.exists():
        warn("browser-bot script not found")
        return False

    # Check if Playwright Chromium installed
    cache = HOME / "Library/Caches/ms-playwright"
    if not cache.exists():
        warn("Playwright Chromium not installed — run: python3 -m playwright install chromium")
        return False
    log("OK: Playwright Chromium installed")

    if not profile.exists() or not (profile / "Default").exists():
        warn("Browser profile NOT set up — run: browser-bot --setup (one-time, ~2 min)")
        warn("  Until then: emails won't auto-send and auto-submit is disabled")
        return False
    log(f"OK: Browser profile exists ({profile})")
    return True

def check_openclaw():
    log("=== 9. OPENCLAW GATEWAY ===", "HEAD")
    import urllib.request

    # Check LaunchAgent plist
    plist = Path.home() / "Library/LaunchAgents/ai.openclaw.gateway.plist"
    if not plist.exists():
        warn("OpenClaw LaunchAgent not installed — auto-submit disabled")
        return False

    log(f"OK: LaunchAgent plist exists")

    # Check WebSocket gateway
    try:
        import urllib.request
        # Gateway doesn't speak HTTP but let's check if port is open
        import socket
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(3)
        result = s.connect_ex(('127.0.0.1', 18789))
        s.close()
        if result == 0:
            log("OK: OpenClaw gateway port 18789 open")
            return True
        else:
            warn("OpenClaw gateway not running on :18789 — auto-submit disabled")
            warn("  Start it: launchctl load ~/Library/LaunchAgents/ai.openclaw.gateway.plist")
            return False
    except Exception as e:
        warn(f"OpenClaw gateway check failed: {e}")
        return False


# ── 10. ARCHIVE OLD FILES ─────────────────────────────────────────────────────
def archive_old_files():
    log("=== 10. ARCHIVE OLD DATA FILES ===", "HEAD")
    if CHECK_ONLY:
        return

    archive = AGENCY / "archive"
    archive.mkdir(exist_ok=True)
    cutoff = datetime.date.today() - datetime.timedelta(days=5)

    for pattern in ["jobs_*.json", "jobs_filtered_*.json", "proposals_*.json"]:
        parent = AGENCY / "data" if "jobs" in pattern else AGENCY / "proposals"
        for f in parent.glob(pattern):
            # Extract date from filename
            m = re.search(r"(\d{8})", f.name)
            if m:
                try:
                    fdate = datetime.date(int(m.group()[:4]), int(m.group()[4:6]), int(m.group()[6:]))
                    if fdate < cutoff:
                        dest = archive / f.name
                        if not dest.exists():
                            shutil.move(str(f), str(dest))
                            fixed(f"Archived old file: {f.name}")
                except Exception:
                    pass


# ── 11. PARTIAL RUN DETECTION ─────────────────────────────────────────────────
def check_partial_run():
    log("=== 11. PARTIAL RUN DETECTION ===", "HEAD")
    yesterday = (datetime.date.today() - datetime.timedelta(1)).strftime("%Y%m%d")

    jobs_y   = AGENCY / f"data/jobs_{yesterday}.json"
    props_y  = AGENCY / f"proposals/proposals_{yesterday}.json"
    report_y = AGENCY / f"reports/report_{yesterday}.json"

    if not jobs_y.exists() and not props_y.exists():
        warn(f"No run detected for {yesterday} — either first day or system was down")
        return

    if jobs_y.exists() and not props_y.exists():
        issue(f"PARTIAL RUN {yesterday}: jobs discovered but no proposals generated")
        issue("  Re-run: agency-run --proposals")

    if props_y.exists() and not report_y.exists():
        warn(f"PARTIAL RUN {yesterday}: proposals generated but no report (non-critical)")

    if props_y.exists():
        data = validate_json(props_y)
        if data:
            total = data.get("total_proposals", 0)
            submitted = len([p for p in data.get("proposals", []) if p.get("status") == "submitted"])
            log(f"Yesterday: {total} proposals, {submitted} submitted")
            if total > 0 and submitted == 0:
                warn(f"Yesterday: {total} proposals but 0 submitted — check auto-submit")


# ── MAIN ──────────────────────────────────────────────────────────────────────
def main():
    mode = "CHECK ONLY" if CHECK_ONLY else "FULL HEAL"

    if not JSON_MODE:
        print(f"\n{'='*60}")
        print(f"  AGENCY SELF-HEAL ENGINE v1.0 — {mode}")
        print(f"  {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        print(f"{'='*60}\n")

    # Dispatch to specific checks if flags given
    args = sys.argv[1:]
    if "--scripts" in args:
        check_scripts(); goto_report()
    if "--queues" in args:
        check_queues(); goto_report()
    if "--state" in args:
        check_state_files(); goto_report()

    # Full audit
    check_dirs()
    broken_scripts = check_scripts()
    check_state_files()
    check_queues()
    check_dedup()
    check_logs()
    has_gmail = check_api_keys()
    llm_status = check_llms()
    browser_bot_ok = check_browser_bot()
    openclaw_ok = check_openclaw()
    if not CHECK_ONLY:
        archive_old_files()
    check_partial_run()

    # ── VERDICT ──────────────────────────────────────────────────────────────
    critical_broken = [
        not any(llm_status.values()),  # all LLMs down
        len(broken_scripts) > 0,       # syntax errors
    ]
    health = "RED" if any(critical_broken) else ("YELLOW" if ISSUES_UNFIXABLE else "GREEN")

    if not JSON_MODE:
        print(f"\n{'='*60}")
        print(f"  SELF-HEAL REPORT")
        print(f"{'='*60}")
        print(f"  Fixes applied:         {len(FIXES_APPLIED)}")
        print(f"  Issues auto-fixed:     {len(FIXES_APPLIED)}")
        print(f"  Issues need attention: {len(ISSUES_UNFIXABLE)}")
        print(f"  Warnings:              {len(WARNINGS)}")
        print(f"  Overall health:        {health}")

        if FIXES_APPLIED:
            print(f"\n  AUTO-FIXED:")
            for f in FIXES_APPLIED:
                print(f"    ✓ {f}")

        if ISSUES_UNFIXABLE:
            print(f"\n  NEEDS YOUR ACTION:")
            for i in ISSUES_UNFIXABLE:
                print(f"    ✗ {i}")

        if WARNINGS:
            print(f"\n  WARNINGS:")
            for w in WARNINGS:
                print(f"    ⚠ {w}")

        # LLM Summary
        print(f"\n  LLM STATUS:")
        for name, ok in llm_status.items():
            print(f"    {'✓' if ok else '✗'} {name}")

        # Email truth
        print(f"\n  EMAIL DELIVERY:")
        env = {**load_env(), **os.environ}
        if env.get("GMAIL_APP_PASSWORD"):
            print(f"    ✓ GMAIL_APP_PASSWORD set — SMTP can send")
        else:
            print(f"    ✗ GMAIL_APP_PASSWORD missing — ZERO emails will send")
            print(f"    → myaccount.google.com/apppasswords → add to ~/.claude/tier0.env")

        print(f"\n  OPENCLAW: {'✓ Gateway running' if openclaw_ok else '✗ Gateway offline'}")
        print(f"{'='*60}\n")

    # Write heal log
    heal_log_dir = AGENCY / "health"
    heal_log_dir.mkdir(exist_ok=True)
    heal_log_file = heal_log_dir / f"heal_{TODAY}.log"
    heal_log_file.write_text("\n".join(HEAL_LOG))

    # Write structured report
    report = {
        "timestamp": NOW_ISO,
        "mode": mode,
        "health": health,
        "fixes_applied": len(FIXES_APPLIED),
        "fixes": FIXES_APPLIED,
        "issues": ISSUES_UNFIXABLE,
        "warnings": WARNINGS,
        "llm_status": llm_status,
        "openclaw": openclaw_ok,
        "broken_scripts": [s[0] for s in broken_scripts],
        "can_proceed": health != "RED",
    }
    report_file = heal_log_dir / f"heal_{TODAY}.json"
    report_file.write_text(json.dumps(report, indent=2))

    if JSON_MODE:
        print(json.dumps({
            "health": health,
            "can_proceed": health != "RED",
            "fixes": len(FIXES_APPLIED),
            "issues": len(ISSUES_UNFIXABLE),
            "warnings": len(WARNINGS),
            "llm_ok": any(llm_status.values()),
            "gmail_smtp": bool({**load_env(), **os.environ}.get("GMAIL_APP_PASSWORD")),
        }))

    sys.exit(0 if health != "RED" else 1)


