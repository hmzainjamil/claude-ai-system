# ── 2. SCRIPT SYNTAX + PERMISSIONS ───────────────────────────────────────────
AGENCY_SCRIPTS = [
    "agency-run", "pre-research", "discover-jobs", "quality-filter",
    "generate-proposals", "generate-audit", "email-pipeline", "send-emails",
    "agent-workers", "auto-submit", "daily-report", "verify-report",
    "crm-dashboard", "social-engage", "health-check", "self-heal",
    "dedup", "gmail-truth", "limit-tracker",
]

def check_scripts():
    log("=== 2. SCRIPT SYNTAX & PERMISSIONS ===", "HEAD")
    broken = []
    for name in AGENCY_SCRIPTS:
        # agency-run is in parent bin dir
        script = (HOME / ".claude/bin" / name) if name == "agency-run" else (BIN / name)
        if not script.exists():
            warn(f"Script not found: {name} (may not be built yet)")
            continue

        src = script.read_text(errors="replace")

        # Check shebang
        if not src.startswith("#!/usr/bin/env python3"):
            if not CHECK_ONLY:
                # Inject shebang
                new_src = "#!/usr/bin/env python3\n" + src.lstrip("#!\n")
                script.write_text(new_src)
                fixed(f"Added shebang to: {name}")
            else:
                warn(f"Missing shebang: {name}")

        # Check executable
        mode = os.stat(script).st_mode
        if not (mode & stat.S_IXUSR):
            if not CHECK_ONLY:
                os.chmod(script, mode | stat.S_IXUSR | stat.S_IXGRP)
                fixed(f"Set executable: {name}")
            else:
                warn(f"Not executable: {name}")

        # Syntax check (Python only)
        try:
            ast.parse(src)
            log(f"OK syntax: {name}")
        except SyntaxError as e:
            broken.append((name, str(e)))
            issue(f"SYNTAX ERROR in {name}: {e}")

    return broken


