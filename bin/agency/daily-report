          <div style="background:#f9fafb;padding:12px 16px;border-bottom:1px solid #e5e7eb">
            <div style="display:flex;align-items:center;flex-wrap:wrap;gap:4px">
              <span style="background:#dbeafe;color:#1e40af;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600">{platform}</span>
              {ht_badge}
              <a href="{url}" style="font-size:14px;font-weight:600;color:#111827;text-decoration:none;margin-left:4px">{p['job_title']}</a>
            </div>
            <div style="display:flex;gap:16px;margin-top:6px;flex-wrap:wrap">
              <span style="font-size:12px;color:#6b7280">Budget: <b>{budget}</b></span>
