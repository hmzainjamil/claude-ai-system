#!/usr/bin/env python3
"""
AGENCY ORCHESTRATOR — Phase 4: Daily Report v3.0
- HTML dashboard (local)
- Email report → queued to email_queue.jsonl for Gmail MCP send
  Recipient: zulqarnain@digiminds.org
  Includes: every proposal, client details, quality scores, submission links
"""
import os, sys, json, datetime
from pathlib import Path

HOME       = Path.home()
AGENCY_DIR = HOME / ".claude/agency"
DATA_DIR   = AGENCY_DIR / "data"
PROP_DIR   = AGENCY_DIR / "proposals"
SUB_DIR    = AGENCY_DIR / "submissions"
REPORT_DIR = AGENCY_DIR / "reports"
LOG_FILE   = AGENCY_DIR / "logs/report.log"
TODAY      = datetime.date.today().strftime("%Y%m%d")
TODAY_NICE = datetime.date.today().strftime("%B %d, %Y")
JOBS_FILE  = DATA_DIR / f"jobs_{TODAY}.json"
PROP_FILE  = PROP_DIR / f"proposals_{TODAY}.json"
EMAIL_QUEUE= DATA_DIR / "email_queue.jsonl"
REPORT_EMAIL = "zulqarnain@digiminds.org"

def log(msg):
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line)
    with open(LOG_FILE,"a") as f: f.write(line+"\n")

def load():
    j = json.loads(JOBS_FILE.read_text()) if JOBS_FILE.exists() else {}
    p = json.loads(PROP_FILE.read_text()) if PROP_FILE.exists() else {}
    return j, p

def build_html_email(jobs_data, prop_data):
    """Full rich HTML email with every proposal expanded."""
    props    = prop_data.get("proposals",[])
    total_d  = jobs_data.get("total_discovered", 0)
    total_q  = jobs_data.get("total_qualified", 0)
