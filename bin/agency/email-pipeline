# ── WARMUP / DAILY BUDGET ─────────────────────────────────────────────────────
def _load_warmup():
    if WARMUP.exists(): return json.loads(WARMUP.read_text())
    w = {"start_date": datetime.date.today().isoformat(), "total_sent":0,
         "sends_today":0, "sends_date": datetime.date.today().isoformat(),
         "bounce_rate":0.0, "reply_rate":0.0, "reputation_score":100,
         "ab_winners": {}}
    WARMUP.parent.mkdir(parents=True, exist_ok=True)
    WARMUP.write_text(json.dumps(w, indent=2))
    return w

def _save_warmup(w):
    WARMUP.write_text(json.dumps(w, indent=2))

def _reset_daily_if_needed(w):
    today = datetime.date.today().isoformat()
    if w.get("sends_date") != today:
        w["sends_today"] = 0
        w["sends_date"]  = today
    return w

def _get_daily_limit():
    w = _load_warmup()
    start = datetime.date.fromisoformat(w["start_date"])
    week  = min(5, (datetime.date.today() - start).days // 7 + 1)
    return WARMUP_RAMP.get(week, 40)

def _check_budget():
    w = _reset_daily_if_needed(_load_warmup())
    limit = _get_daily_limit()
    used  = w.get("sends_today", 0)
    return used < limit, limit - used, w

def _increment_sent(w):
    w["sends_today"]  = w.get("sends_today", 0) + 1
    w["total_sent"]   = w.get("total_sent", 0) + 1
    _save_warmup(w)


