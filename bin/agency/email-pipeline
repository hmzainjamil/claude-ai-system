# ── GMAIL DRAFT SENDING ───────────────────────────────────────────────────────

def _try_smtp(to, subject, html_body, plain_body=""):
    """Attempt send via Gmail SMTP (background-safe). Requires GMAIL_APP_PASSWORD."""
    import smtplib
    from email.mime.multipart import MIMEMultipart
    from email.mime.text import MIMEText

    pw = os.environ.get("GMAIL_APP_PASSWORD","")
    if not pw: return False

    try:
        msg = MIMEMultipart("alternative")
        msg["Subject"]    = subject
        msg["From"]       = f"{FROM_NAME} <{FROM_EMAIL}>"
        msg["To"]         = to
        msg["Reply-To"]   = FROM_EMAIL
        msg["List-Unsubscribe"] = f"<mailto:{FROM_EMAIL}?subject=UNSUBSCRIBE>"
        if plain_body:
            msg.attach(MIMEText(plain_body, "plain"))
        msg.attach(MIMEText(html_body, "html"))

        with smtplib.SMTP_SSL("smtp.gmail.com", 465, timeout=30) as s:
            s.login(FROM_EMAIL, pw)
            s.send_message(msg)
        return True
    except Exception as ex:
        elog(f"SMTP failed: {ex}")
        return False

def _queue_for_mcp(to, subject, html_body, plain_body=""):
    """Fallback: queue for Gmail MCP draft creation on next Claude session."""
    queue_f = AGENCY / "data/email_pipeline_pending.jsonl"
    rec = {
        "to":         to,
        "subject":    subject,
        "html_body":  html_body,
        "plain_body": plain_body,
        "queued_at":  datetime.datetime.now().isoformat(),
    }
    with open(queue_f, "a") as f:
        f.write(json.dumps(rec)+"\n")

def send_email(to, subject, body_or_html, is_html=False, plain_body=""):
    """Try SMTP → fall back to MCP queue. Returns True if sent/queued."""
    if is_html:
        html = body_or_html
        plain = plain_body or re.sub(r'<[^>]+>','', html)[:500]
    else:
        plain = body_or_html
        html  = f"<pre style='font-family:Arial;font-size:14px'>{body_or_html}</pre>"

    if _try_smtp(to, subject, html, plain):
        elog(f"  ✓ SMTP → {to} | {subject[:50]}")
        return True
    else:
        _queue_for_mcp(to, subject, html, plain)
        elog(f"  ✎ Queued MCP → {to} | {subject[:50]}")
        return True


