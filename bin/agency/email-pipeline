def run_cold_sequence(leads):
    """Enter new leads into cold sequence (step 1). Dedup prevents re-entry."""
    can_send, remaining, w = _check_budget()
    if not can_send:
        elog("Daily cold limit reached — skipping")
        return 0

    sent = 0
    for lead in leads:
        if sent >= remaining:
            break
        email = lead.get("email","")
        if not email or "@" not in email:
            continue

        # DEDUP CHECK — never re-enter
        if is_email_in_seq(email):
            elog(f"  DEDUP skip: {email} already in sequence")
            continue

        cs  = random.choice(CASE_STUDIES)
        seq = _load_sequence("cold_sequence")
        if not seq:
            elog("cold_sequence.json missing — skipping")
            break

        step1 = seq["steps"][0]
        em = build_cold_plain(lead, 1, step1.get("subject_variants", ["Quick question"]), cs)

        ok = send_email(email, em["subject"], em["body"], is_html=False)
        if ok:
            mark_email(email, "OUTREACH_1", source="cold")
            advance_email(email, "OUTREACH_1", step=1)
            _increment_sent(w)
            sent += 1
            elog(f"  → Cold step 1 → {email} | {em['subject'][:40]}")
            time.sleep(random.randint(MIN_DELAY_SEC, MAX_DELAY_SEC))

    return sent


def run_followup_sequence():
    """Send due follow-up steps to existing cold leads."""
    due = get_due()
    if not due:
        elog("No follow-ups due today")
        return 0

    can_send, remaining, w = _check_budget()
    seq = _load_sequence("cold_sequence")
    sent = 0

    for rec in due[:remaining]:
        email = rec["email"]
        step  = rec.get("step", 1)
        next_step = step + 1
        if next_step > 4:
            continue

        cs = random.choice(CASE_STUDIES)
        lead = {"email": email,
                "first_name": rec.get("first_name",""),
                "company": rec.get("company","your company"),
                "pain_point": rec.get("pain_point","ad performance"),
                "platform_detected": rec.get("platform_detected","Google/Meta")}

        subjects = []
        if seq and len(seq.get("steps",[])) >= next_step:
            subjects = seq["steps"][next_step-1].get("subject_variants", ["Following up"])

        em = build_cold_plain(lead, next_step, subjects or ["Following up"], cs)
        ok = send_email(email, em["subject"], em["body"], is_html=False)
        if ok:
            new_stage = {2:"OUTREACH_2", 3:"OUTREACH_3", 4:"OUTREACH_4"}.get(next_step,"OUTREACH_4")
            advance_email(email, new_stage, step=next_step)
            _increment_sent(w)
            sent += 1
            elog(f"  → Follow-up step {next_step} → {email}")
            time.sleep(random.randint(MIN_DELAY_SEC, MAX_DELAY_SEC))

    return sent


def run_warm_sequence(warm_leads):
    """Send warm sequence to responded/qualified leads."""
    can_send, remaining, w = _check_budget()
    sent = 0

    for lead in warm_leads[:remaining]:
        email = lead.get("email","")
        if not email: continue

        stage = lead.get("stage","RESPONDED")
        step  = 1 if stage == "RESPONDED" else 2
        cs    = random.choice(CASE_STUDIES)

        em = build_warm_html(lead, step, cs)
        ok = send_email(email, em["subject"], em["body_html"], is_html=True)
        if ok:
            advance_email(email, "PROPOSAL_SENT", step=step)
            _increment_sent(w)
            sent += 1
            elog(f"  → Warm step {step} → {email}")
            time.sleep(random.randint(60, 180))

    return sent


def run_sql_sequence(sql_leads):
    """Send closing emails to SQL-qualified leads."""
    can_send, remaining, w = _check_budget()
    sent = 0

    for lead in sql_leads[:remaining]:
        email = lead.get("email","")
        if not email: continue

        cs = random.choice(CASE_STUDIES)
        em = build_sql_html(lead, 1, cs)
        ok = send_email(email, em["subject"], em["body_html"], is_html=True)
        if ok:
            advance_email(email, "PROPOSAL_SENT", step=1)
            _increment_sent(w)
            sent += 1
            elog(f"  → SQL close → {email}")
            time.sleep(random.randint(60, 180))

    return sent


def _load_sequence(name):
    f = SEQ_DIR / f"{name}.json"
    if f.exists(): return json.loads(f.read_text())
    return None


# ── MAIN ──────────────────────────────────────────────────────────────────────
def main():
    args = sys.argv[1:]
    elog("=== EMAIL MARKETING PIPELINE v2.0 ===")

    w   = _load_warmup()
    lim = _get_daily_limit()
    elog(f"Daily limit: {lim} | Sent today: {w.get('sends_today',0)}")

    total = 0

    # 1. Follow-ups (highest priority — already engaged)
    fu = run_followup_sequence()
    elog(f"Follow-ups sent: {fu}")
    total += fu

    # 2. Warm leads (responded — highest conversion)
    # Pull from CRM leads.json if available
    warm = []
    sql  = []
    crm_file = HOME / ".claude/agency/crm/leads.json"
    if crm_file.exists():
        db = json.loads(crm_file.read_text())
        for lid, lead in db.get("leads", {}).items():
            st = lead.get("stage","")
            if st == "RESPONDED":     warm.append(lead)
            elif st == "QUALIFIED":   sql.append(lead)
    ws = run_warm_sequence(warm)
    elog(f"Warm emails sent: {ws}")
    total += ws

    # 3. SQL close
    ss = run_sql_sequence(sql)
    elog(f"SQL close emails: {ss}")
    total += ss

    # 4. New cold outreach (remaining budget from today's proposals)
    today = datetime.date.today().strftime("%Y%m%d")
    props_file = HOME / f".claude/agency/proposals/proposals_{today}.json"
    cold_leads = []
    if props_file.exists():
        proposals = json.loads(props_file.read_text()).get("proposals",[])
        for p in proposals:
            email = p.get("client_email","") or p.get("email","")
            if email and "@" in email and "digiminds" not in email:
                cold_leads.append({
                    "email":  email,
                    "first_name": p.get("client_name","").split()[0] if p.get("client_name") else "",
                    "company": p.get("client_name",""),
                    "pain_point": p.get("niche","performance marketing"),
                    "platform_detected": "Google Ads & Meta Ads",
                })

    cs_sent = run_cold_sequence(cold_leads)
    elog(f"New cold emails: {cs_sent}")
    total += cs_sent

    elog(f"=== PIPELINE DONE: {total} emails sent/queued ===")
    elog(f"Deliverability: SPF+DKIM+DMARC required on digiminds.org")
    elog(f"Check pending: ~/.claude/agency/data/email_pipeline_pending.jsonl")


if __name__ == "__main__":
    main()
