def review_and_improve(text, job, attempt=1):
    """Score the proposal. If < 75, regenerate with fix notes."""
    score, issues = quick_score(text, job)
    if score >= 75 or attempt >= 2:
        return text, score, issues
    # Regenerate with fix notes
    fix_notes = "; ".join(issues)
    profile  = load_profile()
    learning = load_learning()
    new_prompt = build_prompt(job, profile, learning, fix_notes=fix_notes)
    new_text = call_llm(new_prompt)
    if not new_text or len(new_text) < 50:
        return text, score, issues  # keep original if regen failed
    new_score, new_issues = quick_score(new_text, job)
    if new_score >= score:
        return new_text, new_score, new_issues
    return text, score, issues  # keep original if regen was worse

def main():
    PROP_DIR.mkdir(parents=True, exist_ok=True)
    if not JOBS_FILE.exists():
        log(f"ERROR: No jobs file: {JOBS_FILE}"); sys.exit(1)

    jobs_data = json.loads(JOBS_FILE.read_text())
    jobs      = jobs_data.get("jobs",[])

    # ── DEDUP: skip already-submitted jobs ─────────────────────────────────
    try:
        import importlib.util as _ilu
        _spec = _ilu.spec_from_file_location("dedup", str(Path(__file__).parent/"dedup"))
        _dm   = _ilu.load_module_from_spec(_spec)
        _spec.loader.exec_module(_dm)
        jobs, _skipped = _dm.get_new_jobs_only(jobs)
        if _skipped:
            log(f"  DEDUP: {len(_skipped)} already-submitted jobs skipped")
    except Exception as _ex:
        log(f"  dedup not available ({_ex}) — processing all jobs")

    log(f"=== PROPOSAL GENERATION v4.0: {len(jobs)} jobs ===")
    log(f"LLM chain: Groq → GLM-4.5-air → Ollama | QR: score≥75 required")

    profile  = load_profile()
    learning = load_learning()
    proposals = []
    quality_pass = 0
    quality_regen = 0
    quality_fail = 0

    for i, job in enumerate(jobs):
        label = f"[{i+1}/{len(jobs)}]"

        # Generate
        prompt = build_prompt(job, profile, learning)
        text   = call_llm(prompt)

        if not text or len(text) < 50:
            log(f"  {label} ✗ generation failed — {job['platform']} | {job['title'][:40]}")
            quality_fail += 1
            continue

        # Quality Review
        score, issues = quick_score(text, job)
        if score < 75 and issues:
            # Attempt improvement
            fix_notes = "; ".join(issues)
            new_prompt = build_prompt(job, profile, learning, fix_notes=fix_notes)
            new_text = call_llm(new_prompt)
            if new_text and len(new_text) > 50:
                new_score, new_issues = quick_score(new_text, job)
                if new_score >= score:
                    text, score, issues = new_text, new_score, new_issues
                    quality_regen += 1
                    log(f"  {label} ↑ QR improved {score-new_score+new_score}→{score}: {job['title'][:35]}")
                else:
                    quality_pass += 1
            else:
                quality_pass += 1
        else:
            quality_pass += 1

        proposals.append({
            "job_id":          f"{job['platform']}_{i}_{TODAY}",
            "platform":        job["platform"],
            "job_title":       job["title"],
            "job_url":         job.get("url",""),
            "client_info":     job.get("client_info",{}),
            "relevance_score": job.get("relevance_score",0),
            "quality_score":   score,
            "quality_issues":  issues,
            "pain_points":     job.get("pain_points",[]),
            "is_high_ticket":  job.get("is_high_ticket",False),
            "proposal_text":   text,
            "word_count":      get_word_count(text),
            "budget":          job.get("budget",""),
            "status":          "draft",
            "generated_at":    datetime.datetime.now().isoformat(),
            "submitted_at":    None,
            "response_received": False,
            "response_text":   None
        })
        status_icon = "✓" if score >= 75 else "⚠"
        log(f"  {label} {status_icon} QR:{score} {job['platform'].upper()}: {job['title'][:45]}")

        # Record in dedup tracker so it's never re-generated tomorrow
        try:
            _dm.mark_job_submitted(job.get("url",""), job["platform"], job["title"][:80], score)
        except Exception:
            pass

        time.sleep(1.5)

    breakdown = {}
    for p in ["upwork","linkedin","indeed","reddit","naukri","peopleperhour","guru","freelancer","bark","twitter"]:
        n = len([x for x in proposals if x["platform"] == p])
        if n: breakdown[p] = n

    avg_quality = int(sum(p["quality_score"] for p in proposals) / len(proposals)) if proposals else 0

    out = {
        "date": TODAY,
        "total_proposals": len(proposals),
        "high_ticket_proposals": len([p for p in proposals if p.get("is_high_ticket")]),
        "avg_quality_score": avg_quality,
        "quality_stats": {
            "passed_first_review": quality_pass,
            "improved_by_regen": quality_regen,
            "failed": quality_fail
        },
        "platform_breakdown": breakdown,
        "proposals": proposals
    }
    OUTPUT.write_text(json.dumps(out, indent=2))
    log(f"Generated {len(proposals)}/{len(jobs)} proposals | Avg QR: {avg_quality}/100 | "
        f"Pass:{quality_pass} Regen:{quality_regen} Fail:{quality_fail} → {OUTPUT}")
    return str(OUTPUT)

if __name__ == "__main__":
    print(main())
