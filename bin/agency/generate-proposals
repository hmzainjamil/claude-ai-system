#!/usr/bin/env python3
"""
AGENCY ORCHESTRATOR — Phase 2: Proposal Generation v4.0
LLM Chain: Groq → GLM-4.5-air → Ollama (local)
NEW: Quality Review pass — each proposal reviewed + regenerated if score < 75.
All proposals humanized, platform-optimized, conversion-focused.
"""
import os, sys, json, datetime, requests, time, re
from pathlib import Path

HOME       = Path.home()
AGENCY_DIR = HOME / ".claude/agency"
DATA_DIR   = AGENCY_DIR / "data"
PROP_DIR   = AGENCY_DIR / "proposals"
LOG_FILE   = AGENCY_DIR / "logs/proposals.log"
TODAY      = datetime.date.today().strftime("%Y%m%d")
JOBS_FILE  = DATA_DIR / f"jobs_{TODAY}.json"
OUTPUT     = PROP_DIR / f"proposals_{TODAY}.json"
PROFILE    = AGENCY_DIR / "PROFILE.md"
LEARNING   = AGENCY_DIR / "learning/feedback.json"

GROQ_KEY  = os.environ.get("GROQ_API_KEY","")
GLM_KEY   = os.environ.get("GLM_API_KEY", os.environ.get("ZHIPU_API_KEY",""))
OLLAMA_URL= "http://localhost:11434/api/generate"
GROQ_URL  = "https://api.groq.com/openai/v1/chat/completions"
GROQ_MODEL= "llama-3.1-8b-instant"
GLM_URL   = "https://open.bigmodel.cn/api/paas/v4/chat/completions"
GLM_MODEL = "glm-4.5-air"

BANNED_OPENERS = [
    "i hope", "i am writing", "i saw your post", "i came across", "i am interested",
    "i would like to", "greetings", "dear client", "hello there", "hi there",
    "i am excited", "i am reaching out", "my name is", "i noticed your"
]

def log(msg):
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line)
    with open(LOG_FILE,"a") as f: f.write(line+"\n")

def call_groq(prompt, max_tokens=500):
    if not GROQ_KEY: return ""
    for attempt in range(3):
        try:
            r = requests.post(GROQ_URL,
                json={"model":GROQ_MODEL,
                      "messages":[{"role":"user","content":prompt}],
                      "max_tokens":max_tokens,"temperature":0.8},
                headers={"Authorization":f"Bearer {GROQ_KEY}"},
                timeout=25)
            if r.status_code == 200:
                text = r.json()["choices"][0]["message"]["content"].strip()
                # Log usage
                try:
                    import subprocess as _sp
                    _sp.Popen([sys.executable, str(HOME/".claude/bin/agency/limit-tracker"),
                               "log","groq","requests","1"], stdout=_sp.DEVNULL, stderr=_sp.DEVNULL)
                    _sp.Popen([sys.executable, str(HOME/".claude/bin/agency/limit-tracker"),
                               "log","groq","tokens", str(max_tokens)], stdout=_sp.DEVNULL, stderr=_sp.DEVNULL)
                except: pass
                return text
            if r.status_code == 429:
                wait = int(r.headers.get("retry-after","15"))
                log(f"  Groq rate limit — waiting {wait}s")
                time.sleep(wait)
                continue
        except Exception as e:
            log(f"  Groq error: {e}")
            time.sleep(3)
    return ""

def call_glm(prompt, max_tokens=500):
    if not GLM_KEY: return ""
    for attempt in range(2):
        try:
            r = requests.post(GLM_URL,
                json={"model":GLM_MODEL,
                      "messages":[{"role":"user","content":prompt}],
                      "max_tokens":max_tokens,"temperature":0.8},
                headers={"Authorization":f"Bearer {GLM_KEY}"},
                timeout=30)
            if r.status_code == 200:
                return r.json()["choices"][0]["message"]["content"].strip()
            if r.status_code == 429:
                time.sleep(10); continue
        except Exception as e:
            log(f"  GLM error: {e}")
    return ""

def call_ollama(prompt):
    try:
        r = requests.post(OLLAMA_URL,
            json={"model":"llama3:latest","prompt":prompt,"stream":False,"options":{"num_predict":450}},
            timeout=60)
        if r.status_code == 200:
            return r.json().get("response","").strip()
    except Exception as e:
        log(f"  Ollama error: {e}")
    return ""

def call_llm(prompt, max_tokens=500):
    text = call_groq(prompt, max_tokens)
    if text and len(text) > 50:
        return text
    text = call_glm(prompt, max_tokens)
    if text and len(text) > 50:
        return text
    text = call_ollama(prompt)
    if text and len(text) > 50:
        return text
    return ""

def load_profile():
    return PROFILE.read_text() if PROFILE.exists() else (
        "Hafiz Muhammad Zulqarnain, Meta Ads + Google Ads expert. "
        "DigiMinds agency. 90-day ROI guarantee. "
        "Portfolio: hafiz-muhammad-z-3n01vli.gamma.site | digiminds.org"
    )

def load_learning():
    if LEARNING.exists():
        return json.loads(LEARNING.read_text())
    return {"what_works":[],"what_fails":[],"avg_response_rate":0}

def get_word_count(text):
    return len(text.split())

def check_banned_opener(text):
    first_line = text.lower().strip().split('\n')[0][:80]
    for ban in BANNED_OPENERS:
        if first_line.startswith(ban):
            return ban
    return None

def quick_score(text, job):
    """Fast rule-based quality score — no LLM needed."""
    score = 100
    issues = []
    wc = get_word_count(text)
    platform = job.get("platform","upwork")

    # Word count check
    limits = {
        "upwork": (100, 170), "reddit": (80, 130), "linkedin": (65, 110),
        "twitter": (50, 90), "freelancer": (110, 160), "guru": (110, 160),
        "peopleperhour": (110, 160), "indeed": (100, 160),
        "naukri": (100, 160), "bark": (80, 140)
    }
    lo, hi = limits.get(platform, (80, 170))
    if wc < lo:
        score -= 20; issues.append(f"too short ({wc} words, need {lo}+)")
    elif wc > hi:
        score -= 15; issues.append(f"too long ({wc} words, max {hi})")

    # Banned opener
    banned = check_banned_opener(text)
    if banned:
        score -= 30; issues.append(f"banned opener: '{banned}'")

    # Must mention digiminds or ROI guarantee
    tl = text.lower()
    if "digiminds" not in tl and "90-day" not in tl:
        score -= 10; issues.append("missing DigiMinds/guarantee mention")

    # Must have a question or CTA
    has_cta = "?" in text or any(w in tl for w in ["schedule","call","chat","discuss","reply","reach out","connect"])
    if not has_cta:
        score -= 15; issues.append("missing CTA or question")

    # Pain point reference check
    pain = job.get("pain_points",[])
    desc_words = job.get("description","")[:200].lower().split()
    # At least 2 words from job description should appear
    matches = sum(1 for w in desc_words if len(w)>5 and w in tl)
    if matches < 2:
        score -= 10; issues.append("not specific enough to job description")

    # Generic filler phrases
    fillers = ["extensive experience","proven track record","passionate about","dedicated professional"]
    for f in fillers:
        if f in tl:
            score -= 5; issues.append(f"generic filler: '{f}'")

    return max(0, score), issues

