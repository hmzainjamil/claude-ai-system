class CoverPage(Flowable):
    def __init__(self, business, city, niche, pal):
        super().__init__()
        self.business = business
        self.city     = city
        self.niche    = niche
        self.pal      = pal
        self.width    = CW
        self.height   = FHGT

    def draw(self):
        c = self.canv
        c.saveState()
        c.translate(-LEFT_M - FP, -BOT_M - FP)

        # Gradient background (approximated with bands)
        steps = 60
        for i in range(steps):
            t = i / steps
            r1, g1, b1 = 0xC0/255, 0x39/255, 0x2B/255
            r2, g2, b2 = 0xE6/255, 0x7E/255, 0x22/255
            r = r1 + (r2-r1)*t
            g = g1 + (g2-g1)*t
            b = b1 + (b2-b1)*t
            y  = H * (1 - (i+1)/steps)
            bh = H / steps + 1
            c.setFillColorRGB(r, g, b)
            c.rect(0, y, W, bh, fill=1, stroke=0)

        # Dark overlay strip at bottom 15%
        c.setFillColorRGB(0, 0, 0, alpha=0.35)
        c.rect(0, 0, W, H * 0.15, fill=1, stroke=0)

        # Decorative diagonal lines
        c.saveState()
        c.setStrokeColorRGB(1, 1, 1, alpha=0.07)
        c.setLineWidth(28)
        for i in range(8):
            x = -100 + i * 110
            c.line(x, 0, x + H, H)
        c.restoreState()

        # Accent bar left edge
        c.setFillColor(HexColor(self.pal["S"]))
        c.rect(0, 0, 8, H, fill=1, stroke=0)

        # "360° STRATEGIC AUDIT" headline
