def score_bar_color(score, max_score=100):
    ratio = score / max_score
    if ratio >= 0.75: return C_GRN
    if ratio >= 0.5:  return C_YEL
    if ratio >= 0.3:  return C_ORG
    return C_RED


def score_overview_table(scores):
    """scores = list of (label, score, max)"""
    rows = [["Metric", "Score", "Rating"]]
    for label, score, mx in scores:
        ratio = score / mx
        if ratio >= 0.75: rating = "Good"
        elif ratio >= 0.5: rating = "Needs Work"
