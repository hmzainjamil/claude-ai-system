def build_pdf(out_path, business, city, niche, url=""):
    pal = PROSPECT_BRANDS.get(
        business.lower().replace(" ", "_").replace("&", "").replace(",", "").replace(".", "").replace("'", ""),
        None
    )
    if not pal:
        # try live extraction
        p1, p2 = extract_brand_colors(url)
        pal = {"P": p1 or "#2563EB", "S": p2 or "#1E40AF"}

    nd = NICHE_DATA.get(niche, NICHE_DATA["med_spa"])

    def hf(canvas, doc):
        make_hf(business, pal)(canvas, doc)

    doc = SimpleDocTemplate(
        str(out_path),
        pagesize=A4,
        leftMargin=LEFT_M, rightMargin=RIGHT_M,
        topMargin=TOP_M,   bottomMargin=BOT_M,
        leftPadding=0, rightPadding=0, topPadding=0, bottomPadding=0,
    )

    story = []
    sp = lambda n: Spacer(1, n)

    # ── COVER ─────────────────────────────────────────────────────────────────
    story.append(CoverPage(business, city, niche.replace("_"," ").title(), pal))
    story.append(PageBreak())

    # ── SEC 1: EXECUTIVE SUMMARY ──────────────────────────────────────────────
    story.append(SectionHeader(1, "Executive Summary", pal))
    story.append(sp(10))
    story.append(p(nd["exec_summary"]))
    story.append(sp(12))

    # Score overview bars
    story.append(p("PERFORMANCE OVERVIEW", "bodyB"))
    story.append(sp(6))
    for label, score, mx in nd["scores"]:
        c = score_bar_color(score, mx)
        story.append(ScoreBar(label, score, mx, color=c))
        story.append(sp(3))
    story.append(sp(10))

    # ── SEC 2: CRO ANALYSIS ───────────────────────────────────────────────────
    story.append(SectionHeader(2, "Conversion Rate Optimization (CRO)", pal))
    story.append(sp(10))
    story.append(p("Website conversion audit — every element that affects whether a visitor becomes a lead.", "small"))
    story.append(sp(8))
    story.append(cro_checklist_table(nd["cro"]))
    story.append(sp(12))

    # ── SEC 3: SWOT ───────────────────────────────────────────────────────────
    story.append(SectionHeader(3, "SWOT Analysis", pal))
    story.append(sp(10))
    story.append(swot_table(nd["swot"], pal))
    story.append(sp(12))

    # ── SEC 4: COMPETITIVE LANDSCAPE ─────────────────────────────────────────
    story.append(SectionHeader(4, "Competitive Landscape", pal))
    story.append(sp(10))
    story.append(competitor_table(nd["competitors"], pal))
    story.append(sp(12))

    # ── SEC 5: SEO AUDIT ─────────────────────────────────────────────────────
    story.append(SectionHeader(5, "SEO & Keyword Audit", pal))
    story.append(sp(10))
    story.append(p("Target keyword opportunities for organic and paid visibility.", "small"))
    story.append(sp(8))
    story.append(keyword_table(nd["keywords"]))
    story.append(sp(12))

    # ── SEC 6: AEO (Answer Engine Optimization) ───────────────────────────────
    story.append(SectionHeader(6, "AEO — Answer Engine Optimization", pal))
    story.append(sp(10))
    story.append(p("Visibility in AI-powered search: Google SGE, voice search, and featured snippets.", "small"))
    story.append(sp(8))
    story.append(aeo_geo_table(nd["aeo"], cols=["AEO FACTOR", "STATUS", "ACTION"]))
    story.append(sp(12))

    # ── SEC 7: GEO / LOCAL SEO ────────────────────────────────────────────────
