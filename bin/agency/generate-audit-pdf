    story.append(paid_audit_table(nd["paid_channels"]))
    story.append(sp(10))
    story.append(p("Key Findings:", "bodyB"))
    story.append(sp(6))
    story.append(findings_table(nd["findings"]))
    story.append(sp(12))

    # ── SEC 9: GAP ANALYSIS ───────────────────────────────────────────────────
