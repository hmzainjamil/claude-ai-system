def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--niche")
    ap.add_argument("--business")
    ap.add_argument("--city", default="")
    ap.add_argument("--url",  default="")
    ap.add_argument("--out",  default="")
    ap.add_argument("--all",  action="store_true")
    ap.add_argument("--bdm",  action="store_true")
    args = ap.parse_args()

    if args.all or args.bdm:
        out_base = HOME / "Downloads/DigiMinds_BDM" / DATE_DIR / "Audit_PDFs"
        out_base.mkdir(parents=True, exist_ok=True)
        flat_base = HOME / "Downloads/DigiMinds_BDM/Audit_PDFs"
        flat_base.mkdir(parents=True, exist_ok=True)
        for pr in PROSPECTS:
            fname = f"audit_{pr['niche']}_{slug(pr['business'])}.pdf"
            out_path = out_base / fname
            flat_path = flat_base / fname
            print(f"  Generating: {pr['business']} ...")
            build_pdf(out_path, pr["business"], pr["city"], pr["niche"], pr.get("url",""))
            import shutil; shutil.copy2(out_path, flat_path)
            print(f"  ✓ {out_path}")
        print(f"\nDone. {len(PROSPECTS)} PDFs in {out_base}")
    elif args.business and args.niche:
        out_path = Path(args.out) if args.out else (HOME / "Downloads/DigiMinds_BDM/Audit_PDFs" / f"audit_{args.niche}_{slug(args.business)}.pdf")
        out_path.parent.mkdir(parents=True, exist_ok=True)
        build_pdf(out_path, args.business, args.city, args.niche, args.url)
        print(f"✓ {out_path}")
    else:
        ap.print_help()


if __name__ == "__main__":
    main()
