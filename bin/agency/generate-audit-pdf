    story.append(sp(10))
    story.append(aeo_geo_table(nd["geo_local"], cols=["LOCAL FACTOR", "STATUS", "ACTION"]))
    story.append(sp(12))

    # ── SEC 8: PAID CHANNEL AUDIT ─────────────────────────────────────────────
