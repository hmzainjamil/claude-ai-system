    story.append(quick_wins_table(qw))
    story.append(sp(16))

    # ── FINAL PAGE ────────────────────────────────────────────────────────────
    story.append(PageBreak())
    story.append(FinalPage(business, pal))

    doc.build(story, onFirstPage=hf, onLaterPages=hf)
    return out_path


