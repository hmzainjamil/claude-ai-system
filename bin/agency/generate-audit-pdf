def tbl_style(extra=None, hdr_rows=1):
    """Standard table style: dark red header, alternating rows, grid."""
    cmds = [
        ("BACKGROUND",   (0,0), (-1, hdr_rows-1), C_HDR),
        ("TEXTCOLOR",    (0,0), (-1, hdr_rows-1), white),
        ("FONTNAME",     (0,0), (-1, hdr_rows-1), "Helvetica-Bold"),
        ("FONTSIZE",     (0,0), (-1, hdr_rows-1), 8.5),
        ("ALIGN",        (0,0), (-1,-1),           "LEFT"),
        ("VALIGN",       (0,0), (-1,-1),           "MIDDLE"),
        ("FONTNAME",     (0,1), (-1,-1),            "Helvetica"),
        ("FONTSIZE",     (0,1), (-1,-1),            8.5),
        ("ROWBACKGROUNDS",(0,1),(-1,-1),            [white, C_VLIT]),
        ("GRID",         (0,0), (-1,-1),           0.5, C_BD),
        ("TOPPADDING",   (0,0), (-1,-1),           5),
        ("BOTTOMPADDING",(0,0), (-1,-1),           5),
        ("LEFTPADDING",  (0,0), (-1,-1),           6),
        ("RIGHTPADDING", (0,0), (-1,-1),           6),
        ("LINEABOVE",    (0,0), (-1,0),            1.5, C_HDR),
        ("LINEBELOW",    (0, hdr_rows-1), (-1, hdr_rows-1), 1.5, C_HDR),
    ]
    if extra:
        cmds.extend(extra)
    return TableStyle(cmds)


