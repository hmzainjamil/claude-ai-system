class SectionHeader(Flowable):
    """Numbered circle + colored bar — matches BigBull section style."""
    def __init__(self, number, title, pal, height=36):
        super().__init__()
        self.number  = number
        self.title   = title
        self.pal     = pal
        self.width   = CW
        self.height  = height

    def draw(self):
        c = self.canv
        P = HexColor(self.pal["P"])
        S = HexColor(self.pal["S"])
        c.saveState()

        # Background bar
        c.setFillColor(P)
        c.roundRect(0, 0, self.width, self.height, 5, fill=1, stroke=0)

        # Accent left strip
        c.setFillColor(S)
        c.roundRect(0, 0, 6, self.height, 3, fill=1, stroke=0)

        # Circle number
        cx, cy, r = 28, self.height/2, 13
        c.setFillColor(C_DRK)
        c.circle(cx, cy, r, fill=1, stroke=0)
        c.setFillColor(S)
        c.setFont("Helvetica-Bold", 11)
        c.drawCentredString(cx, cy - 4, str(self.number))

        # Title
        c.setFillColor(white)
        c.setFont("Helvetica-Bold", 13)
        c.drawString(50, self.height/2 - 5, self.title.upper())

        c.restoreState()

    def wrap(self, *args):
        return (self.width, self.height)


class ScoreBar(Flowable):
    """Horizontal score bar: label left, gray track, colored fill, score right."""
    def __init__(self, label, score, max_score=100, color=None, height=20):
        super().__init__()
        self.label     = label
        self.score     = score
        self.max_score = max_score
        self.color     = color or C_GRN
        self.width     = CW
        self.height    = height

    def draw(self):
        c = self.canv
        c.saveState()
        label_w = 160
        bar_x   = label_w + 10
        bar_w   = self.width - label_w - 60
        bar_h   = 10
        bar_y   = (self.height - bar_h) / 2

        # Label
        c.setFillColor(C_TXT)
        c.setFont("Helvetica", 8.5)
        c.drawString(0, bar_y + 1, self.label)

        # Gray track
        c.setFillColor(HexColor("#E0E0E0"))
        c.roundRect(bar_x, bar_y, bar_w, bar_h, 3, fill=1, stroke=0)

        # Colored fill
        fill_w = max(6, bar_w * self.score / self.max_score)
        c.setFillColor(self.color)
        c.roundRect(bar_x, bar_y, fill_w, bar_h, 3, fill=1, stroke=0)

        # Score text
        c.setFillColor(C_TXT)
        c.setFont("Helvetica-Bold", 9)
        c.drawRightString(self.width, bar_y + 2, f"{self.score}/{self.max_score}")

        c.restoreState()

    def wrap(self, *args):
        return (CW, self.height)


