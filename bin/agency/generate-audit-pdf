# ── Brand color extraction ────────────────────────────────────────────────────
def extract_brand_colors(url):
    if not url:
        return None, None
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        html = urllib.request.urlopen(req, timeout=8).read().decode("utf-8", errors="replace")
        # CSS custom properties
        for pat in [r'--primary[-_]color\s*:\s*(#[0-9a-fA-F]{6})',
                    r'--brand[-_]color\s*:\s*(#[0-9a-fA-F]{6})',
                    r'--color[-_]primary\s*:\s*(#[0-9a-fA-F]{6})',
                    r'--accent[-_]color\s*:\s*(#[0-9a-fA-F]{6})',
                    r'--main[-_]color\s*:\s*(#[0-9a-fA-F]{6})']:
            m = re.search(pat, html)
            if m:
                primary = m.group(1)
                # find a second color
                all_hex = re.findall(r'#([0-9a-fA-F]{6})\b', html)
                seen = set()
                secondary = None
                for h in all_hex:
                    hx = "#" + h.upper()
                    if hx != primary.upper() and hx not in seen:
                        seen.add(hx)
                        if len(seen) >= 3:
                            secondary = hx
                            break
                return primary, secondary or "#555555"
        # Fallback: most common hex in stylesheet links
        all_hex = re.findall(r'#([0-9a-fA-F]{6})\b', html)
        freq = {}
        for h in all_hex:
            freq[h.upper()] = freq.get(h.upper(), 0) + 1
        sorted_hex = sorted(freq.items(), key=lambda x: -x[1])
        if len(sorted_hex) >= 2:
            return "#" + sorted_hex[0][0], "#" + sorted_hex[1][0]
    except Exception:
        pass
    return None, None

