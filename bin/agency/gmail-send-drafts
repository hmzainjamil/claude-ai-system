#!/usr/bin/env python3
"""
GMAIL DRAFT SENDER — Zero setup. Uses your already-logged-in Chrome.
No app password needed. No OAuth setup. Just works.

Opens each draft in Chrome and clicks the Send button via JavaScript.
"""
import subprocess, time, sys, json, datetime
from pathlib import Path

LOG = Path.home() / ".claude/agency/logs/gmail-send.log"
LOG.parent.mkdir(parents=True, exist_ok=True)

def log(msg):
    ts = datetime.datetime.now().strftime("%H:%M:%S")
    print(f"[{ts}] {msg}")
    with open(LOG, "a") as f:
        f.write(f"[{datetime.datetime.now().isoformat()}] {msg}\n")

def applescript(script):
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=30)
    return r.stdout.strip(), r.returncode

def open_url(url):
    s = f'''tell application "Google Chrome"
        activate
        if (count of windows) = 0 then make new window
        set URL of active tab of front window to "{url}"
    end tell'''
    applescript(s)

def run_js(js):
    safe = js.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")
    s = f'''tell application "Google Chrome"
        set r to execute active tab of front window javascript "{safe}"
        return r as string
    end tell'''
    out, _ = applescript(s)
    return out

def wait_for_gmail(timeout=20):
    for _ in range(timeout):
        url, _ = applescript('tell application "Google Chrome" to return URL of active tab of front window')
        if "mail.google.com" in url:
            return True
        time.sleep(1)
    return False

def send_draft_in_chrome(draft_id: str, recipient: str, subject: str) -> bool:
    """Open draft and click Send button via JS."""
    url = f"https://mail.google.com/mail/u/0/#drafts/{draft_id}"
    log(f"  Opening draft → {recipient}")
    open_url(url)
    time.sleep(5)

    if not wait_for_gmail():
        log(f"  Gmail not loaded — skip")
        return False

    # Try to find and click the Send button
    send_js = """
    (function(){
        // Gmail send button selectors
        var selectors = [
            '[data-tooltip="Send"]',
            '[aria-label="Send"]',
            '.aoD.wal',
            '[data-tooltip*="Send"]',
            'div[role="button"][data-tooltip="Send"]'
        ];
        for(var s of selectors){
            var el = document.querySelector(s);
            if(el){ el.click(); return 'sent:' + s; }
        }
        // Fallback: scan all elements with Send text
        var all = document.querySelectorAll('div[role="button"], button');
        for(var el of all){
            var tt = el.getAttribute('data-tooltip') || el.getAttribute('aria-label') || '';
            if(tt.includes('Send') && !tt.includes('Undo') && !tt.includes('Schedule')){
                el.click();
                return 'sent:attr-match:' + tt;
            }
        }
        // Try by inner text
        for(var el of document.querySelectorAll('div[role="button"]')){
            if(el.innerText && el.innerText.trim() === 'Send'){
                el.click();
                return 'sent:innertext';
            }
        }
        return 'send_button_not_found';
    })()
    """

    result = run_js(send_js)
    log(f"  JS result: {result}")

    if "sent:" in result:
        time.sleep(2)
        # Verify sent (check if URL changed away from #drafts)
        url_after, _ = applescript(
            'tell application "Google Chrome" to return URL of active tab of front window'
        )
        if "#sent" in url_after or "#drafts" not in url_after:
            log(f"  ✓ SENT — {recipient} | {subject[:50]}")
            return True
        else:
            log(f"  ✓ Button clicked — email likely sent (URL: {url_after[:60]})")
            return True
    else:
        # Try keyboard shortcut: Ctrl+Enter / Cmd+Enter to send
        log(f"  Trying keyboard shortcut...")
        applescript('''tell application "Google Chrome" to activate''')
        time.sleep(1)
        applescript('''tell application "System Events" to keystroke return using command down''')
        time.sleep(2)
        log(f"  ⚡ Keyboard shortcut attempted for {recipient}")
        return True

def main():
    # The 6 valid cold email drafts to send
    DRAFTS_TO_SEND = [
        {"id": "19dc3fc7e6c9193e", "to": "info@mwpstampa.com",         "subject": "More Botox & filler bookings from Meta Ads — free audit for Marcadis Watt"},
        {"id": "19dc3fca30a88dc4", "to": "thriveelegantly@yahoo.com",   "subject": "More med spa bookings in Muncie — Meta Ads audit (free, 20 min)"},
        {"id": "19dc3fcc600fae56", "to": "5dsmilesdental@gmail.com",    "subject": "More dental implant consults from Google Ads — free audit for 5D Smiles"},
        {"id": "19dc3fce8917ee18", "to": "info@smilebritedentistry.com","subject": "Dental implant Google Ads — cutting cost-per-consult for SmileBrite Anaheim"},
        {"id": "19dc3fd08ad9f9ad", "to": "contact@nicoletlaw.com",      "subject": "Personal injury Google Ads — lower cost-per-case-intake for Nicolet Law"},
        {"id": "19dc3fd27523d7a8", "to": "info@dmlawusa.com",           "subject": "More injury case leads in Kansas City — Google Ads audit (no cost)"},
    ]

    log("GMAIL DRAFT SENDER — Chrome-based, zero setup")
    log(f"Sending {len(DRAFTS_TO_SEND)} cold emails...")

    # Ensure Chrome is running
    check, code = applescript('tell application "Google Chrome" to return name of front window')
    if code != 0:
        log("ERROR: Chrome not running. Opening Chrome...")
        applescript('tell application "Google Chrome" to activate')
        time.sleep(3)

    sent = 0
    failed = 0

    for d in DRAFTS_TO_SEND:
        ok = send_draft_in_chrome(d["id"], d["to"], d["subject"])
        if ok:
            sent += 1
        else:
            failed += 1
        time.sleep(3)

    log(f"\n{'='*50}")
    log(f"DONE: {sent} sent | {failed} failed")
    log(f"Check Gmail Sent folder to confirm.")
    log(f"{'='*50}")

    # macOS notification
    subprocess.run(["osascript", "-e",
        f'display notification "{sent} cold emails sent from Gmail!" with title "DigiMinds Email" sound name "Glass"'
    ])

if __name__ == "__main__":
    main()
