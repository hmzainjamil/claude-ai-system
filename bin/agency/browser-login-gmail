#!/usr/bin/env python3
"""
GMAIL LOGIN HELPER — opens Chromium to Gmail and waits.

Just sign into zulqarnain@digiminds.org. This script polls the URL every 3 seconds.
The MOMENT you reach the inbox (mail.google.com), it auto-closes and saves.

You don't need to close the window manually. Just sign in.
"""
import os, sys, time, datetime
from pathlib import Path

HOME = Path.home()
PROFILE = HOME / ".claude/agency/browser-profile"
GMAIL_USER = "zulqarnain@digiminds.org"
LOG = HOME / ".claude/agency/logs/browser-login.log"

def log(msg):
    ts = datetime.datetime.now().strftime("%H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(line + "\n")

from playwright.sync_api import sync_playwright

with sync_playwright() as p:
    log("Opening Chromium to Gmail. Sign in with zulqarnain@digiminds.org.")
    log("Auto-detects success. Don't close manually — script will handle it.")

    ctx = p.chromium.launch_persistent_context(
        user_data_dir=str(PROFILE),
        headless=False,
        viewport={"width": 1280, "height": 900},
        args=["--disable-blink-features=AutomationControlled", "--profile-directory=Profile 1"],
    )
    page = ctx.pages[0] if ctx.pages else ctx.new_page()
    page.goto(f"https://accounts.google.com/AccountChooser?Email={GMAIL_USER}&continue=https://mail.google.com/mail/u/0/")

    # Poll for success — wait up to 5 min (300s)
    deadline = time.time() + 300
    last_log = ""
    while time.time() < deadline:
        try:
            url = page.url
            if "mail.google.com/mail" in url and "AccountChooser" not in url:
                log(f"✓ DETECTED: signed into Gmail. URL: {url[:60]}")
                # Wait 5s for cookies to fully set
                time.sleep(5)
                break
            if url != last_log:
                log(f"  current: {url[:80]}")
                last_log = url
            time.sleep(3)
        except Exception as e:
            log(f"  poll error: {e}")
            time.sleep(3)
    else:
        log("⚠ Timeout (5 min) — closing anyway. Profile may be partial.")

    log("Closing browser. Profile saved.")
    ctx.close()
    log("✓ Done. Now run: browser-bot --test to send a real test email.")
