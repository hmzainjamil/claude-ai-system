#!/usr/bin/env python3
"""
AGENCY DEDUP ENGINE — Never send the same proposal or email twice.
Tracks: submitted job URLs + emailed prospect addresses + sequence positions.

CLI:
  dedup check-job <job_url>           → exits 0=new, 1=already sent
  dedup mark-job <job_url> <platform> → mark job as submitted
  dedup check-email <email>           → exits 0=new, 1=already in sequence
  dedup mark-email <email> <stage>    → mark email as entered at stage
  dedup stats                         → print dedup stats
"""
import sys, json, hashlib, datetime
from pathlib import Path

HOME      = Path.home()
AGENCY    = HOME / ".claude/agency"
JOB_DB    = AGENCY / "data/submitted_jobs.json"
EMAIL_DB  = AGENCY / "data/email_sequences.json"   # source of truth for dedup (crm/leads.json is the full record)

def _load(path):
    return json.loads(path.read_text()) if path.exists() else {}

def _save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2))

def url_hash(url):
    return hashlib.md5(url.strip().lower().encode()).hexdigest()[:16]

def email_hash(email):
    return email.strip().lower()

# ── JOB DEDUP ─────────────────────────────────────────────────────────────────

def is_job_submitted(job_url):
    """Return True if proposal already sent for this job URL."""
    db = _load(JOB_DB)
    h  = url_hash(job_url)
    return h in db

def mark_job_submitted(job_url, platform, job_title="", score=0):
    """Record job as submitted. Idempotent."""
    db = _load(JOB_DB)
    h  = url_hash(job_url)
    if h not in db:
        db[h] = {
            "url":       job_url,
            "platform":  platform,
            "title":     job_title,
            "score":     score,
            "submitted": datetime.datetime.now().isoformat(),
            "date":      datetime.date.today().isoformat(),
        }
        _save(JOB_DB, db)
    return db[h]

def get_new_jobs_only(jobs):
    """Filter job list to only jobs NOT already submitted. Returns (new, skipped)."""
    new, skipped = [], []
    for j in jobs:
        url = j.get("url","") or j.get("job_url","")
        if url and is_job_submitted(url):
            skipped.append(j)
        else:
            new.append(j)
    return new, skipped

# ── EMAIL DEDUP ───────────────────────────────────────────────────────────────

def is_email_in_sequence(email):
    """Return True if email is already in any active outreach sequence."""
    db = _load(EMAIL_DB)
    return email_hash(email) in db

def get_email_sequence_stage(email):
    """Return current stage string or None."""
    db = _load(EMAIL_DB)
    rec = db.get(email_hash(email))
    return rec["stage"] if rec else None

def mark_email_entered_sequence(email, stage="OUTREACH_1", source="cold"):
    """Record email as entered sequence. Returns False if already in sequence (dedup)."""
    db = _load(EMAIL_DB)
    key = email_hash(email)
    if key in db:
        return False   # already tracked — prevent duplicate
    db[key] = {
        "email":    email,
        "stage":    stage,
        "source":   source,
        "entered":  datetime.datetime.now().isoformat(),
        "last_sent": None,
        "step":     1,
        "total_sent": 0,
        "replied":  False,
        "unsubscribed": False,
        "bounced":  False,
    }
    _save(EMAIL_DB, db)
    return True

def advance_email_stage(email, new_stage, step=None):
    """Update sequence stage and optionally step number."""
    db = _load(EMAIL_DB)
    key = email_hash(email)
    if key not in db:
        return False
    db[key]["stage"]     = new_stage
    db[key]["last_sent"] = datetime.datetime.now().isoformat()
    db[key]["total_sent"] = db[key].get("total_sent", 0) + 1
    if step is not None:
        db[key]["step"] = step
    _save(EMAIL_DB, db)
    return True

def mark_replied(email):
    db = _load(EMAIL_DB)
    key = email_hash(email)
    if key in db:
        db[key]["replied"] = True
        db[key]["stage"]   = "RESPONDED"
        _save(EMAIL_DB, db)

def mark_unsubscribed(email):
    db = _load(EMAIL_DB)
    key = email_hash(email)
    if key in db:
        db[key]["unsubscribed"] = True
        db[key]["stage"]        = "UNSUBSCRIBED"
        _save(EMAIL_DB, db)

def mark_bounced(email):
    db = _load(EMAIL_DB)
    key = email_hash(email)
    if key in db:
        db[key]["bounced"] = True
        db[key]["stage"]   = "BOUNCED"
        _save(EMAIL_DB, db)

def get_due_followups(today=None):
    """Return emails due for their next sequence step today."""
    if today is None:
        today = datetime.date.today()
    db  = _load(EMAIL_DB)
    due = []
    for key, rec in db.items():
        if rec.get("unsubscribed") or rec.get("bounced") or rec.get("replied"):
            continue
        if rec["stage"] not in ("OUTREACH_1","OUTREACH_2","OUTREACH_3"):
            continue
        last = rec.get("last_sent")
        if not last:
            continue
        last_date = datetime.date.fromisoformat(last[:10])
        step = rec.get("step", 1)
        # day offsets: step2→3 days, step3→7 days, step4→14 days
        day_gap = {1: 3, 2: 4, 3: 7}.get(step, 7)
        if (today - last_date).days >= day_gap:
            due.append(rec)
    return due

def get_stats():
    job_db   = _load(JOB_DB)
    email_db = _load(EMAIL_DB)

    by_platform = {}
    for v in job_db.values():
        pl = v.get("platform","?")
        by_platform[pl] = by_platform.get(pl, 0) + 1

    by_stage = {}
    for v in email_db.values():
        st = v.get("stage","?")
        by_stage[st] = by_stage.get(st, 0) + 1

    return {
        "total_jobs_submitted":   len(job_db),
        "jobs_by_platform":       by_platform,
        "total_emails_in_seq":    len(email_db),
        "emails_by_stage":        by_stage,
        "replies":   sum(1 for v in email_db.values() if v.get("replied")),
        "unsubs":    sum(1 for v in email_db.values() if v.get("unsubscribed")),
        "bounced":   sum(1 for v in email_db.values() if v.get("bounced")),
    }

# ── CLI ───────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        sys.exit(0)

    cmd = args[0]
    if cmd == "check-job":
        url = args[1] if len(args) > 1 else ""
        sys.exit(1 if is_job_submitted(url) else 0)

    elif cmd == "mark-job":
        url      = args[1] if len(args) > 1 else ""
        platform = args[2] if len(args) > 2 else "unknown"
        title    = args[3] if len(args) > 3 else ""
        r = mark_job_submitted(url, platform, title)
        print(f"✓ marked: {r['url'][:60]} [{platform}]")

    elif cmd == "check-email":
        email = args[1] if len(args) > 1 else ""
        if is_email_in_sequence(email):
            stage = get_email_sequence_stage(email)
            print(f"DUPLICATE — {email} already in sequence at stage: {stage}")
            sys.exit(1)
        else:
            print(f"NEW — {email} not in sequence yet")
            sys.exit(0)

    elif cmd == "mark-email":
        email  = args[1] if len(args) > 1 else ""
        stage  = args[2] if len(args) > 2 else "OUTREACH_1"
        ok = mark_email_entered_sequence(email, stage)
        print(f"{'✓ entered' if ok else '✗ duplicate (skipped)'}: {email} → {stage}")

    elif cmd == "stats":
        s = get_stats()
        print(f"\n{'='*45}")
        print(f"DEDUP STATS")
        print('='*45)
        print(f"Jobs submitted (total): {s['total_jobs_submitted']}")
        for pl, ct in sorted(s['jobs_by_platform'].items(), key=lambda x: -x[1]):
            print(f"  {pl:<20} {ct}")
        print(f"\nEmails in sequence:     {s['total_emails_in_seq']}")
        for st, ct in sorted(s['emails_by_stage'].items(), key=lambda x: -x[1]):
            print(f"  {st:<20} {ct}")
        print(f"\nReplies:   {s['replies']}")
        print(f"Unsubs:    {s['unsubs']}")
        print(f"Bounced:   {s['bounced']}")
        print()
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)
