def outreach_log(msg):
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line)
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG_FILE, "a") as f:
        f.write(line + "\n")


# ── WARMUP TRACKER ────────────────────────────────────────────────────────────

def load_warmup():
    if WARMUP_FILE.exists():
        return json.loads(WARMUP_FILE.read_text())
    # Initialize — week 1 of warmup
    warmup = {
        "start_date": datetime.date.today().isoformat(),
        "sends_today": 0,
        "last_send_date": "",
        "total_sent": 0,
        "total_bounces": 0,
        "total_replies": 0,
        "bounce_rate": 0.0,
        "reply_rate": 0.0,
        "reputation_score": 100,  # internal score, drops on bounces/spam
    }
    WARMUP_FILE.parent.mkdir(parents=True, exist_ok=True)
    WARMUP_FILE.write_text(json.dumps(warmup, indent=2))
    return warmup


def save_warmup(w):
    WARMUP_FILE.write_text(json.dumps(w, indent=2))


def get_daily_limit():
    """Calculate today's send limit based on warmup week."""
    w = load_warmup()
    start = datetime.date.fromisoformat(w["start_date"])
    week = min((datetime.date.today() - start).days // 7 + 1, 99)
    limit = WARMUP_RAMP.get(week, 40)

    # Safety: if bounce rate > 5%, reduce limit 50%
    if w.get("bounce_rate", 0) > 0.05:
        limit = max(5, limit // 2)
        outreach_log(f"WARN: High bounce rate {w['bounce_rate']:.1%} — limiting to {limit}/day")

    return limit


def check_daily_budget():
    """Returns (can_send, remaining). Resets counter at midnight."""
    w = load_warmup()
    today = datetime.date.today().isoformat()
    if w.get("last_send_date") != today:
        w["sends_today"] = 0
        w["last_send_date"] = today
        save_warmup(w)
    limit = get_daily_limit()
    remaining = limit - w.get("sends_today", 0)
    return remaining > 0, remaining


def increment_send_count():
    w = load_warmup()
    w["sends_today"] = w.get("sends_today", 0) + 1
    w["total_sent"] = w.get("total_sent", 0) + 1
    save_warmup(w)


# ── LLM PERSONALIZATION ───────────────────────────────────────────────────────


def personalize_email(template_body, lead, step_num, audit_findings=None):
    """Fill {{variables}} in email template using lead data + LLM."""
    cs = random.choice(CASE_STUDIES)
    pain = lead.get("pain_points", [])
    pain_short = pain[0] if pain else "performance gaps"

    # Static replacements
    replacements = {
        "{{first_name}}":        (lead.get("name","there").split()[0] or "there"),
        "{{company}}":           lead.get("company", "your company"),
        "{{pain_point_short}}":  pain_short,
        "{{platform_detected}}": lead.get("platform","Meta/Google").capitalize(),
        "{{case_study_company}}": cs["company"],
        "{{case_study_before}}": cs["before"],
        "{{case_study_after}}":  cs["after"],
        "{{budget}}":            lead.get("budget",""),
        "{{sent_date}}":         datetime.date.today().strftime("%B %d"),
        "{{year}}":              str(datetime.date.today().year),
    }

    # Dynamic audit findings
    if audit_findings and len(audit_findings) >= 3:
        replacements["{{finding_1}}"] = audit_findings[0]
        replacements["{{finding_2}}"] = audit_findings[1]
        replacements["{{finding_3}}"] = audit_findings[2]
    else:
        replacements["{{finding_1}}"] = f"Tracking gaps causing estimated 20-35% data loss"
        replacements["{{finding_2}}"] = f"Audience overlap across ad sets inflating CPM 30%+"
        replacements["{{finding_3}}"] = f"No retargeting funnel — leaving warm traffic unconverted"

    body = template_body
    for k, v in replacements.items():
        body = body.replace(k, str(v))

    # LLM fills any remaining {{...}} variables with contextual data
    remaining = re.findall(r'\{\{[^}]+\}\}', body)
    if remaining and (G0DM0DE_KEY or GROQ_API_KEY):
        prompt = f"""Fill these template variables for a cold email to {lead.get('company','a company')} in performance marketing.
Variables to fill: {remaining}
Context: {json.dumps({k:v for k,v in lead.items() if k in ['company','pain_points','budget','job_title']})}
Return ONLY a JSON object mapping variable → value. Max 15 words per value. No quotes around keys."""
        result = call_llm(prompt, max_tokens=200)
        if result:
            try:
                # Clean up and parse
                result = re.sub(r'```[^`]*```', '', result).strip()
                vals = json.loads(result)
                for k, v in vals.items():
                    body = body.replace("{{" + k + "}}", str(v))
            except Exception:
                pass

    # Final cleanup — remove any unfilled variables
    body = re.sub(r'\{\{[^}]+\}\}', '', body)
    return body.strip()


def pick_subject(step_config, lead):
    """Pick a subject line variant and personalize it."""
    variants = step_config.get("subject_variants", ["Following up"])
    subject = random.choice(variants)
    company = lead.get("company", "your business")
    pain = lead.get("pain_points", [""])[0] if lead.get("pain_points") else ""
    subject = subject.replace("{{company}}", company)
    subject = subject.replace("{{first_name}}", lead.get("name","").split()[0] or "")
    subject = subject.replace("{{pain_point_short}}", pain[:40] if pain else "your ads")
    return subject.strip()


def add_unsubscribe_footer(body, lead):
    """CAN-SPAM compliant unsubscribe footer."""
    token = lead.get("unsubscribe_token", "")
    footer = (
        "\n\n---\n"
        "DigiMinds Agency | digiminds.org\n"
        "zulqarnain@digiminds.org\n"
        f"To unsubscribe: reply with 'UNSUBSCRIBE' or email zulqarnain@digiminds.org with subject 'Remove: {lead.get('email','')}'"
    )
    return body + footer


# ── SEQUENCE ENGINE ───────────────────────────────────────────────────────────

def load_sequence(seq_id="cold_v1"):
    seq_file = SEQ_DIR / f"{seq_id.replace('_v1','')}_sequence.json"
    if seq_file.exists():
        return json.loads(seq_file.read_text())
    return None


def get_next_step(lead, sequence):
    """Determine which sequence step to send next based on emails_sent history."""
    sent = lead.get("emails_sent", [])
    steps_sent = [e.get("sequence_step", 0) for e in sent]
    max_step = max(steps_sent) if steps_sent else 0
    total_steps = sequence.get("total_steps", 4)
    if max_step >= total_steps:
        return None  # sequence complete
    return max_step + 1


def get_audit_findings(lead):
    """Extract audit findings from attached audit if available."""
    audit_path = lead.get("audit_path", "")
    if not audit_path:
        return []
    # Try to extract findings from audit JSON sidecar
    sidecar = Path(audit_path).with_suffix(".json")
    if sidecar.exists():
        try:
            data = json.loads(sidecar.read_text())
            return [f.get("title","") for f in data.get("findings",[])[:3]]
        except Exception:
            pass
    return []


def build_email(lead, sequence, step_num):
    """Build complete email for given step."""
    step_config = next((s for s in sequence["steps"] if s["step"] == step_num), None)
    if not step_config:
        return None

    # Load template body
    body_template = step_config.get("body", "")
    audit_findings = get_audit_findings(lead) if step_config.get("include_audit") else []

    # Personalize
    body = personalize_email(body_template, lead, step_num, audit_findings)

    # Add unsubscribe footer
    if step_config.get("include_unsubscribe", True):
        body = add_unsubscribe_footer(body, lead)

    subject = pick_subject(step_config, lead)

    return {
        "to":           lead["email"],
        "from":         f"{FROM_NAME} <{FROM_EMAIL}>",
        "reply_to":     FROM_EMAIL,
        "subject":      subject,
        "body":         body,
        "plain_text":   step_config.get("plain_text", True),
        "sequence_id":  sequence["sequence_id"],
        "sequence_step": step_num,
        "include_audit": step_config.get("include_audit", False),
        "audit_path":   lead.get("audit_path", ""),
        "is_breakup":   step_config.get("is_breakup", False),
        "lead_id":      lead["id"],
        "company":      lead.get("company",""),
    }


def queue_email(email_data):
    """Write to send queue for Gmail MCP delivery."""
    QUEUE_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(QUEUE_FILE, "a") as f:
        f.write(json.dumps(email_data) + "\n")


def send_via_gmail_draft(email_data):
    """
    Queue as Gmail draft via MCP.
    Actual MCP call happens in agency-run's report phase or manual trigger.
    """
    queue_email(email_data)
    outreach_log(f"  QUEUED → {email_data['to']} | Step {email_data['sequence_step']} | {email_data['subject'][:50]}")
    return True


# ── MAIN OUTREACH LOGIC ───────────────────────────────────────────────────────

def run_cold_outreach(max_sends=None):
    """Process COLD leads → send step 1 of cold sequence."""
    can_send, remaining = check_daily_budget()
    if not can_send:
        outreach_log("Daily send limit reached — skipping cold outreach")
        return 0

    limit = min(remaining, max_sends or remaining)
    sequence = load_sequence("cold_v1")
    if not sequence:
        outreach_log("ERROR: cold sequence not found")
        return 0

    leads = get_leads_for_outreach("COLD", limit=limit)
    outreach_log(f"Cold outreach: {len(leads)} leads eligible, {limit} budget remaining")

    sent = 0
    for lead in leads:
        if sent >= limit:
            break

        email = build_email(lead, sequence, step_num=1)
        if not email:
            continue

        success = send_via_gmail_draft(email)
        if success:
            record_email_sent(lead["email"], email["subject"], 1, email["body"][:150])
            advance_stage(lead["email"], "OUTREACH_1")
            # Set next followup: 3 days
            next_f = (datetime.datetime.now() + datetime.timedelta(days=3)).isoformat()
            import json as _j
            from crm import _load_db, _save_db
            db = _load_db()
            lid = lead_id(lead["email"])
            if lid in db["leads"]:
                db["leads"][lid]["next_followup"] = next_f
                _save_db(db)

            increment_send_count()
            sent += 1
            delay = random.randint(MIN_DELAY_SEC, MAX_DELAY_SEC)
            outreach_log(f"  Sent → {lead['email']} | waiting {delay//60}m {delay%60}s")
            time.sleep(delay)

    return sent


def run_followup_outreach():
    """Process OUTREACH_1/2/3 leads due for next step."""
    sequence = load_sequence("cold_v1")
    if not sequence:
        return 0

    can_send, remaining = check_daily_budget()
    if not can_send:
        return 0

    # Stage → next step mapping
    stage_to_step = {"OUTREACH_1": 2, "OUTREACH_2": 3, "OUTREACH_3": 4}
    stage_to_next = {"OUTREACH_1": "OUTREACH_2", "OUTREACH_2": "OUTREACH_3", "OUTREACH_3": "OUTREACH_4"}

    sent = 0
    for stage, step_num in stage_to_step.items():
        leads = get_leads_for_outreach(stage, limit=remaining - sent)
        for lead in leads:
            if sent >= remaining:
                break
            email = build_email(lead, sequence, step_num=step_num)
            if not email:
                continue
            send_via_gmail_draft(email)
            record_email_sent(lead["email"], email["subject"], step_num, email["body"][:150])
            advance_stage(lead["email"], stage_to_next.get(stage, "OUTREACH_4"))
            increment_send_count()
            sent += 1
            time.sleep(random.randint(MIN_DELAY_SEC, MAX_DELAY_SEC))

    return sent


def run_warm_outreach():
    """Process RESPONDED/QUALIFIED leads with warm sequence."""
    warm_seq = load_sequence("warm_v1")
    sql_seq  = load_sequence("qualified_v1")

    sent = 0
    can_send, remaining = check_daily_budget()
    if not can_send:
        return 0

    # Warm: RESPONDED → step 1 of warm sequence
    warm_leads = get_leads_for_outreach("RESPONDED", limit=remaining)
    for lead in warm_leads:
        if sent >= remaining:
            break
        if not warm_seq:
            continue
        email = build_email(lead, warm_seq, step_num=1)
        if not email:
            continue
        send_via_gmail_draft(email)
        record_email_sent(lead["email"], email["subject"], 1, email["body"][:150])
        advance_stage(lead["email"], "PROPOSAL_SENT")
        increment_send_count()
        sent += 1
        time.sleep(random.randint(60, 120))  # shorter delay for warm

    # SQL: QUALIFIED → closing sequence
    sql_leads = get_leads_for_outreach("QUALIFIED", limit=remaining - sent)
    for lead in sql_leads:
        if sent >= remaining:
            break
        if not sql_seq:
            continue
        email = build_email(lead, sql_seq, step_num=1)
        if not email:
            continue
        send_via_gmail_draft(email)
        record_email_sent(lead["email"], email["subject"], 1, email["body"][:150])
        advance_stage(lead["email"], "PROPOSAL_SENT")
        increment_send_count()
        sent += 1
        time.sleep(random.randint(60, 120))

    return sent


