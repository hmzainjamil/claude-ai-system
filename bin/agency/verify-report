    report["phases"]["reporting"] = {
        "dashboard_generated": (REPORT_DIR / "dashboard.html").exists(),
        "text_report_generated": (REPORT_DIR / f"report_{TODAY}.txt").exists(),
        "emails_sent": emails_sent,
        "email_account": "zulqarnain@digiminds.org"
    }

    # ── API Usage Summary ───────────────────────────────────
    usage_file = LIMITS_DIR / "usage.json"
    if usage_file.exists():
        u = json.loads(usage_file.read_text())
        today_str = datetime.date.today().isoformat()
