            "total_discovered": jd.get("total_discovered", sum(jd.get("platform_breakdown",{}).values())),
            "total_qualified": jd.get("total_qualified",0),
            "high_ticket_found": jd.get("high_ticket_count", 0),
            "platform_breakdown": jd.get("platform_breakdown",{}),
            "time_start": start, "time_end": end,
            "duration_min": dm, "duration_sec": ds,
            "llm_used": "OpenRouter DeepSeek-V3 → Groq → keyword fallback",
            "scraper": "Apify RAG Web Browser (standby URL)"
        }
    else:
        report["phases"]["discovery"] = {"status": "not run today"}

    # ── Phase 2: Proposals ──────────────────────────────────
    prop_file = AGENCY_DIR / f"proposals/proposals_{TODAY}.json"
    if prop_file.exists():
        pd = json.loads(prop_file.read_text())
        props = pd.get("proposals",[])
