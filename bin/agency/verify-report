def log(msg):
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line)
    with open(LOG_FILE,"a") as f: f.write(line+"\n")

def read_log_lines(logfile, keywords=None, tail=200):
    p = AGENCY_DIR / f"logs/{logfile}"
    if not p.exists(): return []
    lines = p.read_text().split("\n")
    lines = [l for l in lines if TODAY[:4]+"-"+TODAY[4:6]+"-"+TODAY[6:] in l or TODAY in l]
    if keywords:
        lines = [l for l in lines if any(k in l for k in keywords)]
    return lines[-tail:]

def get_timing(log_lines):
    """Extract start/end timestamps from log lines."""
    times = []
    for l in log_lines:
        try:
            ts_part = l.split("]")[0].strip("[")
            dt = datetime.datetime.strptime(ts_part, "%Y-%m-%d %H:%M:%S")
            times.append(dt)
        except: pass
    if len(times) >= 2:
        dur = (times[-1] - times[0]).total_seconds()
        return times[0].strftime("%H:%M:%S"), times[-1].strftime("%H:%M:%S"), int(dur//60), int(dur%60)
    return "—","—",0,0

