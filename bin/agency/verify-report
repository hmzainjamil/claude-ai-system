        rs_list = [p.get("relevance_score",0) for p in props]
        qs_avg = int(sum(qs_list)/len(qs_list)) if qs_list else 0
        rs_avg = int(sum(rs_list)/len(rs_list)) if rs_list else 0

        # Rejected count
        failed_logs = [l for l in prop_logs if "✗ generation failed" in l or "✗ failed" in l]

        # Per-platform breakdown
        by_plat = {}
        for p in props:
            pl = p.get("platform","?")
            by_plat[pl] = by_plat.get(pl, 0) + 1

        report["phases"]["proposals"] = {
            "total_generated": pd.get("total_proposals", len(props)),
            "total_attempted": len(props) + len(failed_logs),
            "total_failed": len(failed_logs),
            "high_ticket": pd.get("high_ticket_proposals", 0),
            "avg_quality_score": qs_avg,
            "avg_relevance_score": rs_avg,
            "quality_stats": pd.get("quality_stats",{}),
            "platform_breakdown": by_plat,
            "time_start": start, "time_end": end,
            "duration_min": pm,
            "llm_chain": "Groq llama-3.1-8b-instant → GLM-4.5-air → Ollama llama3",
            "quality_review": "Rule-based QR: word count + opener check + CTA + DigiMinds mention + job specificity",
            "word_count_avg": int(sum(p.get("word_count",150) for p in props)/len(props)) if props else 0,
            "sample_proposals": [
                {"title": p["job_title"], "platform": p["platform"],
                 "relevance": p.get("relevance_score",0), "quality": p.get("quality_score","—"),
                 "word_count": p.get("word_count",0), "is_ht": p.get("is_high_ticket",False),
                 "url": p.get("job_url","")[:80]}
                for p in sorted(props, key=lambda x: -(x.get("relevance_score",0)))[:10]
            ]
        }
    else:
        report["phases"]["proposals"] = {"status": "not run today"}

    # ── Phase 3: Submission ─────────────────────────────────
    sub_files = list((AGENCY_DIR / "submissions").glob(f"{TODAY}_*_ready.txt"))
    bq_file   = AGENCY_DIR / f"submissions/{TODAY}_browser_queue.json"
    sub_logs  = read_log_lines("submission.log")
    sub_start, sub_end, sbm, sbs = get_timing(sub_logs)

    reddit_auto = 0
    if prop_file.exists():
        pd2 = json.loads(prop_file.read_text())
        reddit_auto = pd2.get("submissions",{}).get("reddit_auto",0)
        manual_ready = pd2.get("submissions",{}).get("manual_ready",0)
        bq_size = pd2.get("submissions",{}).get("browser_queue_size",0)
    else:
        manual_ready = 0; bq_size = 0

    report["phases"]["submission"] = {
        "reddit_auto_posted": reddit_auto,
        "manual_ready_files": len(sub_files),
        "browser_queue_size": bq_size,
        "submission_files": [f.name for f in sub_files],
        "time_start": sub_start, "time_end": sub_end,
        "account_used": "zulqarnain@digiminds.org",
        "submission_method": "Reddit OAuth API (auto) + per-platform ready files for Brave browser"
    }

    # ── Phase 0.5: Social ───────────────────────────────────
    social_summary = AGENCY_DIR / f"social/summary_{TODAY}.json"
    if social_summary.exists():
        ss = json.loads(social_summary.read_text())
        report["phases"]["social_engagement"] = {
            "reddit_comments": ss.get("reddit_manual",0),
            "reddit_auto_posted": ss.get("reddit_auto_posted",0),
            "linkedin_comments": ss.get("linkedin_comments",0),
            "facebook_comments": ss.get("facebook_comments",0),
            "instagram_posts": ss.get("instagram_posts",0),
            "files_generated": list(ss.get("files",{}).values())
        }
    else:
        report["phases"]["social_engagement"] = {"status": "files in ~/.claude/agency/social/"}

    # ── Phase 4: Report & Email ─────────────────────────────
    sent_log = AGENCY_DIR / "data/email_sent.jsonl"
    emails_sent = []
    if sent_log.exists():
        for line in sent_log.read_text().split("\n"):
            if line.strip() and TODAY in line:
