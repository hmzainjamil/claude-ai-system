#!/usr/bin/env python3
"""
MULTI-PLATFORM LOGIN HELPER
Opens all required platforms in one browser window.
Log in to each tab, then CLOSE the browser when done.

Accounts:
  Upwork     → hmzainjamilpaypal@gmail.com
  LinkedIn   → hmzainjamil@gmail.com
  Reddit     → hmzainjamil@gmail.com
  Freelancer → your Freelancer account
  Guru       → your Guru account
  PeoplePerHour → your PPH account
  Gmail      → zulqarnain@digiminds.org (already logged in)
"""
import time, sys
from pathlib import Path
from playwright.sync_api import sync_playwright

PROFILE = Path.home() / ".claude/agency/browser-profile"

TABS = [
    ("Gmail",         "https://mail.google.com/mail/u/0/#inbox"),
    ("Upwork",        "https://www.upwork.com/ab/account-security/login"),
    ("LinkedIn",      "https://www.linkedin.com/login"),
    ("Reddit",        "https://www.reddit.com/login/"),
    ("Freelancer",    "https://www.freelancer.com/login"),
    ("Guru",          "https://www.guru.com/login.aspx"),
    ("PeoplePerHour", "https://www.peopleperhour.com/login"),
    ("Bark",          "https://www.bark.com/en/gb/login/"),
]

print("=" * 60)
print("MULTI-PLATFORM LOGIN — DigiMinds Agency")
print("=" * 60)
print()
print("Accounts to use:")
print("  Upwork:     hmzainjamilpaypal@gmail.com")
print("  LinkedIn:   hmzainjamil@gmail.com")
print("  Reddit:     hmzainjamil@gmail.com")
print("  Gmail:      zulqarnain@digiminds.org")
print()
print("Sign into ALL tabs, then CLOSE the browser window.")
print("Script auto-saves cookies. Future runs need no re-login.")
print("=" * 60)
print()

with sync_playwright() as p:
    ctx = p.chromium.launch_persistent_context(
        user_data_dir=str(PROFILE),
        headless=False,
        viewport={"width": 1280, "height": 900},
        args=["--disable-blink-features=AutomationControlled", "--profile-directory=Profile 1"],
    )

    pages = []
    for name, url in TABS:
        try:
            pg = ctx.new_page()
            pg.goto(url, timeout=15000, wait_until="domcontentloaded")
            print(f"  ✓ Opened {name}: {url[:60]}")
            pages.append((name, pg))
            time.sleep(1)
        except Exception as e:
            print(f"  ✗ {name} failed: {e}")

    print()
    print("Browser is open. Sign into each tab now.")
    print("When done with ALL logins — close the browser window.")
    print()

    # Wait for all pages to close
    try:
        while ctx.pages:
            time.sleep(2)
    except Exception:
        pass

    ctx.close()

print()
print("✓ All cookies saved to:", PROFILE)
print("✓ Run: browser-bot --check-logins to verify")
