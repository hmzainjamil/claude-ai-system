#!/usr/bin/env bash
# github-sync — Syncs COMPLETE system to GitHub portfolio repo
# Auto-triggered by skill-auto-activate + daily LaunchAgent at 6:30AM

set -e

REPO="/Users/mc/claude-ai-system"
CLAUDE_DIR="/Users/mc/.claude"
N8N_SRC="$HOME/installed-repos/n8nworkflows.xyz/workflows"

echo "[github-sync] Starting sync at $(date '+%Y-%m-%d %H:%M:%S')"

if [ ! -d "$REPO/.git" ]; then
  echo "[github-sync] ERROR: $REPO is not a git repo."
  exit 1
fi

mkdir -p "$REPO"/{skills-active,skills-archive,agents,scheduled-tasks,n8n-workflows,installed-repos,automations/bin,automations/launchagents}

# 1. Active skills (full content)
echo "[github-sync] Syncing active skills..."
rsync -a --delete "$CLAUDE_DIR/skills/" "$REPO/skills-active/" 2>/dev/null || true

# 2. Skills archive — extract SKILL.md from each (deduplicated)
echo "[github-sync] Syncing skills archive..."
find "$CLAUDE_DIR/skills-archive" -maxdepth 2 -name "SKILL.md" 2>/dev/null | while read f; do
  DIR=$(dirname "$f")
  BASENAME=$(basename "$DIR" | sed 's/-[A-F0-9]\{8\}$//')
  DEST="$REPO/skills-archive/$BASENAME"
  mkdir -p "$DEST"
  cp "$f" "$DEST/SKILL.md" 2>/dev/null || true
done

# 3. Agents (md files only)
echo "[github-sync] Syncing agents..."
rsync -a --delete --include="*.md" --include="*.yaml" --exclude="*" \
  "$CLAUDE_DIR/agents/" "$REPO/agents/" 2>/dev/null || true

# 4. Scheduled tasks (full)
echo "[github-sync] Syncing scheduled tasks..."
rsync -a --delete "$CLAUDE_DIR/scheduled-tasks/" "$REPO/scheduled-tasks/" 2>/dev/null || true

# 5. Automation scripts
echo "[github-sync] Syncing automation scripts..."
rsync -a --delete "$CLAUDE_DIR/bin/" "$REPO/automations/bin/" 2>/dev/null || true

# 6. LaunchAgents
echo "[github-sync] Syncing LaunchAgents..."
ls ~/Library/LaunchAgents/ai.hmz.*.plist 2>/dev/null | while read f; do
  DEST="$REPO/automations/launchagents/$(basename $f)"
  cp "$f" "$DEST" 2>/dev/null || true
  # Scrub tokens from LaunchAgent plists before committing
  sed -i '' 's/ghp_[A-Za-z0-9]\{20,\}/[REDACTED_GITHUB_TOKEN]/g' "$DEST" 2>/dev/null || true
  sed -i '' 's/pat[A-Za-z0-9._]\{20,\}/[REDACTED_PAT]/g' "$DEST" 2>/dev/null || true
  sed -i '' 's/sk-[A-Za-z0-9]\{20,\}/[REDACTED_SK]/g' "$DEST" 2>/dev/null || true
done

# 7. Installed repos — README/SKILL.md only (max 50 repos, 2s per repo timeout)
echo "[github-sync] Syncing installed repo docs..."
COUNT=0
ls ~/installed-repos/ 2>/dev/null | head -50 | while read REPONAME; do
  SRC="$HOME/installed-repos/$REPONAME"
  [ -d "$SRC" ] || continue
  DEST="$REPO/installed-repos/$REPONAME"
  mkdir -p "$DEST"
  find "$SRC" -maxdepth 2 \( -name "README.md" -o -name "SKILL.md" -o -name "AGENTS.md" \) \
    -exec cp {} "$DEST/" \; 2>/dev/null || true
  [ -z "$(ls -A $DEST 2>/dev/null)" ] && echo "# $REPONAME" > "$DEST/README.md"
done

# 8. n8n workflow manifest (index only — 8159 workflows)
echo "[github-sync] Rebuilding n8n workflow manifest..."
python3 << 'PYEOF'
import os

src = os.path.expanduser("~/installed-repos/n8nworkflows.xyz/workflows")
out = "/Users/mc/claude-ai-system/n8n-workflows"
os.makedirs(out, exist_ok=True)

if not os.path.isdir(src):
    exit(0)

dirs = [d for d in os.listdir(src) if os.path.isdir(os.path.join(src,d))]

cats = {
    "Gmail/Email": [], "Slack": [], "LinkedIn": [], "Telegram": [],
    "AI/GPT/LLM": [], "Google Sheets": [], "Airtable": [], "CRM/Sales": [],
    "Ecommerce": [], "SEO/Content": [], "Social Media": [],
    "Data/Reporting": [], "Security/Compliance": [], "Other": []
}

for d in sorted(dirs):
    name = d.rsplit('-',1)[0]
    dl = name.lower()
    if any(k in dl for k in ['gmail','email','mailchimp','sendgrid']): cats["Gmail/Email"].append(name)
    elif 'slack' in dl: cats["Slack"].append(name)
    elif 'linkedin' in dl: cats["LinkedIn"].append(name)
    elif 'telegram' in dl: cats["Telegram"].append(name)
    elif any(k in dl for k in ['gpt','openai','claude','gemini',' ai ','llm']): cats["AI/GPT/LLM"].append(name)
    elif 'sheet' in dl: cats["Google Sheets"].append(name)
    elif 'airtable' in dl: cats["Airtable"].append(name)
    elif any(k in dl for k in ['crm','hubspot','salesforce','apollo','sales']): cats["CRM/Sales"].append(name)
    elif any(k in dl for k in ['shopify','woocommerce','ecommerce','stripe']): cats["Ecommerce"].append(name)
    elif any(k in dl for k in ['seo','content','blog','wordpress']): cats["SEO/Content"].append(name)
    elif any(k in dl for k in ['instagram','twitter','facebook','social','tiktok']): cats["Social Media"].append(name)
    elif any(k in dl for k in ['report','dashboard','analytics','data']): cats["Data/Reporting"].append(name)
    elif any(k in dl for k in ['security','compliance','audit','soc']): cats["Security/Compliance"].append(name)
    else: cats["Other"].append(name)

with open(f"{out}/WORKFLOW-MANIFEST.md", "w") as f:
    f.write(f"# n8n Automation Workflow Library — {len(dirs):,} Workflows\n\n")
    f.write("Part of [claude-ai-system](https://github.com/hmzainjamil/claude-ai-system)\n\n")
    for cat, items in cats.items():
        if items:
            f.write(f"### {cat} ({len(items):,} workflows)\n\n")
            for item in items[:50]:
                f.write(f"- {item}\n")
            if len(items) > 50:
                f.write(f"- *...and {len(items)-50} more*\n")
            f.write("\n")
PYEOF

# 9. Strip credentials
echo "[github-sync] Stripping credentials..."
find "$REPO" -type f \( -name "*.md" -o -name "*.sh" -o -name "*.py" -o -name "*.yaml" \) | \
  xargs sed -i '' \
    -e 's/\(API_KEY\s*=\s*["'"'"']\?\)[A-Za-z0-9_\-]\{20,\}/\1[REDACTED]/g' \
    -e 's/\(SECRET\s*=\s*["'"'"']\?\)[A-Za-z0-9_\-]\{20,\}/\1[REDACTED]/g' \
    -e 's/\(TOKEN\s*=\s*["'"'"']\?\)[A-Za-z0-9_\-]\{20,\}/\1[REDACTED]/g' \
    -e 's/sk-[A-Za-z0-9]\{20,\}/[REDACTED]/g' \
    -e 's/ghp_[A-Za-z0-9]\{20,\}/[REDACTED]/g' \
    -e 's/github_pat_[A-Za-z0-9_]\{20,\}/[REDACTED]/g' \
    2>/dev/null || true

# 10. Git commit and push
cd "$REPO"

if [ -n "$GITHUB_TOKEN" ]; then
  UNAME="${GITHUB_USERNAME:-hmzainjamil}"
  git remote set-url origin "https://${GITHUB_TOKEN}@github.com/${UNAME}/claude-ai-system.git" 2>/dev/null || true
fi

git add -A

if git diff --staged --quiet; then
  echo "[github-sync] No changes to commit."
else
  ACTIVE=$(ls "$REPO/skills-active/" | wc -l | tr -d ' ')
  ARCHIVED=$(ls "$REPO/skills-archive/" | wc -l | tr -d ' ')
  AGENTS=$(ls "$REPO/agents/" | wc -l | tr -d ' ')
  DATE=$(date '+%Y-%m-%d %H:%M')
  git commit -m "sync: $DATE — ${ACTIVE} skills, ${ARCHIVED} archived, ${AGENTS} agents"
  git push origin main
  echo "[github-sync] Pushed to GitHub."
fi

echo "[github-sync] Done at $(date '+%Y-%m-%d %H:%M:%S')"

# ── README QUALITY AUDIT + AUTO-FIX (threshold: 15,000 chars) ────────────────
echo "[github-sync] Auditing README quality across all repos (threshold: 15000 chars)..."
python3 /tmp/github_readme_audit.py 2>/dev/null || python3 << 'README_AUDIT_EOF'
import urllib.request, json, base64, sys, os

TOKEN = os.environ.get("GITHUB_TOKEN", "")
UNAME = os.environ.get("GITHUB_USERNAME", "hmzainjamil")

if not TOKEN:
    print("[readme-audit] No GITHUB_TOKEN — skipping audit")
    sys.exit(0)

headers = {"Authorization": f"token {TOKEN}"}
THRESHOLD = 15000

try:
    req = urllib.request.Request(f"https://api.github.com/users/{UNAME}/repos?per_page=100", headers=headers)
    repos = json.loads(urllib.request.urlopen(req).read())
    if isinstance(repos, dict):
        print(f"[readme-audit] API error: {repos.get('message','?')}")
        sys.exit(0)
except Exception as e:
    print(f"[readme-audit] Failed to list repos: {e}")
    sys.exit(0)

thin = []
for r in repos:
    name = r.get('name','')
    try:
        req2 = urllib.request.Request(
            f"https://api.github.com/repos/{UNAME}/{name}/contents/README.md",
            headers=headers)
        d = json.loads(urllib.request.urlopen(req2).read())
        content = base64.b64decode(d.get('content','')).decode(errors='ignore')
        if len(content) < THRESHOLD:
            thin.append((name, len(content), d.get('sha','')))
    except:
        pass

if thin:
    print(f"[readme-audit] WARNING: {len(thin)} thin README(s) found (under {THRESHOLD} chars):")
    for name, n, sha in thin:
        print(f"  - {name}: {n} chars — needs expansion")
else:
    print(f"[readme-audit] All READMEs OK (all above {THRESHOLD} chars)")
README_AUDIT_EOF

# ── NEW REPO AUTO-DISCOVERY + PUSH ───────────────────────────────────────────
echo "[github-sync] Scanning for new locally-installed repos not yet on GitHub..."
python3 << 'NEW_REPO_EOF'
import urllib.request, json, base64, sys, os, re

TOKEN = os.environ.get("GITHUB_TOKEN", "")
UNAME = os.environ.get("GITHUB_USERNAME", "hmzainjamil")

if not TOKEN:
    print("[new-repo-push] No GITHUB_TOKEN — skipping")
    sys.exit(0)

headers_get  = {"Authorization": f"token {TOKEN}"}
headers_post = {"Authorization": f"token {TOKEN}", "Content-Type": "application/json"}

# --- Fetch all existing GitHub repos ---
existing = set()
page = 1
while True:
    try:
        url = f"https://api.github.com/user/repos?per_page=100&page={page}&type=owner"
        req = urllib.request.Request(url, headers=headers_get)
        repos = json.loads(urllib.request.urlopen(req).read())
        if not repos:
            break
        for r in repos:
            existing.add(r['name'].lower())
        if len(repos) < 100:
            break
        page += 1
    except Exception as e:
        print(f"[new-repo-push] Failed to list GitHub repos: {e}")
        sys.exit(0)

print(f"[new-repo-push] Found {len(existing)} existing GitHub repos")

# --- Scan ~/installed-repos for local repos ---
installed_base = os.path.expanduser("~/installed-repos")
if not os.path.isdir(installed_base):
    print("[new-repo-push] ~/installed-repos not found — skipping")
    sys.exit(0)

local_dirs = [d for d in os.listdir(installed_base)
              if os.path.isdir(os.path.join(installed_base, d)) and not d.startswith('.')]

# Build candidate list: local repos NOT on GitHub (name-matched)
# Also create hmz-prefixed variants if the local name doesn't start with hmz-
new_repos = []
for d in sorted(local_dirs):
    slug = d.lower().replace('_', '-').replace(' ', '-')
    slug = re.sub(r'[^a-z0-9\-]', '', slug)[:100]
    # Check if this slug OR hmz-{slug} already exists on GitHub
    if slug in existing or f"hmz-{slug}" in existing:
        continue
    # Skip very long or cryptic names
    if len(slug) < 3:
        continue
    new_repos.append((d, slug))

if not new_repos:
    print("[new-repo-push] No new local repos to push — all already on GitHub")
    sys.exit(0)

print(f"[new-repo-push] Found {len(new_repos)} new local repos to create on GitHub:")
for d, slug in new_repos:
    print(f"  + {slug}  (from ~/installed-repos/{d})")

# --- Helper: generate professional README ---
def make_readme(repo_slug, local_dir):
    display = repo_slug.replace('-', ' ').title()
    local_path = os.path.join(installed_base, local_dir)
    # Detect tech stack from files present
    files = []
    try:
        files = os.listdir(local_path)
    except:
        pass
    tech = []
    if any(f.endswith('.py') for f in files): tech.append('Python')
    if any(f in files for f in ['package.json']): tech.append('Node.js')
    if any(f.endswith('.ts') for f in files): tech.append('TypeScript')
    if any(f.endswith('.sh') for f in files): tech.append('Bash/Shell')
    if any(f.endswith('.yaml') or f.endswith('.yml') for f in files): tech.append('YAML')
    if 'Dockerfile' in files: tech.append('Docker')
    if not tech: tech = ['Multi-language']
    tech_str = ' | '.join(tech)

    # Try to read existing README if present
    existing_readme = ''
    for rname in ['README.md', 'readme.md', 'README.txt']:
        rpath = os.path.join(local_path, rname)
        if os.path.exists(rpath):
            try:
                existing_readme = open(rpath, errors='ignore').read()[:3000]
            except:
                pass
            break

    tech0 = tech[0].replace(' ', '%20')
    readme = f"""<p align="center">
  <img src="https://img.shields.io/badge/HMZ-{display.replace(' ', '%20')}-6C3EE8?style=for-the-badge&logoColor=white" alt="{display}" height="60">
</p>

