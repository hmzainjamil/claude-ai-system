    return readme

# --- Create GitHub repo + push README for each new local repo ---
def create_github_repo(slug, description):
    payload = json.dumps({
        "name": slug,
        "description": description,
        "private": False,
        "auto_init": False
    }).encode()
    req = urllib.request.Request(
        "https://api.github.com/user/repos",
        data=payload,
        headers=headers_post,
        method="POST"
    )
    try:
        resp = json.loads(urllib.request.urlopen(req).read())
        return resp.get('full_name', '')
    except urllib.request.HTTPError as e:
        body = e.read().decode()
        if 'already exists' in body or e.code == 422:
            return f"{UNAME}/{slug}"  # already exists
        print(f"  [!] Failed to create {slug}: {e.code} {body[:100]}")
        return ''

def push_readme_to_repo(repo_slug, content):
    import time
    time.sleep(1)  # avoid secondary rate limit
    url = f"https://api.github.com/repos/{UNAME}/{repo_slug}/contents/README.md"
    # Try to get existing SHA
    sha = ''
    try:
        req = urllib.request.Request(url, headers=headers_get)
        d = json.loads(urllib.request.urlopen(req).read())
        sha = d.get('sha', '')
    except:
        pass

    payload_dict = {
        "message": "feat: professional README — HMZ AI system",
        "content": base64.b64encode(content.encode()).decode()
    }
    if sha:
        payload_dict["sha"] = sha

    payload = json.dumps(payload_dict).encode()
    req = urllib.request.Request(url, data=payload, headers=headers_post, method="PUT")
    try:
        urllib.request.urlopen(req)
        return True
    except Exception as e:
        print(f"  [!] Failed to push README to {repo_slug}: {e}")
        return False

created = 0
for local_dir, slug in new_repos[:20]:  # cap at 20 new repos per run to avoid rate limits
    display = slug.replace('-', ' ').title()
    desc = f"HMZ AI automation module — {display} | Part of claude-ai-system"

    print(f"  Creating {slug}...")
    full_name = create_github_repo(slug, desc)
    if not full_name:
        continue

    readme_content = make_readme(slug, local_dir)
    ok = push_readme_to_repo(slug, readme_content)
    if ok:
        print(f"  [{'+' if ok else '!'}] {slug} -> https://github.com/{UNAME}/{slug}")
        created += 1

print(f"[new-repo-push] Done. Created and pushed {created} new repos.")
if len(new_repos) > 20:
    print(f"[new-repo-push] NOTE: {len(new_repos)-20} more repos pending — will process on next daily run.")
NEW_REPO_EOF

# ── SYNC SUB-REPOS ────────────────────────────────────────────────────────────
TOKEN="${GITHUB_TOKEN}"
UNAME="${GITHUB_USERNAME:-hmzainjamil}"
DATE=$(date '+%Y-%m-%d %H:%M')

# hmz-skills-archive — re-deduplicate and push
echo "[github-sync] Syncing hmz-skills-archive..."
python3 << 'PYEOF'
import os, re, shutil

src = os.path.expanduser("~/.claude/skills-archive")
out = "/tmp/hmz-skills-archive-sync/skills"
shutil.rmtree("/tmp/hmz-skills-archive-sync", ignore_errors=True)
os.makedirs(out, exist_ok=True)

if not os.path.isdir(src): exit(0)

groups = {}
for d in os.listdir(src):
    base = re.sub(r'-[A-F0-9]{8}$', '', d)
    skill_file = os.path.join(src, d, "SKILL.md")
    if os.path.exists(skill_file):
        content = open(skill_file, errors='ignore').read()
        if base not in groups or len(content) > len(groups[base]):
            groups[base] = content

hmz_note = "\n\n---\n*Curated by [Hafiz Muhammad Zulqarnain](https://github.com/hmzainjamil) — HMZ AI System*\n"
for base, content in groups.items():
    os.makedirs(f"{out}/{base}", exist_ok=True)
    # Scrub tokens
    content = re.sub(r'AIRTABLE_API_KEY=[A-Za-z0-9._]+', 'AIRTABLE_API_KEY=[YOUR_TOKEN]', content)
    content = re.sub(r'ghp_[A-Za-z0-9]{10,}', '[YOUR_GITHUB_TOKEN]', content)
    content = re.sub(r'sk-[A-Za-z0-9]{20,}', '[YOUR_OPENAI_KEY]', content)
    with open(f"{out}/{base}/SKILL.md", 'w') as f:
        f.write(content + hmz_note)

print(f"Skills: {len(groups)}")
