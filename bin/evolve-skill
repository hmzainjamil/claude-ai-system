#!/usr/bin/env bash
# evolve-skill — auto-improve any SKILL.md via DSPy+GEPA
# Usage: evolve-skill [skill-name] [--iterations N]
# Example: evolve-skill ads-strategy --iterations 10

SKILL="${1:-}"
ITERS="${3:-10}"
EVAL="${5:-synthetic}"

if [ -z "$SKILL" ]; then
  echo "Usage: evolve-skill <skill-name> [--iterations N] [--eval synthetic|sessiondb]"
  echo "Available skills:"
  ls ~/.claude/skills/
  exit 1
fi

cd ~/installed-repos/hermes-agent-self-evolution
export HERMES_AGENT_REPO=~/installed-repos/hermes-agent
export OPENAI_API_KEY="${OPENROUTER_API_KEY}"
export OPENAI_BASE_URL="https://openrouter.ai/api/v1"

echo "Evolving skill: $SKILL (iterations=$ITERS, eval=$EVAL)"
python3 -m evolution.skills.evolve_skill \
  --skill "$SKILL" \
  --iterations "$ITERS" \
  --eval-source "$EVAL"
