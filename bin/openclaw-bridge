#!/usr/bin/env bash
# openclaw-bridge — Claude Code ↔ OpenClaw ↔ Agent37 bridge
# Usage: openclaw-bridge <action> [args]
#   actions: start-gateway, stop-gateway, status, send, task, config-agent37

set -e
source ~/.claude/tier0.env 2>/dev/null
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

ACTION="${1:-status}"
GATEWAY_LOG="/tmp/openclaw-gateway.log"
GATEWAY_PID_FILE="/tmp/openclaw-gateway.pid"
GATEWAY_PORT=18789
GATEWAY_URL="ws://127.0.0.1:$GATEWAY_PORT"

case "$ACTION" in

  start-gateway)
    # LaunchAgent manages the gateway — just verify it's up
    if launchctl list 2>/dev/null | grep -q "openclaw.gateway"; then
      echo "[openclaw-bridge] ✓ Gateway managed by LaunchAgent (ai.openclaw.gateway)"
    else
      echo "[openclaw-bridge] Starting gateway manually..."
      nohup openclaw gateway run --bind loopback --port "$GATEWAY_PORT" --force > "$GATEWAY_LOG" 2>&1 &
      echo $! > "$GATEWAY_PID_FILE"
    fi
    ;;

  stop-gateway)
    pkill -9 -f "openclaw gateway" 2>/dev/null && echo "Gateway stopped" || echo "Gateway not running"
    rm -f "$GATEWAY_PID_FILE"
    ;;

  status)
    echo "=== OpenClaw Status ==="
    # Gateway — check via LaunchAgent OR direct process OR HTTP
    if launchctl list 2>/dev/null | grep -q "openclaw.gateway" \
       || pgrep -f "openclaw" > /dev/null 2>&1 \
       || curl -s --max-time 2 "http://127.0.0.1:$GATEWAY_PORT/" >/dev/null 2>&1; then
      echo "✓ Gateway: RUNNING (:$GATEWAY_PORT) — http://127.0.0.1:$GATEWAY_PORT"
    else
      echo "✗ Gateway: STOPPED"
    fi
    # Agent37 config
    AGENT37_URL=$(openclaw config get gateway.remote.url 2>/dev/null || echo "not set")
    AGENT37_TOKEN=$(openclaw config get gateway.remote.token 2>/dev/null || echo "not set")
    echo "Agent37 URL: $AGENT37_URL"
    echo "Agent37 Token: ${AGENT37_TOKEN:0:10}... (redacted)"
    # Active sessions
    openclaw sessions list 2>/dev/null | head -5 || echo "No sessions"
    ;;

  send)
    # Send message to openclaw agent
    # Usage: openclaw-bridge send "message" [--target channel_or_session]
    MSG="$2"
    TARGET="${3:---session agent:main:main}"
    echo "[openclaw-bridge] Sending to agent: $MSG"
    openclaw agent \
      --message "$MSG" \
      --deliver \
      $TARGET \
      2>/dev/null
    ;;

  task)
    # Run computer control task
    # Usage: openclaw-bridge task "take screenshot and describe screen"
    TASK="$2"
    echo "[openclaw-bridge] Computer task: $TASK"
    openclaw agent \
      --message "[COMPUTER_TASK] $TASK — use computer-use tools to execute" \
      --session agent:main:main \
      --deliver \
      2>/dev/null
    ;;

  config-agent37)
    # Configure Agent37 remote gateway
    # Usage: openclaw-bridge config-agent37 <gateway_url> <token>
    REMOTE_URL="$2"
    REMOTE_TOKEN="$3"
    if [ -z "$REMOTE_URL" ] || [ -z "$REMOTE_TOKEN" ]; then
      echo "Usage: openclaw-bridge config-agent37 <wss://gateway-url> <token>"
      exit 1
    fi
    openclaw config set gateway.remote.url "$REMOTE_URL"
    openclaw config set gateway.remote.token "$REMOTE_TOKEN"
    # Also wire into tier0.env
    echo "" >> ~/.claude/tier0.env
    echo "export AGENT37_GATEWAY_URL=\"$REMOTE_URL\"" >> ~/.claude/tier0.env
    echo "export AGENT37_GATEWAY_TOKEN=\"$REMOTE_TOKEN\"" >> ~/.claude/tier0.env
    echo "✓ Agent37 gateway configured: $REMOTE_URL"
    echo "  Restart gateway to connect: openclaw-bridge start-gateway"
    ;;

  acp)
    # ACP stdio bridge — IDE/Claude Code integration
    # Routes to Agent37 remote if configured, else local
    REMOTE_URL=$(openclaw config get gateway.remote.url 2>/dev/null || echo "")
    REMOTE_TOKEN=$(openclaw config get gateway.remote.token 2>/dev/null || echo "")
    if [ -n "$REMOTE_URL" ] && [ "$REMOTE_URL" != "not configured" ]; then
      openclaw acp --url "$REMOTE_URL" --token "$REMOTE_TOKEN" --session agent:main:main
    else
      openclaw acp --url "$GATEWAY_URL" --session agent:main:main
    fi
    ;;

  *)
    echo "Usage: openclaw-bridge <start-gateway|stop-gateway|status|send|task|config-agent37|acp>"
    ;;
esac
