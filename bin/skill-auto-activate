# ── APIFY / SCRAPING ─────────────────────────────────────────────
if match "apify|scrape|scraping|web scrape|extract data|actor|crawl web|data extract|web data|spider|fetch url|rag.web"; then
  on apify-actor-development; on apify-ultimate-scraper; on apify-actorization; on apify-generate-output-schema
fi

# ── CODE AUTOMATION — always-on agent routing ────────────────────
# Detects coding tasks → injects actor+model mandate into tier0-context
CODE_ACTOR=""
if match "fix bug|debug|error|exception|traceback|stack trace|not working|broken|fails|crash|undefined|null pointer|type error|import error|syntax error"; then
  CODE_ACTOR="DEBUGGER[Sonnet-High]→VERIFIER[Sonnet-Low]"
elif match "refactor|optimis|clean up|rewrite|simplify code|improve performance|reduce complexity|tech debt"; then
  CODE_ACTOR="BUILDER[Sonnet-Medium]→VERIFIER; escalate CURATOR[Opus-High] if architectural"
elif match "generate code|write code|create (a |the |an )?(function|class|module|script|api|endpoint|service|component|hook|util)|build (a |the |an )?(function|class|script|api)"; then
  CODE_ACTOR="ARCHITECT[Sonnet-PlanMode]→BUILDER[Sonnet-Medium]→VERIFIER[Sonnet-Low]"
elif match "write test|add test|unit test|integration test|coverage|pytest|jest|spec|test case|test suite"; then
  CODE_ACTOR="BUILDER[Sonnet-Low]→VERIFIER[Sonnet-Low]"
elif match "write doc|add doc|docstring|readme|comment|explain code|document"; then
  CODE_ACTOR="BUILDER[Sonnet-Low]"
elif match "review code|code review|audit code|check code|security review|code quality"; then
  CODE_ACTOR="CURATOR[Opus-High]→VERIFIER[Sonnet-Low]"
elif match "extract|parse file|read code|get function|list imports|find all"; then
  CODE_ACTOR="EXTRACTOR[Haiku-Low]"
fi

if [ -n "$CODE_ACTOR" ]; then
