#!/usr/bin/env bash
# Dispatch Router — UserPromptSubmit hook.
# 1. Reset to core  2. Keyword-match prompt  3. Activate minimum skill set  4. Log metrics

set -e
SKILLS_BIN="$HOME/.claude/bin"
ACTIVE="$HOME/.claude/skills"
ARCHIVE="$HOME/.claude/skills-archive"
METRICS="$HOME/.claude/metrics.log"

# ── Step 1: Reset to core ────────────────────────────────────────
"$SKILLS_BIN/skill-reset" > /dev/null 2>&1

# ── Step 2: Extract prompt ───────────────────────────────────────
PROMPT=$(python3 -c "
import json,sys
try:
    d=json.load(sys.stdin); print(d.get('prompt','').lower())
except: pass
" 2>/dev/null || echo "")
[ -z "$PROMPT" ] && exit 0

TS=$(date +%s)
ACTIVATED=()

# ── PAPERCLIP AI — always-on health check (every prompt) ─────────
if ! curl -s http://127.0.0.1:3100 -o /dev/null -w "%{http_code}" 2>/dev/null | grep -q "200\|301\|302"; then
  launchctl load ~/Library/LaunchAgents/ai.hmz.paperclip.plist 2>/dev/null || true
  echo "[skill-auto-activate] Paperclip AI → starting at http://127.0.0.1:3100"
else
  echo "[skill-auto-activate] Paperclip AI → http://127.0.0.1:3100 ✓ (co-founder OS active)"
fi

# ── Step 3: Dispatch functions ───────────────────────────────────
on() {
  local skill="$1"
  [ -e "$ACTIVE/$skill" ] && return 0
  [ -e "$ARCHIVE/$skill" ] && mv "$ARCHIVE/$skill" "$ACTIVE/$skill" 2>/dev/null && ACTIVATED+=("$skill")
}
match() { echo "$PROMPT" | grep -qiE "$1"; }

# ══════════════════════════════════════════════════════════════════
# PERMANENT ALWAYS-ON BLOCK — fires every single prompt, no conditions
# Tier 0 routing + Caveman + Token reduction + LLM alternatives
# ══════════════════════════════════════════════════════════════════

# ── TIER 0 MODEL ROUTING — always injected ───────────────────────
TIER0="[TIER-0 ROUTING — ALWAYS ON]
Sub-agents/parallel/internal tasks → TIER 0 ONLY. Never use Claude for internal processing.
ORDER: Ollama(local) → DeepSeek-V3 → Gemini Flash → Groq → Mistral → OpenRouter → GPT-4o-mini → Kimi/Moonshot(262K) → AirLLM-70B(~/installed-repos/airllm/)
TIER 1 (last resort): Claude Haiku — only if ALL Tier 0 unavailable
TIER 2 (final output only): Claude Sonnet/Opus — only if user explicitly requests
AirLLM trigger: 'airllm'/'run 70b local'/'offline 70b' → from airllm import AutoModel
Kimi: 262K ctx, Opus replacement. OpenRouter: unified endpoint for all models.
RULE: Every token saved on sub-tasks = more quota for user-facing responses."
echo "$TIER0" >> "$HOME/.claude/tier0-context.txt" 2>/dev/null || true

# ── CAVEMAN MODE — always on ─────────────────────────────────────
on caveman
CAVEMAN="[CAVEMAN — ALWAYS ON] No filler. No hedging. Fragments OK. Max 120 words unless code/data. Drop: Sure/Certainly/Additionally/Furthermore/Basically/Simply/Actually. Pattern: [thing][action][reason]."
echo "$CAVEMAN" >> "$HOME/.claude/tier0-context.txt" 2>/dev/null || true

# ── TOKEN REDUCTION — always on ──────────────────────────────────
on token-turbo; on compress; on compact-guard; on context-compression; on context-window-management; on summarize
TOKEN="[TOKEN REDUCTION — ALWAYS ON]
Skills active: token-turbo, compress, compact-guard, context-compression, context-window-management, summarize
Repos: ~/installed-repos/Awesome-Collection-Token-Reduction-main/ | ~/installed-repos/claude-token-efficient/
Rules: compress all sub-agent outputs before returning. Bullet>paragraph. Table>list. Abbreviate repeating patterns. Never re-state the question. Never summarize what you're about to do — just do it."
echo "$TOKEN" >> "$HOME/.claude/tier0-context.txt" 2>/dev/null || true

# ── LLM ALTERNATIVES CONTEXT — always available ──────────────────
LLMS="[LLM ALTERNATIVES — ALWAYS AVAILABLE]
Local:       Ollama → ollama run <model> | AirLLM 70B → ~/installed-repos/airllm/
Fast/free:   Groq → groq API (llama3/mixtral) | Gemini Flash → GEMINI_API_KEY | DeepSeek-V3 → api.deepseek.com
Routing:     OpenRouter → ~/installed-repos/openrouter_api/ (unified endpoint)
Long-ctx:    Kimi/Moonshot 262K → ~/installed-repos/anyclaude/ | Ling 1T → novita API (NOVITA_API_KEY)
MoE large:  Ling-plus-290B, Ling-1T → ~/installed-repos/Ling/
Council:     Multi-model consensus → ~/installed-repos/llm_council_skill/
Reasoning:  DeepSeek-R1 → ~/installed-repos/DeepSeek-R1/ | JDeepSeek (Java) → ~/installed-repos/JDeepSeek/
Subconscious: ~/installed-repos/subconscious-systems-ollama-subc/ (Ollama sub-agent loop)
USE: Pick cheapest/fastest model that can handle the task. Never default to Claude when Tier 0 works."
echo "$LLMS" >> "$HOME/.claude/tier0-context.txt" 2>/dev/null || true

# ── L99 + OODA + CODE MANDATE — always on ────────────────────────
echo "[L99] Max performance. Full capability. No hedging. Best output always." >> "$HOME/.claude/tier0-context.txt" 2>/dev/null || true
echo "[OODA] Observe→Orient→Decide→Act every task. No flip-flopping. No stalling." >> "$HOME/.claude/tier0-context.txt" 2>/dev/null || true

# ── ADS / ADVERTISING ────────────────────────────────────────────
if match "ads?|advert|campaign|facebook ads?|meta ads?|google ads?|ppc|roas|ctr|cpc|ad set|ad creative|ad copy|paid social|paid media|media buy"; then
  on ads-strategy; on ads-copy; on ads-creative; on ads-keywords; on ads-competitors; on ads-audience; on ads-funnel; on ads-landing
  match "audit|review|analysis|perform|report" && { on ads-audit; on ads-report-pdf; }
  match "video|reel|tiktok|youtube"            && on ads-video
  match "test|a/b|split test|experiment"       && on ads-testing
  match "quick|fast|brief"                     && on ads-quick
